---
import Page from '../layouts/Page.astro';
---

<Page title="Work" description="Ron Dimon's professional work — EPM, Spark Labs, MRWD LLC, Creative Santa Fe, and more.">

  <section class="container py-20 md:py-28">
    <div class="max-w-3xl animate-in">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Work</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        What I build and advise on
      </h1>
      <p class="mt-6 text-xl text-text-secondary">
        Three decades of building systems, teaching strategy, and helping organizations perform better.
      </p>
    </div>

    <!-- ===== MRWD LLC ===== -->
    <div id="mrwd" class="mt-20 scroll-mt-24">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-lg bg-warm-light flex items-center justify-center">
          <svg class="w-5 h-5 text-warm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-heading font-semibold text-text-primary">
          MRWD LLC
        </h2>
      </div>

      <p class="text-text-secondary leading-relaxed max-w-2xl mb-10">
        MRWD LLC is my operating company — the umbrella for the ventures, advisory work, and education programs I run today.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Spark Labs -->
        <a href="https://sparklabs.studio" target="_blank" rel="noopener noreferrer" class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Education</span>
          <h3 class="text-lg font-heading font-semibold text-text-primary group-hover:text-accent transition-colors">Spark Labs</h3>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Modular, workshop-based business education. 45+ hands-on modules across 5 series and 12+ tracks — strategy, execution, sales, thinking, and technology. Built for people who learn by doing.
          </p>
          <span class="inline-flex items-center mt-4 text-sm font-medium text-accent">
            sparklabs.studio
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </span>
        </a>

        <!-- UNM CRE -->
        <a href="https://business.unm.edu/center-for-responsible-entrepreneurship/index.html" target="_blank" rel="noopener noreferrer" class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all">
          <span class="inline-block text-xs font-medium text-warm uppercase tracking-wider mb-2">Academic</span>
          <h3 class="text-lg font-heading font-semibold text-text-primary group-hover:text-accent transition-colors">UNM Center for Responsible Entrepreneurship</h3>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Working with the University of New Mexico to develop curriculum and programming that bridges academic entrepreneurship with real-world practice.
          </p>
          <span class="inline-flex items-center mt-4 text-sm font-medium text-accent">
            business.unm.edu
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </span>
        </a>

        <!-- Beyond Profit -->
        <a href="https://creativesantafe.org/initiative/beyond-profit-series/" target="_blank" rel="noopener noreferrer" class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Community</span>
          <h3 class="text-lg font-heading font-semibold text-text-primary group-hover:text-accent transition-colors">Beyond Profit Series</h3>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            A learning series with Creative Santa Fe and UNM Anderson exploring business as a force for positive change — responsible enterprise, sustainability, and New Mexico's emerging economy.
          </p>
          <span class="inline-flex items-center mt-4 text-sm font-medium text-accent">
            creativesantafe.org
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </span>
        </a>

        <!-- Santa Fe Facilitator -->
        <a href="https://www.santafefacilitator.com" target="_blank" rel="noopener noreferrer" class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all">
          <span class="inline-block text-xs font-medium text-warm uppercase tracking-wider mb-2">Facilitation</span>
          <h3 class="text-lg font-heading font-semibold text-text-primary group-hover:text-accent transition-colors">Santa Fe Facilitator</h3>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Strategic facilitation for organizations in the Santa Fe area — offsites, planning sessions, team alignment workshops, and scenario planning exercises.
          </p>
          <span class="inline-flex items-center mt-4 text-sm font-medium text-accent">
            santafefacilitator.com
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- ===== Creative Santa Fe ===== -->
    <div id="creative-santa-fe" class="mt-24 scroll-mt-24 pt-12 border-t border-border-light">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-lg bg-accent-light flex items-center justify-center">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-heading font-semibold text-text-primary">
          Creative Santa Fe
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <div>
          <p class="text-text-secondary leading-relaxed">
            Santa Fe is one of the most creative cities in the country — a place where art, culture, and entrepreneurship intersect in unique ways. I serve on the board of Creative Santa Fe, where I help support the creative economy through strategic planning, program development, and community building.
          </p>

          <div class="mt-8 space-y-4">
            <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider">My involvement</h3>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-sm font-medium text-text-primary">Business Planning</p>
                  <p class="text-xs text-text-muted">Helping creative organizations develop sustainable business models</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-sm font-medium text-text-primary">Program & Knowledge</p>
                  <p class="text-xs text-text-muted">Developing workshops and educational programming for creative professionals</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-sm font-medium text-text-primary">Board Member</p>
                  <p class="text-xs text-text-muted">Strategic governance and organizational direction</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-4">Videos</h3>
          <div class="space-y-4">
            <div class="rounded-lg overflow-hidden border border-border aspect-video">
              <iframe
                src="https://www.youtube.com/embed/EEajYKD4-Ws"
                title="Creative Santa Fe"
                class="w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== EPM ===== -->
    <div id="epm" class="mt-24 scroll-mt-24 pt-12 border-t border-border-light">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-lg bg-accent-light flex items-center justify-center">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-heading font-semibold text-text-primary">
          Enterprise Performance Management
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <div>
          <p class="text-text-secondary leading-relaxed">
            EPM is the discipline of turning strategy into results through better planning, analytics, and accountability. I've spent most of my career in this space — first as a builder at Hyperion Solutions (which became Oracle Hyperion), then as a practitioner and advisor helping organizations implement EPM as a complete management operating system.
          </p>
          <p class="mt-4 text-text-secondary leading-relaxed">
            My books — <a href="/books#epm-done-right" class="text-accent hover:text-accent-hover underline decoration-accent/30"><em>Enterprise Performance Management Done Right</em></a> and <a href="/books#connected-planning" class="text-accent hover:text-accent-hover underline decoration-accent/30"><em>Connected Planning</em></a> — lay out the full framework: from gathering data and building understanding, through strategic and tactical planning, to debate, commitment, and measurement.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/books" class="inline-flex items-center px-4 py-2 bg-surface-alt text-sm text-text-secondary rounded-lg border border-border hover:border-accent hover:text-accent transition-colors">
              The books
            </a>
            <a href="/speaking" class="inline-flex items-center px-4 py-2 bg-surface-alt text-sm text-text-secondary rounded-lg border border-border hover:border-accent hover:text-accent transition-colors">
              Speaking on EPM
            </a>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider">The EPM journey</h3>
          <div class="space-y-3">
            <div class="bg-surface rounded-lg border border-border p-4">
              <p class="text-sm font-medium text-text-primary">Hyperion Solutions → Oracle</p>
              <p class="text-xs text-text-muted mt-1">9 years building the platforms that defined the EPM industry</p>
            </div>
            <div class="bg-surface rounded-lg border border-border p-4">
              <p class="text-sm font-medium text-text-primary">Anaplan — Founders Team</p>
              <p class="text-xs text-text-muted mt-1">Helped shape the early days of the platform and go-to-market strategy</p>
            </div>
            <div class="bg-surface rounded-lg border border-border p-4">
              <p class="text-sm font-medium text-text-primary">Deloitte Consulting</p>
              <p class="text-xs text-text-muted mt-1">Managing Director, Digital Finance Technology practice</p>
            </div>
            <div class="bg-surface rounded-lg border border-border p-4">
              <p class="text-sm font-medium text-text-primary">EPM Done Right (Wiley)</p>
              <p class="text-xs text-text-muted mt-1">Published the practitioner's guide to the full EPM lifecycle</p>
            </div>
            <div class="bg-surface rounded-lg border border-border p-4">
              <p class="text-sm font-medium text-text-primary">Conference speaker & educator</p>
              <p class="text-xs text-text-muted mt-1">ODTUG, OAUG, Ohio State, and corporate events worldwide</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Clients -->
    <div class="mt-24 pt-12 border-t border-border-light">
      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-10 text-center">Organizations I've worked with</h2>
      <div class="relative overflow-hidden" id="client-scroll">
        <div class="flex animate-scroll gap-12 items-center">
          {[
            'Oracle', 'Microsoft', 'Google', 'Salesforce', 'Anaplan', 'Deloitte',
            'Spaulding Ridge', 'Stratuum', 'Infosys', 'PwC', 'Cisco', 'Akamai',
            'Citrix', 'SAS', 'Cargill', 'ADM', 'Herman Miller', 'Dyson',
            'Coca-Cola', 'Goodyear', 'Kraft', 'GE Healthcare', 'AbbVie',
            'Hyatt', 'Ryder', 'Bank of America', 'NY Life', 'Manulife', 'AIG',
            'Citizens Financial', 'GE', 'NRG Energy', 'US Navy', 'US DoD',
            'US State Department', 'UVA', 'UVM', 'UNM', 'McMaster',
            'Creative Santa Fe', 'BBBS',
          ].map(client => (
            <span class="whitespace-nowrap text-sm font-medium text-text-muted/60 hover:text-text-secondary transition-colors shrink-0">
              {client}
            </span>
          ))}
          {/* Duplicate for seamless loop */}
          {[
            'Oracle', 'Microsoft', 'Google', 'Salesforce', 'Anaplan', 'Deloitte',
            'Spaulding Ridge', 'Stratuum', 'Infosys', 'PwC', 'Cisco', 'Akamai',
            'Citrix', 'SAS', 'Cargill', 'ADM', 'Herman Miller', 'Dyson',
            'Coca-Cola', 'Goodyear', 'Kraft', 'GE Healthcare', 'AbbVie',
            'Hyatt', 'Ryder', 'Bank of America', 'NY Life', 'Manulife', 'AIG',
            'Citizens Financial', 'GE', 'NRG Energy', 'US Navy', 'US DoD',
            'US State Department', 'UVA', 'UVM', 'UNM', 'McMaster',
            'Creative Santa Fe', 'BBBS',
          ].map(client => (
            <span class="whitespace-nowrap text-sm font-medium text-text-muted/60 hover:text-text-secondary transition-colors shrink-0" aria-hidden="true">
              {client}
            </span>
          ))}
        </div>
        {/* Fade edges */}
        <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-background to-transparent pointer-events-none" />
        <div class="absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-background to-transparent pointer-events-none" />
      </div>
    </div>

    <style>
      @keyframes scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-scroll {
        animation: scroll 60s linear infinite;
      }
      .animate-scroll:hover {
        animation-play-state: paused;
      }
    </style>

    <!-- Expertise -->
    <div class="mt-24 pt-12 border-t border-border-light">
      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-8">Areas of expertise</h2>
      <div class="flex flex-wrap gap-3">
        {[
          'Enterprise Performance Management',
          'Strategic Planning',
          'Financial Systems & FP&A',
          'Business Analytics',
          'Data Strategy',
          'Scenario Planning',
          'Workshop Design',
          'Business Education',
          'AI for Business',
          'Value Selling',
          'Creative Economy',
          'Organizational Decision-Making',
        ].map(skill => (
          <span class="px-4 py-2 bg-surface-alt text-sm text-text-secondary rounded-full border border-border">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </section>

</Page>
