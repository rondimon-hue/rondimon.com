<body>
<main class="wrap">
  <a class="back" href="/design">&larr; Design</a>
  <p class="eyebrow">Design · New IP · Nov 3, 2026</p>
  <h1>Futures-to-Plan Integration Map</h1>
  <p class="lede">A process architecture, not a unified theory. Foresight practice usually stops before the plan, and long-range planning usually has no futures thinking. The value is the seam between them: <b>carrying futures work through to the planning system of record, then back out as signposts and triggers.</b></p>

  <div class="controls">
    <div class="group" role="group" aria-label="View">
      <span>View</span>
      <button class="seg" type="button" data-view="map" aria-pressed="true">Map</button>
      <button class="seg" type="button" data-view="diagnostic" aria-pressed="false">Diagnostic</button>
    </div>
    <div class="group" role="group" aria-label="Tier">
      <span>Tier</span>
      <button class="seg" type="button" data-tier="full" aria-pressed="true">Full cycle</button>
      <button class="seg" type="button" data-tier="sprint" aria-pressed="false">Sprint</button>
      <button class="seg" type="button" data-tier="always" aria-pressed="false">Always-on</button>
    </div>
  </div>
  <p class="tier-note" id="tier-note" aria-live="polite"></p>

  <div class="layout">
    <div class="map">
      <div id="diagram" aria-label="Futures-to-plan integration map. Select a stage or track for details."></div>
      <div class="legend" aria-hidden="true">
        <span><i style="background:var(--q)"></i>Quantitative spine</span>
        <span><i style="background:var(--c)"></i>Qualitative cartography</span>
        <span><i style="background:var(--e)"></i>Evidence ledger</span>
        <span><i style="background:var(--s)"></i>Stakeholder engagement</span>
        <span><i style="background:var(--loop)"></i>Feedback loops</span>
      </div>
    </div>
    <aside class="panel" id="panel" aria-live="polite"></aside>
  </div>

  <div class="sections">
    <section class="card">
      <h2>Where the value is</h2>
      <ul>
        <li>The terminal node is the <b>system of record</b>, which turns futures from a workshop into an operating mechanism.</li>
        <li>Backcasting to <b>what would have to be true</b> gives targets a challengeable origin.</li>
        <li>Parallel quant and qual tracks with research breaks make it <b>iterative, not a waterfall</b>.</li>
      </ul>
    </section>
    <section class="card">
      <h2>How to use it</h2>
      <ol>
        <li><b>Diagnostic.</b> Score a client's planning against the stages. Most are strong at Commit &amp; cascade and weak at Frame, Explore and Adapt &amp; learn.</li>
        <li><b>Tiers.</b> A sprint (Frame to Choose, thin quant spine), a full cycle, and an always-on tier with signposts wired into rolling forecasts.</li>
        <li><b>Thesis.</b> Foresight shops rarely touch the planning system, and EPM firms rarely do futures. <span class="draft">To verify</span></li>
      </ol>
    </section>
    <section class="card">
      <h2>Before branding it</h2>
      <ul>
        <li>Review the crosswalk with 3 to 5 foresight practitioners and 3 to 5 FP&amp;A leaders.</li>
        <li>Retrospective test: would it have changed decisions in a past LRP around COVID or 2022 inflation?</li>
        <li>Pilot with one client. Track changed decisions, triggers tripped and forecast bias.</li>
      </ul>
    </section>
  </div>

  <details class="card" style="margin-bottom:40px">
    <summary>Known limits</summary>
    <ul>
      <li>"Unified" blurs forecasting, what-iffing and visioning. Label them Explore, Envision, Decide.</li>
      <li>About 45 activities is too heavy as a default. It needs tiers.</li>
      <li>It is a list, not a mechanism: nothing yet says what would show it does not work.</li>
    </ul>
  </details>
</main>

<footer class="wrap">
  Ron Dimon · Futures-to-Plan Integration, draft of Nov 3, 2026. Prior art is cited from memory and needs verifying before publication. Diagnostic questions are drafts. <a href="/design">Back to Design</a>
</footer>

<script is:inline>
// ---------- content (from Ron's note "Futures-to-Plan Integration: Overview and Map", Nov 3, 2026) ----------
const STAGES = [
  { id:'zero', code:'0', name:'Set up', purpose:'Fix the focal decision, horizon, decision rights and participants.',
    activities:['Focal decision','Horizon','Decision rights','Participants'],
    prior:[],
    gaps:[{t:'Facilitation design',d:'Who is in the room, and how the sessions are run.'}],
    questions:['What decision will this work change, and who makes it?','What horizon are we planning for, and why that one?','Who has the right to decide, and who needs to be in the room?'] },
  { id:'A', code:'A', name:'Sense', purpose:'Prework, data and a research ledger.',
    activities:['Prework','Data','Research ledger'],
    prior:[['Framework Foresight (Hines & Bishop); Voros','Closest prior art, stages A to D']],
    gaps:[],
    questions:['Which signals and data do we already watch, and who curates them?','Where do we record research and assumptions so others can challenge them?','What would surprise us to learn?'] },
  { id:'B', code:'B', name:'Frame', purpose:'Forces ranked by impact and uncertainty, assumptions, and the scenario architecture.',
    activities:['Forces ranked by impact and uncertainty','Assumptions','Scenario architecture'],
    prior:[['Framework Foresight (Hines & Bishop); Voros','Closest prior art'],['Shell and GBN scenarios; Cynefin; Schoemaker','Standard']],
    gaps:[{t:'Scenario construction',d:'Separate predetermined elements from critical uncertainties, then build the scenario architecture (2x2, cross-impact).'}],
    questions:['Which forces matter most, ranked by impact and by uncertainty?','Which planning assumptions are predetermined, and which are critical uncertainties?','How many distinct futures are we actually planning against?'] },
  { id:'C', code:'C', name:'Explore', purpose:'Scenarios, the forecast, what-ifs, visioning and backcasting.',
    activities:['Scenarios','Forecast','What-ifs','Visioning','Backcasting'],
    prior:[['Shell and GBN scenarios; Schoemaker','Standard'],['Dator; Martin’s “what would have to be true”; Discovery-Driven Planning','Established']],
    gaps:[],
    questions:['Do we keep forecasts, what-ifs and visions distinct, or blur them into one number?','Have we backcast from a preferred future to today?','What would have to be true for each scenario to play out?'] },
  { id:'D', code:'D', name:'Choose & design', purpose:'Strategy cascade, what would have to be true, stress-test, portfolio, and targets as ranges with triggers.',
    activities:['Strategy cascade','What would have to be true','Stress-test','Portfolio','Targets as ranges with triggers'],
    prior:[['Playing to Win; Hoshin catchball','Direct lift'],['Martin’s “what would have to be true”','Established']],
    gaps:[
      {t:'Targets under multiple futures',d:'Ranges with triggers, base case plus contingents, or tiered commitments. Otherwise scenarios collapse into one number.'},
      {t:'Stress-testing',d:'Run the strategy through every scenario, then add reverse stress tests and pre-mortems.'},
      {t:'Portfolio logic',d:'No-regret moves, hedges, options with exercise triggers and big bets, with kill criteria.'}],
    questions:['Are targets set as ranges with triggers, or as a single number?','Have we run the strategy through every scenario, including a reverse stress test or pre-mortem?','Which moves are no-regret, which are hedges, options or big bets, and what are the kill criteria?'] },
  { id:'E', code:'E', name:'Commit & cascade', purpose:'Catchball, and commitments in the system of record.',
    activities:['Catchball','Commitments in the system of record'],
    prior:[['Hoshin catchball; Playing to Win','Direct lift']],
    gaps:[{t:'Capital envelopes',d:'Where the money goes under each future.'}],
    questions:['Do commitments land in the planning system of record, with owners and dates?','Did targets go through catchball, or straight down the organization?','Where does capital go under each future, and who can move it?'] },
  { id:'F', code:'F', name:'Adapt & learn', purpose:'Signposts, triggers, governance and refresh.',
    activities:['Signposts','Triggers','Governance','Refresh'],
    prior:[['Robust Decision Making; adaptive pathways; real options','Strongest source for F']],
    gaps:[{t:'Learning loop',d:'How often it refreshes, and how what was learned feeds the next cycle.'}],
    questions:['What signposts would tell us a different future is arriving?','When a trigger trips, what happens, and who acts?','How often do we refresh, and what did we learn last cycle?'] },
];
const TRACKS = [
  { id:'q', name:'Quantitative spine', color:'--q', soft:'--qs', d:'A driver-based model that carries the numbers through every stage: from the forecast and what-ifs, to targets as ranges, to commitments and rolling forecasts.' },
  { id:'c', name:'Qualitative cartography', color:'--c', soft:'--cs', d:'Maps of the forces, assumptions and stories that sit alongside the numbers and explain them.' },
  { id:'e', name:'Evidence ledger', color:'--e', soft:'--es', d:'A running record of research, data and assumptions, so every claim and target has a source that can be challenged.' },
  { id:'s', name:'Stakeholder engagement', color:'--s', soft:'--ss', d:'Who is involved at each stage, from the people setting the focal decision to catchball and governance.' },
];
const LOOPS = {
  fast:{ name:'Fast loop', d:'Adapt & learn feeds straight back to Sense when signposts move: the plan changes between annual cycles, not just at them.' },
  slow:{ name:'Slow loop', d:'An annual refresh of the whole cycle, inside which the fast loop runs.' },
};
const TIERS = {
  full:{ stages:['zero','A','B','C','D','E','F'], thinQ:false, note:'Full cycle: every stage and all four tracks, with both loops.' },
  sprint:{ stages:['B','C','D'], thinQ:true, note:'Sprint: Frame to Choose & design, with a thin quantitative spine.' },
  always:{ stages:['F','A'], thinQ:false, note:'Always-on: signposts wired into rolling forecasts, running the fast loop between full cycles.' },
};
const SCALE = ['Absent','Ad hoc','Defined','Practised','Embedded'];

// ---------- state ----------
const S = { sel:{ kind:'stage', id:'B' }, view:'map', tier:'full', scores:{} };
try { Object.assign(S.scores, JSON.parse(sessionStorage.getItem('f2p-scores') || '{}')); } catch (e) {}
const $ = (s) => document.querySelector(s);
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
const NS = 'http://www.w3.org/2000/svg';
function el(tag, attrs, parent){ const n=document.createElementNS(NS,tag); for (const k in attrs) n.setAttribute(k, attrs[k]); if (parent) parent.appendChild(n); return n; }
function txt(parent, x, y, s, attrs){ const t=el('text', Object.assign({x, y}, attrs||{}), parent); t.textContent=s; return t; }

function scoreFill(id){
  const v = S.scores[id]; if (!v) return css('--surface');
  const dark = matchMedia('(prefers-color-scheme: dark)').matches;
  return (dark ? ['#5A2420','#5A4116','#4E4A17','#27482A','#1E5032'] : ['#F4C7C3','#F8DDB6','#F3EBB4','#CFE8C4','#A9D8B0'])[v-1];
}

// ---------- diagram ----------
function draw(){
  const host = $('#diagram'); host.innerHTML = '';
  const narrow = host.clientWidth < 720;
  const svg = el('svg', { viewBox: narrow ? '0 0 360 760' : '0 0 1180 470', role:'group', 'aria-label':'Stages, tracks and feedback loops' }, host);
  const defs = el('defs', {}, svg);
  const m = el('marker', { id:'arrow', viewBox:'0 0 10 10', refX:'8', refY:'5', markerWidth:'7', markerHeight:'7', orient:'auto-start-reverse' }, defs);
  el('path', { d:'M0,0 L10,5 L0,10 z', fill:css('--loop') }, m);
  const ma = el('marker', { id:'flow', viewBox:'0 0 10 10', refX:'8', refY:'5', markerWidth:'6', markerHeight:'6', orient:'auto' }, defs);
  el('path', { d:'M0,0 L10,5 L0,10 z', fill:css('--muted') }, ma);
  const tier = TIERS[S.tier];
  const pos = {};

  if (!narrow){
    // stage boxes
    const y=96, h=118, w=148, gap=14, x0=196;
    pos.zero = { x:16, y, w:150, h };
    STAGES.slice(1).forEach((s,i)=>{ pos[s.id] = { x:x0+i*(w+gap), y, w, h }; });
    // slow loop: dashed frame around everything
    const slow = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'loop', 'data-id':'slow', 'aria-label':'Slow loop: annual refresh' }, svg);
    el('rect', { class:'shape', x:6, y:28, width:1168, height:432, rx:22, fill:'none', stroke:css('--loop'), 'stroke-width':'1.6', 'stroke-dasharray':'6 7' }, slow);
    const sl = el('rect', { x:936, y:446, width:244, height:26, rx:13, fill:css('--surface') }, slow);
    txt(slow, 1058, 463, '↻ Slow loop · annual refresh', { 'text-anchor':'middle', fill:css('--loop'), 'font-size':'14.5', 'font-weight':'600' });
    // fast loop: arc from F back to A
    const a = pos.A, f = pos.F;
    const fast = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'loop', 'data-id':'fast', 'aria-label':'Fast loop: signposts back to Sense' }, svg);
    el('path', { class:'shape', d:`M${f.x+f.w/2},${f.y-4} C${f.x+f.w/2},${y-62} ${a.x+a.w/2},${y-62} ${a.x+a.w/2},${a.y-6}`, fill:'none', stroke:css('--loop'), 'stroke-width':'2.4', 'marker-end':'url(#arrow)' }, fast);
    el('path', { d:`M${f.x+f.w/2},${f.y-4} C${f.x+f.w/2},${y-62} ${a.x+a.w/2},${y-62} ${a.x+a.w/2},${a.y-6}`, fill:'none', stroke:'transparent', 'stroke-width':'18' }, fast);
    el('rect', { x:(a.x+f.x+f.w)/2-170, y:y-64, width:340, height:26, rx:13, fill:css('--surface') }, fast);
    txt(fast, (a.x+f.x+f.w)/2, y-46, '↺ Fast loop · signposts back to Sense', { 'text-anchor':'middle', fill:css('--loop'), 'font-size':'14.5', 'font-weight':'600' });
    // flow arrows between stages
    const order = ['zero','A','B','C','D','E','F'];
    for (let i=0;i<order.length-1;i++){ const p=pos[order[i]], q=pos[order[i+1]]; el('line', { x1:p.x+p.w+2, y1:y+h/2, x2:q.x-3, y2:y+h/2, stroke:css('--muted'), 'stroke-width':'1.6', 'marker-end':'url(#flow)' }, svg); }
    // tracks
    const ly0 = 250, lh = 32, lg = 12;
    txt(svg, 16, ly0-12, 'FOUR TRACKS RUN THROUGHOUT', { fill:css('--muted'), 'font-size':'12', 'font-weight':'600', 'letter-spacing':'1.2' });
    TRACKS.forEach((t,ti)=>{
      const ly = ly0 + ti*(lh+lg);
      const g = el('g', { class:'node lane', tabindex:'0', role:'button', 'data-kind':'track', 'data-id':t.id, 'aria-label':`Track: ${t.name}` }, svg);
      txt(g, 16, ly+lh/2+5, t.name, { fill:css(t.color), 'font-size':'14.5', 'font-weight':'600' });
      STAGES.slice(1).forEach((s)=>{
        const p = pos[s.id]; const on = tier.stages.includes(s.id);
        const thin = t.id==='q' && tier.thinQ;
        el('rect', { x:p.x, y: thin ? ly+lh/2-4 : ly, width:p.w, height: thin ? 8 : lh, rx: thin ? 4 : 8, fill:css(t.soft), stroke:css(t.color), 'stroke-width': on ? '1.4' : '0.6', opacity: on ? '1' : '.35' }, g);
      });
      el('line', { x1:pos.A.x, y1:ly+lh/2, x2:pos.F.x+pos.F.w, y2:ly+lh/2, stroke:css(t.color), 'stroke-width':'1.5', 'stroke-dasharray':'2 5', opacity:'.6' }, g);
    });
    // stage nodes on top
    STAGES.forEach((s)=>{
      const p = pos[s.id];
      const g = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'stage', 'data-id':s.id, 'aria-label':`Stage ${s.code}: ${s.name}` }, svg);
      el('rect', { class:'shape', x:p.x, y:p.y, width:p.w, height:p.h, rx:14, fill: S.view==='diagnostic' ? scoreFill(s.id) : css('--surface'), stroke:css('--accent'), 'stroke-width':'1.6' }, g);
      txt(g, p.x+14, p.y+30, s.code, { fill:css('--accent'), 'font-size':'23', 'font-family':'Fraunces, Georgia, serif', 'font-weight':'650' });
      wrapText(g, s.name, p.x+14, p.y+58, p.w-22, 20, { fill:css('--ink'), 'font-size':'18', 'font-weight':'600' });
      const sub = S.view==='diagnostic' ? (S.scores[s.id] ? `${S.scores[s.id]} · ${SCALE[S.scores[s.id]-1]}` : 'Not scored') : `${s.activities.length} activities`;
      txt(g, p.x+14, p.y+p.h-14, sub, { fill:css('--muted'), 'font-size':'14' });
      if (!tier.stages.includes(s.id)) g.classList.add('dim');
    });
  } else {
    // vertical layout for phones
    const x=64, w=268, h=70, gap=20; let y=16;
    const order = ['zero','A','B','C','D','E','F'];
    order.forEach((id)=>{ pos[id] = { x, y, w, h: id==='zero'?54:h }; y += (id==='zero'?54:h) + gap; });
    const top = pos.A.y, bottom = pos.F.y+pos.F.h;
    // tracks as vertical stripes on the left
    TRACKS.forEach((t,ti)=>{
      const g = el('g', { class:'node lane', tabindex:'0', role:'button', 'data-kind':'track', 'data-id':t.id, 'aria-label':`Track: ${t.name}` }, svg);
      const sx = 10 + ti*12; const thin = t.id==='q' && tier.thinQ;
      el('rect', { x: thin ? sx+2 : sx, y:top, width: thin ? 4 : 8, height:bottom-top, rx:4, fill:css(t.color), opacity:'.85' }, g);
      el('rect', { x:sx-2, y:top, width:12, height:bottom-top, fill:'transparent' }, g);
    });
    // fast loop on the right
    const fast = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'loop', 'data-id':'fast', 'aria-label':'Fast loop: signposts back to Sense' }, svg);
    el('path', { class:'shape', d:`M${x+w},${pos.F.y+pos.F.h/2} C${x+w+26},${pos.F.y+pos.F.h/2} ${x+w+26},${pos.A.y+pos.A.h/2} ${x+w+4},${pos.A.y+pos.A.h/2}`, fill:'none', stroke:css('--loop'), 'stroke-width':'2.4', 'marker-end':'url(#arrow)' }, fast);
    el('path', { d:`M${x+w},${pos.F.y+pos.F.h/2} C${x+w+26},${pos.F.y+pos.F.h/2} ${x+w+26},${pos.A.y+pos.A.h/2} ${x+w+4},${pos.A.y+pos.A.h/2}`, fill:'none', stroke:'transparent', 'stroke-width':'20' }, fast);
    for (let i=0;i<order.length-1;i++){ const p=pos[order[i]], q=pos[order[i+1]]; el('line', { x1:x+w/2, y1:p.y+p.h+2, x2:x+w/2, y2:q.y-3, stroke:css('--muted'), 'stroke-width':'1.6', 'marker-end':'url(#flow)' }, svg); }
    STAGES.forEach((s)=>{
      const p = pos[s.id];
      const g = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'stage', 'data-id':s.id, 'aria-label':`Stage ${s.code}: ${s.name}` }, svg);
      el('rect', { class:'shape', x:p.x, y:p.y, width:p.w, height:p.h, rx:12, fill: S.view==='diagnostic' ? scoreFill(s.id) : css('--surface'), stroke:css('--accent'), 'stroke-width':'1.6' }, g);
      txt(g, p.x+14, p.y+p.h/2+7, s.code, { fill:css('--accent'), 'font-size':'20', 'font-family':'Fraunces, Georgia, serif', 'font-weight':'650' });
      txt(g, p.x+42, p.y+p.h/2+1, s.name, { fill:css('--ink'), 'font-size':'16', 'font-weight':'600' });
      const sub = S.view==='diagnostic' ? (S.scores[s.id] ? `${S.scores[s.id]} · ${SCALE[S.scores[s.id]-1]}` : 'Not scored') : `${s.activities.length} activities`;
      txt(g, p.x+42, p.y+p.h/2+19, sub, { fill:css('--muted'), 'font-size':'12.5' });
      if (!tier.stages.includes(s.id)) g.classList.add('dim');
    });
    const slow = el('g', { class:'node', tabindex:'0', role:'button', 'data-kind':'loop', 'data-id':'slow', 'aria-label':'Slow loop: annual refresh' }, svg);
    el('rect', { class:'shape', x:4, y:6, width:352, height:bottom+34, rx:18, fill:'none', stroke:css('--loop'), 'stroke-width':'1.6', 'stroke-dasharray':'6 7' }, slow);
    txt(slow, 180, bottom+30, '↻ Slow loop · annual refresh', { 'text-anchor':'middle', fill:css('--loop'), 'font-size':'13', 'font-weight':'600' });
    svg.setAttribute('viewBox', `0 0 360 ${bottom+48}`);
  }
  // selection outline
  svg.querySelectorAll('.node').forEach((g)=>{
    const hit = g.dataset.kind===S.sel.kind && g.dataset.id===S.sel.id;
    g.setAttribute('aria-pressed', hit ? 'true' : 'false');
    const shape = g.querySelector('.shape');
    if (hit && shape) shape.setAttribute('stroke-width', g.dataset.kind==='stage' ? '4' : '3.4');
  });
}
function wrapText(parent, s, x, y, maxW, lh, attrs){
  const words = s.split(' '); let line = ''; let yy = y; const per = Math.floor(maxW / 9.4);
  for (const w of words){ const t = line ? line+' '+w : w; if (t.length > per && line){ txt(parent, x, yy, line, attrs); line = w; yy += lh; } else line = t; }
  if (line) txt(parent, x, yy, line, attrs);
}

// ---------- panel ----------
function panel(){
  const p = $('#panel'); let h = '';
  if (S.view==='diagnostic'){
    const scored = STAGES.filter((s)=>S.scores[s.id]);
    let sum = 'Score each stage from 1 (absent) to 5 (embedded). In practice most organizations are strong at Commit &amp; cascade and weak at Frame, Explore and Adapt &amp; learn.';
    if (scored.length){
      const min = Math.min(...scored.map((s)=>S.scores[s.id]));
      const weak = scored.filter((s)=>S.scores[s.id]===min).map((s)=>`${s.code} ${s.name}`).join(', ');
      sum = `<b>Scored ${scored.length} of ${STAGES.length}.</b> Weakest so far: ${esc(weak)}. Use its diagnostic questions to plan the next step.`;
    }
    h += `<p class="diag-summary">${sum}</p>`;
  }
  if (S.sel.kind==='stage'){
    const s = STAGES.find((x)=>x.id===S.sel.id);
    h += `<p class="k" style="color:var(--accent)">Stage ${s.code}</p><h2>${esc(s.name)}</h2><p>${esc(s.purpose)}</p>`;
    if (S.view==='diagnostic'){
      h += `<h3>How mature is this stage?</h3><div class="score" role="group" aria-label="Score ${esc(s.name)}">${SCALE.map((l,i)=>`<button type="button" data-score="${i+1}" aria-pressed="${S.scores[s.id]===i+1}" title="${l}">${i+1}</button>`).join('')}</div><div class="score-scale"><span>Absent</span><span>Embedded</span></div>`;
    }
    h += `<h3>Diagnostic questions <span class="draft">Draft</span></h3><ol class="list">${s.questions.map((q)=>`<li>${esc(q)}</li>`).join('')}</ol>`;
    h += `<h3>Activities</h3><ul class="chips">${s.activities.map((a)=>`<li>${esc(a)}</li>`).join('')}</ul>`;
    if (s.gaps.length) h += `<h3>Gaps to close</h3>${s.gaps.map((g)=>`<div class="gap"><b>${esc(g.t)}</b>${esc(g.d)}</div>`).join('')}`;
    h += `<h3>Prior art <span class="draft">To verify</span></h3>`;
    h += s.prior.length ? `<ul class="list prior" style="list-style:none;padding:0">${s.prior.map(([a,b])=>`<li><span>${esc(a)}</span><em>${esc(b)}</em></li>`).join('')}</ul>` : `<p style="color:var(--muted);font-size:14px">None listed for this stage.</p>`;
    h += `<h3>Tracks</h3><p style="font-size:14px">All four tracks run through this stage: ${TRACKS.map((t)=>`<a href="#" data-goto-track="${t.id}" style="color:var(${t.color})">${esc(t.name)}</a>`).join(', ')}.</p>`;
  } else if (S.sel.kind==='track'){
    const t = TRACKS.find((x)=>x.id===S.sel.id);
    h += `<p class="k" style="color:var(${t.color})">Track</p><h2>${esc(t.name)}</h2><p>${esc(t.d)} <span class="draft">Draft</span></p><p>Runs in parallel with every stage, from Sense through Adapt &amp; learn${t.id==='q' && TIERS[S.tier].thinQ ? '. In a sprint it is kept thin.' : '.'}</p>`;
  } else {
    const l = LOOPS[S.sel.id];
    h += `<p class="k" style="color:var(--loop)">Feedback loop</p><h2>${esc(l.name)}</h2><p>${esc(l.d)}</p>`;
  }
  h += `<p style="margin-top:18px;font-size:13px;color:var(--muted)">Select any stage, track or loop on the map.</p>`;
  p.innerHTML = h;
}

function render(){
  document.querySelectorAll('[data-view]').forEach((b)=>b.setAttribute('aria-pressed', String(b.dataset.view===S.view)));
  document.querySelectorAll('[data-tier]').forEach((b)=>b.setAttribute('aria-pressed', String(b.dataset.tier===S.tier)));
  $('#tier-note').textContent = TIERS[S.tier].note;
  draw(); panel();
}
function select(kind, id){ S.sel = { kind, id }; render(); }

document.addEventListener('click', (e)=>{
  const n = e.target.closest('#diagram .node'); if (n) { select(n.dataset.kind, n.dataset.id); return; }
  const v = e.target.closest('[data-view]'); if (v) { S.view = v.dataset.view; if (S.sel.kind!=='stage') S.sel = { kind:'stage', id:'B' }; render(); return; }
  const t = e.target.closest('[data-tier]'); if (t) { S.tier = t.dataset.tier; render(); return; }
  const sc = e.target.closest('[data-score]');
  if (sc) { S.scores[S.sel.id] = Number(sc.dataset.score); try { sessionStorage.setItem('f2p-scores', JSON.stringify(S.scores)); } catch (err) {} render(); return; }
  const gt = e.target.closest('[data-goto-track]'); if (gt) { e.preventDefault(); select('track', gt.dataset.gotoTrack); }
});
document.addEventListener('keydown', (e)=>{
  const n = e.target.closest && e.target.closest('#diagram .node');
  if (n && (e.key==='Enter' || e.key===' ')) { e.preventDefault(); select(n.dataset.kind, n.dataset.id); setTimeout(()=>{ const again = document.querySelector(`#diagram .node[data-kind="${n.dataset.kind}"][data-id="${n.dataset.id}"]`); if (again) again.focus(); }, 0); }
});
let rt; window.addEventListener('resize', ()=>{ clearTimeout(rt); rt = setTimeout(draw, 120); });
matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
render();
</script>
</body>
</html>
