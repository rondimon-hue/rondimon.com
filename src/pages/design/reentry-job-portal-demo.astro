function maxStep(){ return S.mineApps.length ? 5 : (S.picked.size ? 4 : 1); }

function renderApplicants(){
  const p = $('#panel-applicants');
  const stepper = `<ol class="steps" aria-label="Steps">${STEPS.map((l,i)=>{
    const n=i+1, locked = n>maxStep() && n!==S.step;
    return `<li><button class="stepbtn ${n<S.step?'done':''}" data-act="step" data-v="${n}" ${n===S.step?'aria-current="step"':''} ${locked?'disabled':''}><span class="n">${n<S.step?IC.check:n}</span><span class="lbl">${l}</span></button></li>`;}).join('')}</ol>`;
  const note = `<div class="sysnote"><span class="tag">Behind the scenes</span><span>${SYSNOTE[S.step-1]}</span></div>`;
  const body = [stepJobs, stepSkills, stepFit, stepReview, stepApps][S.step-1]();
  p.innerHTML = `<div class="row spread" style="margin-bottom:12px"><div><h2 class="h2">Alex R. <span class="muted" style="font-family:var(--body);font-size:.9rem;font-weight:400">· demo applicant, Santa Fe</span></h2><div class="muted" style="font-size:14px">Working with ${esc(DATA.profile.navigator)} on a shared shelter computer. Sample profile, built from a resume.</div></div></div>${stepper}${note}${body}`;
}

function stepJobs(){
  const q = S.q.trim().toLowerCase();
  const list = S.jobs.filter(j => (S.filter==='all' || (S.filter==='gov') === j.gov) && (!q || (j.title+' '+j.employer).toLowerCase().includes(q)));
  const nGov = S.jobs.filter(j=>j.gov).length, nBiz = S.jobs.length - nGov;
  const cards = list.map(j => {
    const tier = TIER[j.tier];
    return `<label class="job"><input type="checkbox" data-act="pick" data-id="${j.id}" ${S.picked.has(j.id)?'checked':''} aria-label="Select ${esc(j.title)} at ${esc(j.employer)}">
      <span class="box">${IC.check}</span>
      <span style="min-width:0"><span class="t">${esc(j.title)}</span><br><span class="emp">${esc(j.employer)} · ${esc(j.dept)}</span>
      <span class="meta">${j.gov?chip('City HR posting','gov'):chip('Sample posting','sample')}${tier?chip(tier[0],tier[1]):''}${chip(j.openings+' opening'+(j.openings>1?'s':''))}${chip(esc(j.pay))}${j.vdays>45?chip('Verified '+esc(j.verified)+' · re-verify soon','warn'):chip('Verified '+esc(j.verified))}</span></span></label>`;
  }).join('');
  const sel = S.picked.size;
  return `<div class="filters">
      <button class="pill" data-act="filter" data-v="all" aria-pressed="${S.filter==='all'}">All jobs (${S.jobs.length})</button>
      <button class="pill" data-act="filter" data-v="gov" aria-pressed="${S.filter==='gov'}">City of Santa Fe (${nGov})</button>
      <button class="pill" data-act="filter" data-v="biz" aria-pressed="${S.filter==='biz'}">Employers (${nBiz})</button>
      <input class="search" type="search" placeholder="Search jobs" value="${esc(S.q)}" data-act="search" aria-label="Search jobs"></div>
    <p class="muted" style="margin:0 0 12px">Check every job you want to go after. You can pick as many as you like.</p>
    <div class="jobs">${cards || '<div class="empty">No jobs match.</div>'}</div>
    <div class="actionbar"><span><b>${sel}</b> job${sel===1?'':'s'} selected</span>
      <button class="btn primary" data-act="next" ${sel?'':'disabled'}>Continue to skills ${IC.arrow}</button></div>`;
}

function neededFor(id){
  return pick().flatMap(j => j.reqs.filter(r => r[0]===id).map(r => ({j, lvl:r[1], note:r[2]})));
}
function stepSkills(){
  const jobs = pick();
  if(!jobs.length) return `<div class="empty">Pick at least one job first.</div>`;
  const ids = [...new Set(jobs.flatMap(j => j.reqs.map(r => r[0])))];
  const groups = Object.entries(DATA.cats).map(([c,label]) => {
    const rows = ids.filter(id => SK[id].cat===c).map(id => {
      const nf = neededFor(id), only = nf.every(x => x.lvl==='H');
      const v = S.skills[id] || 'no';
      const tags = nf.map(x => `${esc(x.j.title)} <span class="lvl">(${x.lvl==='R'?'required':x.lvl==='P'?'preferred':'after hire'})</span>`).join(' · ');
      const notes = [...new Set(nf.filter(x=>x.note).map(x=>x.note))].slice(0,2).join(' / ');
      return `<div class="skill"><div class="l">${esc(SK[id].label)}${S.fromResume.has(id)?' '+chip('from your resume','cand'):''}${only?' '+chip('can be earned after hire','sys'):''}
        <div class="for">Needed for: ${tags}</div>${notes?`<div class="for">${esc(notes)}</div>`:''}</div>
        <div class="seg" role="group" aria-label="${esc(SK[id].label)}">
          <button class="have" data-act="skill" data-id="${id}" data-v="have" aria-pressed="${v==='have'}">Have it</button>
          <button class="get" data-act="skill" data-id="${id}" data-v="get" aria-pressed="${v==='get'}">Can get it</button>
          <button class="no" data-act="skill" data-id="${id}" data-v="no" aria-pressed="${v==='no'}">Not yet</button></div></div>`;
    }).join('');
    return rows ? `<div class="skgroup"><h3 class="h3">${label}</h3>${rows}</div>` : '';
  }).join('');
  return `<p class="muted" style="margin:0 0 12px">${ids.length} things come up across your ${jobs.length} job${jobs.length>1?'s':''}. Choose <b>Have it</b> if you meet the amount shown, <b>Can get it</b> if you could earn it, or <b>Not yet</b>.</p>${groups}
    <div class="actionbar"><button class="btn" data-act="prev">Back</button><button class="btn primary" data-act="next">See how you fit ${IC.arrow}</button></div>`;
}

function stepFit(){
  const jobs = pick();
  if(!jobs.length) return `<div class="empty">Pick at least one job first.</div>`;
  const cards = jobs.map(j => {
    const f = fit(j, S.skills); const [rl,rc] = READY[f.ready];
    const cls = f.score>=75?'':f.score>=45?'mid':'low';
    const applyOn = S.apply[j.id] !== false;
    const items = f.items.slice().sort((a,b)=>'RPH'.indexOf(a.lvl)-'RPH'.indexOf(b.lvl)).map(i => {
      const sym = i.st==='have' ? IC.check : i.st==='get' ? IC.half : i.st==='gap' ? IC.x : IC.clock;
      const word = i.st==='have'?'You have this': i.st==='get'?'You can get this': i.st==='gap'?'Not yet': 'You can earn this after hire';
      return `<div class="req"><span class="s ${i.st}" title="${word}" role="img" aria-label="${word}">${sym}</span><div><b>${esc(SK[i.id].label)}</b> <span class="lvl">${lvlName(i.lvl)}</span><div class="note">${esc(i.note||'')}${i.note?' · ':''}${word}</div></div></div>`;
    }).join('');
    const conds = j.conditions.map(c => chip(esc(c), /background/i.test(c)?'warn':'')).join('');
    const bg = j.conditions.some(c=>/background/i.test(c));
    const help = f.gaps ? `<div class="help"><b>Close the gap:</b> ${j.gov ? esc(j.training) : 'The employer trains on the job. Mention any related experience.'} ${j.gov?'':''}</div>` : '';
    const bgnote = bg ? `<div class="help" style="background:var(--warn-soft);color:var(--warn)"><b>Talk with your navigator first.</b> This posting states a background check. ${esc(DATA.profile.navigator.split(',')[0])} can walk you through how it applies before you apply. The portal never asks about your record.</div>` : '';
    return `<div class="card fit"><div class="top"><div style="min-width:0"><div class="t" style="font-weight:700;font-size:17px">${esc(j.title)}</div><div class="muted">${esc(j.employer)} ${j.gov?chip('City HR posting','gov'):chip('Sample','sample')}</div></div>
      <div style="min-width:200px;flex:1;max-width:320px"><div class="row spread"><b>Meets ${f.rm} of ${f.rt} required</b>${chip(rl,rc)}</div><div class="meter ${cls}" style="margin-top:6px" role="img" aria-label="Fit ${f.score} percent"><i style="width:${f.score}%"></i></div></div></div>
      <div style="margin-top:10px">${items}</div>${help}${bgnote}<div class="cond">${conds}</div>
      <div class="row spread" style="margin-top:12px"><label class="switch"><input type="checkbox" data-act="apply" data-id="${j.id}" ${applyOn?'checked':''}> ${f.gaps?'Apply anyway':'Apply to this job'}</label>
      <button class="btn sm danger" data-act="drop" data-id="${j.id}">Remove from my list</button></div></div>`;
  }).join('');
  const nApply = jobs.filter(j => S.apply[j.id] !== false).length;
  return `<p class="muted" style="margin:0 0 12px"><b>This is a guide, not a gate.</b> A gap does not stop you from applying. Many requirements in entry-level postings are really preferences.</p>${cards}
    <div class="actionbar"><button class="btn" data-act="prev">Back</button><span><b>${nApply}</b> of ${jobs.length} will be sent</span><button class="btn primary" data-act="next" ${nApply?'':'disabled'}>Review and consent ${IC.arrow}</button></div>`;
}

function stepReview(){
  const jobs = pick().filter(j => S.apply[j.id] !== false);
  const already = new Set(S.mineApps.map(a=>a.job));
  const fresh = jobs.filter(j => !already.has(j.id));
  const rows = jobs.map(j => `<tr><td><b>${esc(j.title)}</b><br><span class="muted">${esc(j.employer)}</span></td><td>${esc(CH[j.channel].short)}<br><span class="muted">${esc(CH[j.channel].how)}</span></td><td>${already.has(j.id)?chip('Already sent','ok'):''}</td></tr>`).join('');
  const have = Object.entries(S.skills).filter(([,v])=>v==='have').length;
  return `<div class="cols"><div class="card"><h3 class="h3">Where each application goes</h3><div class="scroll-x"><table class="tbl"><thead><tr><th>Job</th><th>How it gets there</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>
      <h3 class="h3" style="margin-top:18px">How we reach you</h3>
      ${[['text','Text message','Works with no email and on any phone, including a shared one.'],['email','Email','Needs an address you can check.'],['nav','Through my navigator','Dana K. gets the update and passes it on.']].map(([v,t,d])=>`<label class="radio"><input type="radio" name="notify" data-act="notify" data-v="${v}" ${S.notify===v?'checked':''}><span><b>${t}</b><br><span class="muted">${d}</span></span></label>`).join('')}
    </div>
    <div style="display:grid;gap:14px;align-content:start">
      <div class="card"><h3 class="h3">What employers will see</h3><ul class="list"><li>Your name and how to reach you through the portal</li><li>The ${have} skills you marked <b>Have it</b>, and what you can get</li><li>Your availability</li><li>The job-related work history in your resume</li></ul>
        <h3 class="h3 no" style="margin-top:14px">What stays out</h3><ul class="list no"><li>Conviction history. The portal never asks.</li><li>Social Security number</li><li>Medical information</li></ul></div>
      <label class="consent"><input type="checkbox" data-act="consent" ${S.consent?'checked':''}><span><b>I agree to share this with the employers I chose.</b><br><span class="muted">You can stop at any time. Sharing is limited to the list on this page.</span></span></label>
      <label class="switch"><input type="checkbox" data-act="share" ${S.share?'checked':''}> Let ${esc(DATA.profile.navigator)} see my application status</label>
    </div></div>
    <div class="actionbar"><button class="btn" data-act="prev">Back</button><button class="btn primary" data-act="submit" ${S.consent&&fresh.length?'':'disabled'}>${fresh.length?`Send ${fresh.length} application${fresh.length>1?'s':''}`:'Nothing new to send'}</button></div>`;
}

function stepApps(){
  if(!S.mineApps.length) return `<div class="empty">You have not sent anything yet. Pick jobs, confirm your skills and send them, then your applications show up here.</div>`;
  const cards = S.mineApps.map(a => {
    const j = job(a.job), idx = STAGE_IDX[a.status], [sl,sc] = STAT[a.status];
    const tl = `<div class="tl" aria-label="Progress">${STAGES.map((l,i)=>`<div class="st ${i<=idx?'on':''} ${i===idx?'cur':''}">${l}</div>`).join('')}</div>`;
    const acts = a.status==='handoff' ? `<button class="btn sm" data-act="finished" data-id="${a.id}">I finished it on their site</button>` :
      (a.status==='received'||a.status==='review') ? `<button class="btn sm" data-act="selfint" data-id="${a.id}">I got an interview (tell the portal)</button>` : '';
    return `<div class="card" style="margin-bottom:12px"><div class="row spread"><div><b style="font-size:16px">${esc(j.title)}</b><div class="muted">${esc(j.employer)} · sent ${esc(a.date)}</div></div>${chip(sl,sc)}</div>${tl}
      ${a.status==='handoff'?`<div class="help">${esc(CH.handoff.how)} Your answers are ready to copy over.</div>`:''}${a.status==='closed'?`<div class="help">${esc(a.reason)}. You can apply to other jobs any time.</div>`:''}
      <div class="row" style="margin-top:10px">${acts}</div></div>`;
  }).join('');
  const msgs = S.msgs.length ? S.msgs.map(m => `<div class="bubble">${esc(m.text)}<time>${esc(m.time)}</time></div>`).join('') : '<div class="muted">No messages yet.</div>';
  return `<div class="cols"><div>${cards}<button class="btn" data-act="more">Pick more jobs</button></div>
    <div><h3 class="h3">Messages sent to your phone</h3><div class="phone" aria-live="polite">${S.notify==='text'?'':`<div class="muted" style="font-size:12px;margin-bottom:8px">You chose ${S.notify==='email'?'email':'your navigator'}; shown here as text for the demo.</div>`}${msgs}</div>
    <div class="note-box">To see the employer side, open the <b>Employers</b> tab: your applications are there, ranked next to the other applicants. Decisions made there show up here.</div></div></div>`;
}

/* =====================================================================
   TAB 2: EMPLOYERS
   ===================================================================== */
const employers = () => {
  const names = [...new Set(S.jobs.map(j => j.employer))];
  const order = n => n==='City of Santa Fe' ? 0 : ['Walgreens','CVS'].includes(n) ? 1 : 2;
  return names.sort((a,b) => order(a)-order(b) || a.localeCompare(b));
};
const appsFor = jid => S.apps.concat(S.mineApps.map(a => ({...a, who:'you'}))).filter(a => a.job === jid);
function ranked(jid){
  const j = job(jid);
  let list = appsFor(jid).map(a => { const p = person(a.who); return {a, p, f: fit(j, p.skills)}; });
  if(S.readyOnly) list = list.filter(x => x.f.ready==='ready');
  const dn = x => x.a.date;
  list.sort((x,y) => S.sort==='fit' ? (y.f.score-x.f.score || (x.a.date<y.a.date?-1:1)) : (dn(y)>dn(x)?1:-1));
  return list;
}
function renderEmployers(){
  const p = $('#panel-employers');
  const names = employers();
  if(!names.includes(S.emp)) S.emp = names[0];
  const ejobs = S.jobs.filter(j => j.employer===S.emp);
  if(!S.empJob || !ejobs.find(j=>j.id===S.empJob)) S.empJob = ejobs[0].id;
  const isGov = ejobs[0].gov;
  const opts = names.map(n => `<option ${n===S.emp?'selected':''}>${esc(n)}</option>`).join('');
  const op = ejobs.map(j => {
    const all = appsFor(j.id).map(a => fit(j, person(a.who).skills)), rd = all.filter(f=>f.ready==='ready').length;
    return `<button class="opening" data-act="empjob" data-id="${j.id}" aria-pressed="${j.id===S.empJob}"><div class="t">${esc(j.title)}</div><div class="muted" style="font-size:13px">${j.openings} opening${j.openings>1?'s':''} · ${esc(j.pay)}</div><div class="row" style="margin-top:6px">${chip(all.length+' applied','sys')}${chip(rd+' ready now','ok')}</div></button>`;
  }).join('');
  const J = job(S.empJob), list = ranked(S.empJob);
  if(S.selApp && !list.find(x=>x.a.id===S.selApp)) S.selApp = null;
  const rows = list.map((x,i) => {
    const [rl,rc] = READY[x.f.ready], [sl,sc] = STAT[x.a.status] || ['',''];
    const met = x.f.items.filter(i=>i.lvl==='R'&&i.st==='have').slice(0,2).map(i=>SK[i.id].label).join(', ');
    return `<button class="rank" data-act="selapp" data-id="${x.a.id}" aria-pressed="${x.a.id===S.selApp}">
      <span class="no1">${i+1}</span>
      <span class="c2"><span class="name">${esc(x.p.name)}</span>${x.a.who==='you'?'':''}<br><span class="muted" style="font-size:13px">Applied ${esc(x.a.date)}</span></span>
      <span class="c3"><span class="pct">${x.f.score}%</span> fit<div class="meter ${x.f.score>=75?'':x.f.score>=45?'mid':'low'}" style="margin-top:4px"><i style="width:${x.f.score}%"></i></div></span>
      <span class="c4">${chip(rl,rc)}<div class="muted" style="font-size:12.5px;margin-top:3px">${met?'Has: '+esc(met):''}</div></span>
      <span class="c5">${chip(sl,sc)}</span></button>`;
  }).join('');
  const sel = list.find(x => x.a.id===S.selApp);
  p.innerHTML = `<div class="sysnote" style="background:var(--sys-soft)"><span class="tag">Employer view</span><span>Hiring contacts see who applied, ranked by how well their skills match the posting. Ranking uses only skills and availability. The portal does not collect conviction history, so it cannot affect the order. Employers make every hiring decision.</span></div>
    <div class="row" style="margin-bottom:14px"><label for="empsel" style="font-weight:700">Viewing as</label><select id="empsel" data-act="emp" style="border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--surface);min-height:44px;min-width:230px">${opts}</select>${isGov?chip('Government','gov'):chip('Business · sample','sample')}</div>
    <div class="openings">${op}</div>
    <div class="emp-layout"><div class="card" style="padding:0;overflow:hidden">
      <div class="row spread" style="padding:14px"><div><h2 class="h2">${esc(J.title)}</h2><div class="muted">${list.length} applicant${list.length===1?'':'s'}${S.readyOnly?' (ready now only)':''} · ${J.openings} opening${J.openings>1?'s':''}</div></div>
        <div class="row"><label class="switch" style="min-height:36px"><input type="checkbox" data-act="ready" ${S.readyOnly?'checked':''}> Ready now only</label>
        <div class="seg" role="group" aria-label="Sort"><button class="have" style="${S.sort==='fit'?'':''}" data-act="sort" data-v="fit" aria-pressed="${S.sort==='fit'}">Best fit</button><button class="no" data-act="sort" data-v="new" aria-pressed="${S.sort==='new'}">Newest</button></div></div></div>
      ${rows || '<div class="empty" style="margin:14px">Nobody has applied yet.</div>'}
      <div class="note-box" style="margin:14px">How ranking works: each required item counts double; each preferred item counts once; "can get it" counts half. Ties go to whoever applied first.</div></div>
      <aside class="card detail" aria-live="polite">${sel ? employerDetail(sel, J) : '<div class="empty">Select an applicant to see how they match, and to respond.</div>'}</aside></div>`;
}
function employerDetail(x, J){
  const f = x.f, [rl,rc] = READY[f.ready], [sl,sc] = STAT[x.a.status] || ['',''];
  const initials = x.p.name.split(' ').map(w=>w[0]).slice(0,2).join('');
  const items = f.items.slice().sort((a,b)=>'RPH'.indexOf(a.lvl)-'RPH'.indexOf(b.lvl)).map(i => {
    const sym = i.st==='have'?IC.check : i.st==='get'?IC.half : i.st==='gap'?IC.x : IC.clock;
    const word = i.st==='have'?'Has this': i.st==='get'?'Can get this': i.st==='gap'?'Not yet': 'Earns after hire';
    return `<div class="req"><span class="s ${i.st}" role="img" aria-label="${word}">${sym}</span><div><b>${esc(SK[i.id].label)}</b> <span class="lvl">${lvlName(i.lvl)}</span><div class="note">${word}${i.note?' · '+esc(i.note):''}</div></div></div>`;
  }).join('');
  const closed = x.a.status==='closed';
  let actions;
  if(closed) actions = `<div class="note-box">Closed: ${esc(x.a.reason||'No reason recorded')}.</div>`;
  else if(S.declining) actions = `<div class="decide"><label for="why" style="font-weight:700">Why is this applicant not moving forward?</label><select id="why" style="border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--surface);min-height:44px"><option>Position filled</option><option>A required item is missing</option><option>Schedule does not match</option><option>Another applicant was a closer match</option></select><div class="row"><button class="btn danger" data-act="decline" data-id="${x.a.id}">Send "No"</button><button class="btn" data-act="canceldecline">Cancel</button></div></div>`;
  else actions = `<div class="decide"><button class="btn" data-act="decide" data-v="review" data-id="${x.a.id}" ${x.a.status==='review'||x.a.status==='interview'?'disabled':''}>Mark under review</button><button class="btn sys" data-act="decide" data-v="interview" data-id="${x.a.id}" ${x.a.status==='interview'?'disabled':''}>Yes: invite to interview</button><button class="btn danger" data-act="startdecline">No: not moving forward</button></div>`;
  return `<div class="row" style="margin-bottom:10px"><div class="avatar">${esc(initials)}</div><div><h2 class="h2" style="font-size:1.2rem">${esc(x.p.name)}</h2><div class="row">${chip(rl,rc)}${chip(sl,sc)}</div></div></div>
    <p style="margin:0 0 6px">${esc(x.p.summary)}</p><p class="muted" style="margin:0 0 12px;font-size:13.5px">Availability: ${esc(x.p.avail)} · Fit ${f.score}% · meets ${f.rm} of ${f.rt} required</p>
    <h3 class="h3">Match against the posting</h3>${items}${actions}
    <div class="note-box">A "Yes" is not a job offer. It moves the applicant to the next step, and ${x.a.who==='you'?'they get a text message right away.':'the applicant is told.'}</div>`;
}

/* =====================================================================
   TAB 3: DATA
   ===================================================================== */
function renderData(){
  const p = $('#panel-data');
  const sub = [['overview','Sources & funnel'],['openings','Job openings'],['skills','Skills']];
  const nav = `<div class="filters">${sub.map(([v,l]) => `<button class="pill" data-act="dsub" data-v="${v}" aria-pressed="${S.dsub===v}">${l}</button>`).join('')}</div>`;
  p.innerHTML = nav + (S.dsub==='overview' ? dataOverview() : S.dsub==='openings' ? dataOpenings() : dataSkills());
}
function dataOverview(){
  const T = DATA.totals, max = Math.max(...DATA.funnel.map(f=>f.n));
  const col = {1:'var(--ok)',2:'var(--sys)',3:'var(--warn)',4:'var(--bad)',5:'var(--muted)'};
  const funnel = DATA.funnel.map(f => `<div class="bar"><div><b>Tier ${f.t}: ${esc(f.label)}</b><div class="muted" style="font-size:12.5px">${esc(f.detail)}</div></div><div class="trk"><i style="width:${Math.round(100*f.n/max)}%;background:${col[f.t]}"></i></div><div class="mono" style="text-align:right">${f.n}</div></div>`).join('');
  const dmax = DATA.depts[0].n;
  const depts = DATA.depts.map(d => `<div class="bar"><div>${esc(d.name)}</div><div class="trk"><i style="width:${Math.round(100*d.n/dmax)}%;background:var(--sys)"></i></div><div class="mono" style="text-align:right">${d.n}</div></div>`).join('');
  const tr = DATA.training.filter(t => !t.path.startsWith('N/A')).sort((a,b)=>b.n-a.n).slice(0,7).map(t => `<tr><td>${esc(t.path.replace(/\s*\(state exam.*$/,'').replace(/\s*\(state-licensed.*$/,''))}</td><td class="mono">${t.n}</td><td class="muted">${esc(t.ex.split(', ').slice(0,3).join(', '))}</td></tr>`).join('');
  const up = S.uploaded ? '' : '';
  return `<div class="grid3" style="margin-bottom:16px">
      <div class="card stat"><b>${T.vacancies}</b><span>City vacancies loaded (as of Aug 14, 2026)</span></div>
      <div class="card stat"><b>${T.classes}</b><span>job classes across ${T.depts} departments</span></div>
      <div class="card stat"><b>${DATA.funnel[0].n + DATA.funnel[1].n}</b><span>vacancies in tiers 1 and 2: the ones this portal can feature today</span></div></div>
    <h3 class="h3">Sources</h3><div class="src" style="margin-bottom:20px">${DATA.sources.map(s => `<div class="card"><div class="row spread"><b>${esc(s.name)}</b>${chip(s.state, s.real?'ok':'sample')}</div><div class="muted" style="font-size:13.5px;margin-top:4px">${esc(s.kind)}</div><div style="margin-top:6px;font-size:14px">${esc(s.detail)}</div></div>`).join('')}</div>
    <div class="grid2"><div class="card"><h2 class="h2">Which City vacancies fit?</h2><p class="muted" style="margin:0 0 12px">All ${T.vacancies} vacancies sorted by re-entry fit. Tiers 1 and 2 are listed in the demo. Tier 3 needs a department check, and tier 4 is closed to anyone with a conviction by statute.</p><div class="bars">${funnel}</div></div>
      <div class="card"><h2 class="h2">Where the openings are</h2><p class="muted" style="margin:0 0 12px">Vacancies by department, top 8.</p><div class="bars">${depts}</div></div></div>
    <div class="card" style="margin-top:14px"><h2 class="h2">Training paths these vacancies point to</h2><p class="muted" style="margin:0 0 8px">Used for the “Close the gap” suggestions in the applicant's fit check.</p><div class="scroll-x"><table class="tbl"><thead><tr><th>Training or path</th><th>Vacancies</th><th>Example job classes</th></tr></thead><tbody>${tr}</tbody></table></div></div>`;
}
function dataOpenings(){
  const q = S.dq.trim().toLowerCase();
  const list = S.jobs.filter(j => (S.dfilter==='all' || (S.dfilter==='gov')===j.gov) && (!q || (j.title+' '+j.employer).toLowerCase().includes(q)));
  const rows = list.map(j => `<tr data-act="dsel" data-id="${j.id}" class="${j.id===S.dsel?'sel':''}" tabindex="0" role="button" aria-label="Show requirements for ${esc(j.title)}"><td><b>${esc(j.title)}</b><br><span class="muted">${esc(j.employer)}</span></td><td class="mono">${j.openings}</td><td>${esc(j.pay)}</td><td>${TIER[j.tier]?chip(TIER[j.tier][0],TIER[j.tier][1]):'<span class="muted">n/a</span>'}</td><td>${esc(CH[j.channel].short)}</td><td>${esc(j.verified)}${j.vdays>45?' '+chip('re-verify','warn'):''}</td><td class="mono">${j.reqs.length}</td><td>${j.reviewed?chip('Spot-checked','ok'):chip('Needs review','warn')}</td></tr>`).join('');
  const stages = ['Reading the file','Pulling out the requirements','Ready for a human spot-check'];
  const upload = `<div class="card" style="margin-bottom:14px"><div class="row spread"><div><h2 class="h2">Add postings</h2><div class="muted">Drop in a job description or a spreadsheet of openings. The system pulls out the requirements and flags them for a person to check before they go live.</div></div>
      <button class="btn sys" data-act="upload" ${S.uploaded||S.uploadStage?'disabled':''}>${S.uploaded?'Sample uploaded':'Try a sample upload'}</button></div>
      ${S.uploadStage?`<div class="prog" aria-hidden="true"><i style="width:${S.uploadStage*33.4}%"></i></div><div class="muted" style="margin-top:6px">${stages[Math.min(S.uploadStage,3)-1]}…</div>`:''}</div>`;
  const J = S.dsel ? job(S.dsel) : null;
  return upload + `<div class="filters"><button class="pill" data-act="dfilter" data-v="all" aria-pressed="${S.dfilter==='all'}">All (${S.jobs.length})</button><button class="pill" data-act="dfilter" data-v="gov" aria-pressed="${S.dfilter==='gov'}">City of Santa Fe</button><button class="pill" data-act="dfilter" data-v="biz" aria-pressed="${S.dfilter==='biz'}">Employers</button><input class="search" type="search" placeholder="Search openings" value="${esc(S.dq)}" data-act="dsearch" aria-label="Search openings"></div>
    <div class="card" style="padding:0"><div class="scroll-x"><table class="tbl"><thead><tr><th>Opening</th><th>Open</th><th>Pay</th><th>Fit tier</th><th>How applications go</th><th>Last verified</th><th>Reqs</th><th>Review</th></tr></thead><tbody>${rows}</tbody></table></div></div>
    ${J ? extractView(J) : '<p class="muted" style="margin-top:12px">Select an opening to see how its description was turned into structured requirements.</p>'}`;
}
function extractView(J){
  const reqs = J.reqs.map(([id,l,note]) => `<div class="req"><span class="s ${l==='R'?'gap':l==='P'?'get':'after'}" style="font-size:11px;font-weight:700" aria-hidden="true">${l}</span><div><b>${esc(SK[id].label)}</b> <span class="lvl">${lvlName(l)}</span><div class="note">${esc(note||'')}</div></div></div>`).join('');
  let src;
  if(J.jd.raw){ let t = esc(J.jd.raw); ['6:30 a.m.','lift up to 50 lbs','four-person crew','mowers, trimmers and hand tools','valid driver’s license'].forEach(k => { t = t.replace(esc(k), m => `<mark class="hl">${m}</mark>`); }); src = `<div class="quote"><b>Uploaded job description</b>${t}</div>`; }
  else src = [['Education', J.jd.edu],['Experience',J.jd.exp],['Licensure & certification',J.jd.lic],['Special requirements',J.jd.spec]].filter(x=>x[1]).map(([k,v]) => `<div class="quote"><b>${k}</b>${esc(v)}</div>`).join('') + (J.gov?`<div class="muted" style="font-size:12.5px">From the City's job description: ${esc(J.jd.src)}</div>`:`<div class="muted" style="font-size:12.5px">${esc(J.jd.src)}</div>`);
  return `<div class="card" style="margin-top:14px"><div class="row spread"><div><h2 class="h2">Requirement extraction: ${esc(J.title)}</h2><div class="muted">${esc(J.employer)} · ${J.reqs.length} requirements found</div></div>${J.reviewed?chip('Spot-checked','ok'):`<button class="btn sm sys" data-act="review" data-id="${J.id}">Mark as spot-checked</button>`}</div>
    <div class="extract" style="margin-top:12px"><div><h3 class="h3">What the posting says</h3>${src}</div><div><h3 class="h3">What the system understood</h3>${reqs}<div class="muted" style="font-size:12.5px;margin-top:6px"><b>R</b> required now · <b>P</b> preferred · <b>H</b> can be earned after hire</div></div></div></div>`;
}
function dataSkills(){
  const all = [...S.jobs];
  const rows = DATA.skills.map(s => {
    const R = all.filter(j=>j.reqs.some(r=>r[0]===s.id&&r[1]==='R')).length, P = all.filter(j=>j.reqs.some(r=>r[0]===s.id&&r[1]==='P')).length, H = all.filter(j=>j.reqs.some(r=>r[0]===s.id&&r[1]==='H')).length;
    const have = DATA.applicants.filter(a=>a.skills[s.id]==='have').length;
    return {s,R,P,H,have, tot:R+P+H};
  }).sort((a,b)=>b.tot-a.tot);
  const body = rows.map(r => `<tr><td><b>${esc(r.s.label)}</b></td><td class="muted">${esc(DATA.cats[r.s.cat])}</td><td class="mono">${r.R}</td><td class="mono">${r.P}</td><td class="mono">${r.H}</td><td class="mono">${r.have} of ${DATA.applicants.length}</td></tr>`).join('');
  return `<div class="card" style="padding:0"><div style="padding:16px 16px 0"><h2 class="h2">Skills across all openings</h2><p class="muted" style="margin:4px 0 12px">The shared vocabulary that the checklist, the fit check and the ranking all use. The last column shows how many of the ${DATA.applicants.length} sample applicants have each skill, which points to where training would help most.</p></div><div class="scroll-x"><table class="tbl"><thead><tr><th>Skill</th><th>Type</th><th>Required in</th><th>Preferred in</th><th>After hire in</th><th>Sample applicants who have it</th></tr></thead><tbody>${body}</tbody></table></div></div>`;
}

/* =====================================================================
   actions
   ===================================================================== */
function setStatus(app, status, reason){
  app.status = status; if(reason) app.reason = reason;
  if(app.who==='you'){
    const j = job(app.job);
    const t = {received:`${j.employer} received your application for ${j.title}. Reply HELP to talk to a person.`,
      review:`Your application for ${j.title} at ${j.employer} is now under review.`,
      interview:`Good news: ${j.employer} invited you to interview for ${j.title}. ${DATA.profile.navigator.split(',')[0]} can help you prepare. This is not a job offer.`,
      closed:`${j.employer} closed your application for ${j.title}: ${reason||'no reason given'}. You can apply to other jobs any time.`}[status];
    if(t) sms(t);
  }
}
function render(){
  document.querySelectorAll('.tab').forEach(t => { const on = t.dataset.v===S.tab; t.setAttribute('aria-selected', on); t.tabIndex = on?0:-1; });
  ['applicants','employers','data'].forEach(k => { $('#panel-'+k).hidden = k!==S.tab; });
  if(S.tab==='applicants') renderApplicants(); else if(S.tab==='employers') renderEmployers(); else renderData();
}
function go(step){ S.step = step; render(); $('#tab-applicants').scrollIntoView({block:'start'}); }

document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]'); if(!el) return;
  const a = el.dataset.act, id = el.dataset.id, v = el.dataset.v;
  if(['pick','apply','consent','share','ready','notify','search','dsearch','emp'].includes(a)) return; // handled on change/input
  switch(a){
    case 'tab': S.tab = v; render(); break;
    case 'step': go(+v); break;
    case 'next': go(Math.min(5, S.step+1)); break;
    case 'prev': go(Math.max(1, S.step-1)); break;
    case 'filter': S.filter = v; render(); break;
    case 'skill': if(v==='no') delete S.skills[id]; else S.skills[id] = v; S.fromResume.delete(id); render(); break;
    case 'drop': S.picked.delete(id); render(); toast('Removed from your list'); break;
    case 'submit': {
      const have = new Set(S.mineApps.map(x=>x.job));
      pick().filter(j => S.apply[j.id] !== false && !have.has(j.id)).forEach((j,i) => {
        const app = {id:'me'+j.id, job:j.id, who:'you', date:'Oct 9', status: j.channel==='handoff' ? 'handoff' : 'received', reason:''};
        S.mineApps.push(app);
        sms(j.channel==='handoff' ? `We pre-filled your ${j.title} application at ${j.employer}. Finish it on their site, then tap "I finished it" here.` : `${j.employer} received your application for ${j.title}. Reply HELP to talk to a person.`);
      });
      S.step = 5; render(); toast('Applications sent'); $('#tab-applicants').scrollIntoView({block:'start'}); break; }
    case 'finished': { const ap = S.mineApps.find(x=>x.id===id); setStatus(ap,'received'); render(); toast('Marked as received'); break; }
    case 'selfint': { const ap = S.mineApps.find(x=>x.id===id); setStatus(ap,'interview'); render(); toast('Interview recorded'); break; }
    case 'more': S.step = 1; render(); break;
    case 'emp': break;
    case 'empjob': S.empJob = id; S.selApp = null; S.declining = false; render(); break;
    case 'selapp': S.selApp = id; S.declining = false; render(); break;
    case 'sort': S.sort = v; render(); break;
    case 'decide': { const ap = findApp(id); setStatus(ap, v); render(); toast(v==='interview'?'Interview invitation sent':'Marked under review'); break; }
    case 'startdecline': S.declining = true; render(); break;
    case 'canceldecline': S.declining = false; render(); break;
    case 'decline': { const ap = findApp(id); setStatus(ap,'closed', $('#why').value); S.declining = false; render(); toast('Response recorded'); break; }
    case 'dsub': S.dsub = v; render(); break;
    case 'dfilter': S.dfilter = v; render(); break;
    case 'dsel': S.dsel = id; render(); break;
    case 'review': { job(id).reviewed = true; render(); toast('Marked as spot-checked'); break; }
    case 'upload': runUpload(); break;
  }
});
document.addEventListener('keydown', e => {
  const tr = e.target.closest('tr[data-act="dsel"]');
  if(tr && (e.key==='Enter'||e.key===' ')){ e.preventDefault(); S.dsel = tr.dataset.id; render(); }
  const tab = e.target.closest('.tab');
  if(tab && (e.key==='ArrowRight'||e.key==='ArrowLeft')){
    const order = ['applicants','employers','data']; const i = order.indexOf(S.tab);
    S.tab = order[(i + (e.key==='ArrowRight'?1:2)) % 3]; render(); $('#tab-'+S.tab).focus();
  }
});
document.addEventListener('change', e => {
  const el = e.target.closest('[data-act]'); if(!el) return;
  const a = el.dataset.act, id = el.dataset.id;
  if(a==='pick'){ el.checked ? S.picked.add(id) : S.picked.delete(id); renderApplicants(); const n = document.querySelector('input[data-act="pick"][data-id="'+id+'"]'); if(n) n.focus({preventScroll:true}); }
  else if(a==='apply'){ S.apply[id] = el.checked; renderApplicants(); }
  else if(a==='consent'){ S.consent = el.checked; renderApplicants(); }
  else if(a==='share'){ S.share = el.checked; }
  else if(a==='notify'){ S.notify = el.dataset.v; renderApplicants(); }
  else if(a==='ready'){ S.readyOnly = el.checked; renderEmployers(); }
  else if(a==='emp'){ S.emp = el.value; S.empJob = null; S.selApp = null; S.declining = false; renderEmployers(); }
});
document.addEventListener('input', e => {
  const el = e.target.closest('[data-act]'); if(!el) return;
  if(el.dataset.act==='search'){ S.q = el.value; const pos = el.selectionStart; renderApplicants(); const n = $('.search'); n.focus(); n.setSelectionRange(pos,pos); }
  if(el.dataset.act==='dsearch'){ S.dq = el.value; const pos = el.selectionStart; renderData(); const n = $('.search'); n.focus(); n.setSelectionRange(pos,pos); }
});
function findApp(id){ return S.apps.find(a=>a.id===id) || S.mineApps.find(a=>a.id===id); }

function runUpload(){
  if(S.uploaded || S.uploadStage) return;
  S.uploadStage = 1; renderData();
  setTimeout(()=>{ S.uploadStage = 2; renderData(); }, 900);
  setTimeout(()=>{ S.uploadStage = 3; renderData(); }, 1800);
  setTimeout(()=>{
    S.jobs.push({...DATA.upload}); DATA.upApps.forEach(a => S.apps.push({...a}));
    S.uploaded = true; S.uploadStage = 0; S.dsel = DATA.upload.id; S.dfilter = 'all'; renderData();
    toast('Added: Landscape Crew Member. Requirements are waiting for a spot-check.');
  }, 2700);
}

// demo hooks for testing
window.PORTAL = {S, fit, DATA};
render();
</script>
</body>
</html>
