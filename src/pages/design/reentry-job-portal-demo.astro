/* ---------- fit: the same function powers the applicant's fit check and the employer's ranking ---------- */
function fit(j, sk){
  let rt=0, rm=0, pt=0, pm=0, num=0, den=0; const items=[];
  for(const [id,lvl,note] of j.reqs){
    const v = sk[id]; let st;
    if(lvl==='H') st = v==='have' ? 'have' : 'after';
    else st = v==='have' ? 'have' : v==='get' ? 'get' : 'gap';
    items.push({id,lvl,note,st});
    if(lvl==='R'){ rt++; if(st==='have') rm++; den+=2; num += st==='have'?2 : st==='get'?1 : 0; }
    if(lvl==='P'){ pt++; if(st==='have') pm++; den+=1; num += st==='have'?1 : st==='get'?.5 : 0; }
  }
  const score = den ? Math.round(100*num/den) : 100;
  const gaps = rt - rm;
  return {items, rt, rm, pt, pm, score, gaps, ready: gaps===0 ? 'ready' : gaps===1 ? 'close' : 'train'};
}
const READY = {ready:['Ready now','ok'], close:['1 requirement to go','warn'], train:['Needs training','bad']};
const lvlName = l => l==='R' ? 'Required' : l==='P' ? 'Preferred' : 'Earn after hire';
