---
import Page from '../../layouts/Page.astro';
---

<Page
  title="Whole Life Experiment"
  description="An interactive Whole Life Matrix — select the life drivers that matter, colour how they're going, connect what drives what, and take the map with you."
  noindex={true}
>

<section class="wlm">
  <div class="wlm-wide">

    <a href="/design" class="wlm-back">&larr; Design</a>

    <!-- ===== Poster header ===== -->
    <header class="wlm-head">
      <div class="wlm-title-wrap">
        <svg class="wlm-mark" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="18" fill="none" stroke="#2E7D5B" stroke-width="2.4"/>
          <circle cx="20" cy="20" r="12" fill="none" stroke="#B5651D" stroke-width="2.4"/>
          <circle cx="20" cy="20" r="6" fill="none" stroke="#5B4A9E" stroke-width="2.4"/>
          <circle cx="20" cy="20" r="1.8" fill="#2B2B2B"/>
        </svg>
        <div>
          <h1 class="wlm-title">The Whole Life Matrix</h1>
          <p class="wlm-sub">A values &amp; priorities blueprint &mdash; 75 things that could matter; a handful that matter most right now.</p>
        </div>
      </div>
      <aside class="wlm-howto">
        <p class="wlm-howto-h">How to use this page</p>
        <ol>
          <li><b>Select</b> up to <b>10</b> drivers that matter most this season. Star up to <b>3</b> non-negotiables.</li>
          <li><b>Colour</b> each selection honestly: <i class="dot dot-green"></i>thriving <i class="dot dot-yellow"></i>needs attention <i class="dot dot-red"></i>neglected.</li>
          <li><b>Connect</b> &mdash; draw arrows where one driver feeds another. The busiest source is your <b>keystone</b>.</li>
          <li><b>Commit</b> &mdash; pick 1&ndash;3 drivers; write a 90-day intention and one weekly practice for each.</li>
        </ol>
      </aside>
    </header>

    <!-- ===== Mode bar ===== -->
    <div class="wlm-bar">
      <div class="wlm-modes" id="wlm-steps">
        <button class="wlm-mode is-active" data-step="1"><span>1</span>Select</button>
        <button class="wlm-mode" data-step="2"><span>2</span>Colour</button>
        <button class="wlm-mode" data-step="3"><span>3</span>Connect</button>
        <button class="wlm-mode" data-step="4"><span>4</span>Commit &darr;</button>
      </div>
      <p class="wlm-instruct" id="wlm-instruct"></p>
      <div class="wlm-bar-right">
        <span class="wlm-count" id="wlm-count"></span>
        <button class="wlm-reset" id="wlm-reset" type="button">Reset</button>
      </div>
    </div>
    <p class="wlm-scroll-hint">Scroll sideways to see the whole matrix.</p>

    <!-- ===== The board ===== -->
    <div class="wlm-scroll">
      <div class="wlm-board" id="wlm-board">
        <svg class="wlm-arrows" id="wlm-arrows" aria-hidden="true"></svg>
        <!-- header row -->
        <div class="wlm-corner">
          <span class="wlm-key"><i class="pin"></i>available</span>
          <span class="wlm-key"><i class="pin pin-on"></i>selected</span>
          <span class="wlm-key"><i class="pin pin-c"></i>coloured</span>
          <span class="wlm-key"><b class="wlm-star">&#9733;</b>non-negotiable</span>
        </div>
        <div id="wlm-cols" class="wlm-contents"></div>
        <div id="wlm-rows" class="wlm-contents"></div>
      </div>
    </div>
    <p class="wlm-foot">
      <b>It&rsquo;s a compass, not a scorecard.</b> No one tends all seventy-five. Every season of life deliberately
      neglects most of this matrix. The goal isn&rsquo;t balance &mdash; it&rsquo;s choosing your neglect on purpose.
    </p>
  </div>

  <!-- ===== Results ===== -->
  <div class="wlm-wide">
    <div id="wlm-results" class="wlm-results" hidden>

      <div class="wlm-two">
        <div class="wlm-panel">
          <h2 class="wlm-h2">Where your attention is</h2>
          <div id="wlm-attention" class="wlm-attn"></div>
        </div>
        <div class="wlm-panel">
          <h2 class="wlm-h2">Balance</h2>
          <p class="wlm-p wlm-p-tight">Where your selections fall. Clustered is honest; even is worth a second look.</p>
          <div id="wlm-heat" class="wlm-heat"></div>
        </div>
      </div>

      <div class="wlm-panel wlm-panel-ink">
        <h2 class="wlm-h2">Assessment</h2>
        <div class="wlm-assessment" id="wlm-assessment"></div>
        <p class="wlm-note">
          Written by Ron Dimon and Claude: the reasoning behind this read is encoded in the page, so it runs
          instantly and privately in your browser &mdash; nothing you mark here is ever sent anywhere.
        </p>
      </div>

      <div class="wlm-panel">
        <h2 class="wlm-h2">Commit</h2>
        <p class="wlm-p">
          Pick one to three drivers &mdash; usually the keystone plus one starred red. For each, a 90-day intention
          (a description of a state, not a number) and one weekly practice (the smallest repeatable act).
        </p>
        <div id="wlm-commit"></div>
      </div>

      <div class="wlm-actions">
        <button class="wlm-btn" id="wlm-pdf" type="button">Download map + assessment (PDF)</button>
        <span class="wlm-actions-note">Two pages, landscape. Keep it &mdash; re-colour the same sheet in 90 days and watch the colours migrate.</span>
        <button class="wlm-btn wlm-btn-out wlm-fb" id="wlm-fb" type="button">Send me feedback</button>
      </div>
    </div>

    <dialog id="wlm-fbd" class="wlm-dlg">
      <form id="wlm-fbf" class="wlm-dlg-form" novalidate>
        <h3>Send me feedback</h3>
        <p>What worked, what didn&rsquo;t, what you&rsquo;d change. It goes straight to Ron.</p>
        <label for="wlm-fb-email">Your email</label>
        <input id="wlm-fb-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        <label for="wlm-fb-comments">Comments</label>
        <textarea id="wlm-fb-comments" name="comments" rows="5" required placeholder="What would make this more useful?"></textarea>
        <div class="wlm-dlg-actions">
          <button type="button" class="wlm-btn wlm-btn-out" id="wlm-fb-cancel">Cancel</button>
          <button type="submit" class="wlm-btn">Send</button>
        </div>
        <p class="wlm-dlg-note" id="wlm-fb-note" aria-live="polite"></p>
      </form>
    </dialog>

    <div id="wlm-empty" class="wlm-empty">
      Select at least one driver above to begin. The assessment appears once you&rsquo;ve marked the matrix.
    </div>
  </div>
</section>

<style is:global>
  /* is:global — the board is built by JS at runtime, so Astro's scoped
     selectors would never match it. All rules are .wlm-prefixed. */
  /* ---------- paper ---------- */
  .wlm {
    --paper: #FBF7F1; --ink: #2B2B2B; --mut: #6B6560; --rule: #D9D2C7;
    --arrow: #2563EB;
    background: var(--paper); color: var(--ink);
    padding: 2.5rem 0 4rem;
  }
  .wlm-wide { max-width: 1560px; margin-inline: auto; padding-inline: 1.5rem; }
  .wlm-back { font-size: .8rem; color: var(--mut); text-decoration: none; }
  .wlm-back:hover { color: var(--ink); }

  /* ---------- header ---------- */
  .wlm-head { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 3rem; align-items: start; margin-top: 1rem; }
  .wlm-title-wrap { display: flex; gap: 1rem; align-items: flex-start; }
  .wlm-mark { width: 52px; height: 52px; flex: none; margin-top: .35rem; }
  .wlm-title { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.05; margin: 0; letter-spacing: -.01em; }
  .wlm-sub { font-family: var(--font-heading); font-style: italic; font-size: 1.05rem; color: var(--mut); margin: .5rem 0 0; }
  .wlm-howto { border-left: 2px solid var(--ink); padding-left: 1rem; max-width: 520px; font-size: .8rem; line-height: 1.55; }
  .wlm-howto-h { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .35rem; }
  .wlm-howto ol { margin: 0; padding-left: 1.2rem; }
  .wlm-howto li { margin: .1rem 0; color: var(--ink); }
  .wlm-howto li::marker { color: var(--mut); font-family: var(--font-heading); }
  .dot { width: .58rem; height: .58rem; border-radius: 999px; display: inline-block; vertical-align: -1px; margin: 0 .2rem 0 .35rem; }
  .dot-green { background: #16A34A; } .dot-yellow { background: #CA8A04; } .dot-red { background: #DC2626; }

  /* ---------- mode bar ---------- */
  .wlm-bar {
    margin-top: 1.75rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    padding: .6rem .85rem; background: #fff; border: 1px solid var(--rule); border-radius: .75rem;
  }
  .wlm-modes { display: flex; gap: .35rem; }
  .wlm-mode {
    display: inline-flex; align-items: center; gap: .45rem; font: inherit; font-size: .82rem; font-weight: 600;
    padding: .4rem .8rem .4rem .45rem; border-radius: 999px; border: 1px solid var(--rule); background: #fff; color: var(--ink); cursor: pointer;
  }
  .wlm-mode span {
    width: 1.3rem; height: 1.3rem; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--paper); font-size: .7rem; font-family: var(--font-heading);
  }
  .wlm-mode:hover { border-color: var(--ink); }
  .wlm-mode.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .wlm-mode.is-active span { background: rgba(255,255,255,.18); }
  .wlm-instruct { flex: 1 1 320px; font-size: .82rem; color: var(--mut); margin: 0; line-height: 1.45; }
  .wlm-bar-right { display: flex; align-items: center; gap: .9rem; margin-left: auto; }
  .wlm-count { font-size: .78rem; font-weight: 600; color: var(--mut); white-space: nowrap; }
  .wlm-count.is-full { color: #B5651D; }
  .wlm-reset { font: inherit; font-size: .78rem; color: var(--mut); background: none; border: none; cursor: pointer; text-decoration: underline; text-decoration-color: var(--rule); }
  .wlm-reset:hover { color: var(--ink); }
  .wlm-scroll-hint { display: none; font-size: .72rem; color: var(--mut); margin: .5rem 0 0; }

  /* ---------- board ---------- */
  .wlm-scroll { overflow-x: auto; margin-top: 1.25rem; padding-bottom: .5rem; }
  .wlm-board {
    position: relative; min-width: 1120px;
    display: grid; grid-template-columns: 172px repeat(5, minmax(0, 1fr));
    column-gap: 18px; row-gap: 14px;
  }
  .wlm-contents { display: contents; }
  .wlm-arrows { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible; }

  .wlm-corner { display: flex; flex-direction: column; gap: .25rem; justify-content: flex-end; padding-bottom: .5rem; }
  .wlm-key { display: inline-flex; align-items: center; gap: .4rem; font-size: .66rem; color: var(--mut); }
  .wlm-key .pin { --lc: var(--mut); }
  .wlm-key .pin-c { background: #16A34A; border-color: #16A34A; }

  .wlm-colh { align-self: end; padding-bottom: .5rem; border-bottom: 2px solid var(--ink); }
  .wlm-colh b { font-size: .95rem; font-weight: 700; letter-spacing: -.005em; }

  .wlm-row { display: contents; }
  .wlm-row[data-layer="self"]      { --lc: #5B4A9E; --lb: #ECE8F5; }
  .wlm-row[data-layer="family"]    { --lc: #B5651D; --lb: #F8ECDD; }
  .wlm-row[data-layer="community"] { --lc: #2E7D5B; --lb: #E4F0E8; }

  .wlm-label { background: var(--lb); border-radius: 12px; padding: 1rem .9rem; }
  .wlm-badge { display: inline-flex; align-items: center; gap: .4rem; font-size: .62rem; font-weight: 700; letter-spacing: .14em; color: var(--lc); }
  .wlm-badge i { width: 1.15rem; height: 1.15rem; border-radius: 999px; border: 2px solid var(--lc); position: relative; }
  .wlm-badge i::after { content: ''; position: absolute; inset: 4px; border-radius: 999px; background: var(--lc); }
  .wlm-lname { font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem; line-height: 1.15; color: var(--lc); margin: .55rem 0 .4rem; }
  .wlm-lblurb { font-size: .72rem; line-height: 1.4; color: var(--mut); }

  .wlm-cell { display: flex; flex-direction: column; gap: 3px; min-width: 0; padding-top: .15rem; }

  /* a driver at its intersection */
  .wlm-chip {
    position: relative; display: grid; grid-template-columns: 14px 1fr auto; gap: 8px; align-items: start;
    width: 100%; text-align: left; padding: 6px 8px 6px 7px; border-radius: 9px;
    background: transparent; border: 1px solid transparent; cursor: pointer; font: inherit; color: var(--ink);
    transition: background .12s, border-color .12s, box-shadow .12s, opacity .12s;
  }
  .wlm-chip:hover { background: rgba(255,255,255,.7); border-color: var(--rule); }
  .pin {
    width: 14px; height: 14px; border-radius: 999px; margin-top: 2px;
    border: 2px solid var(--lc); background: transparent; box-sizing: border-box; flex: none; transition: all .12s;
  }
  .pin-on, .is-on .pin { background: var(--lc); box-shadow: 0 0 0 3px color-mix(in srgb, var(--lc) 22%, transparent); }
  .wlm-nm { display: block; font-size: .8rem; font-weight: 600; line-height: 1.25; }
  .wlm-ds { display: block; font-size: .67rem; line-height: 1.3; color: var(--mut); margin-top: 1px; font-weight: 400; }
  .wlm-mk { display: flex; align-items: center; gap: .25rem; min-height: 1rem; }
  .wlm-star { color: #B5651D; font-size: .8rem; line-height: 1; }

  .is-on { background: #fff; border-color: color-mix(in srgb, var(--lc) 55%, transparent); box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .c-green { background: #F0FDF4; border-color: #86EFAC; }  .c-green .pin { background: #16A34A; border-color: #16A34A; box-shadow: 0 0 0 3px rgba(22,163,74,.2); }
  .c-yellow { background: #FEFCE8; border-color: #FDE047; } .c-yellow .pin { background: #CA8A04; border-color: #CA8A04; box-shadow: 0 0 0 3px rgba(202,138,4,.2); }
  .c-red { background: #FEF2F2; border-color: #FCA5A5; }    .c-red .pin { background: #DC2626; border-color: #DC2626; box-shadow: 0 0 0 3px rgba(220,38,38,.2); }
  .is-dim { opacity: .32; }
  .is-src { outline: 2px solid var(--arrow); outline-offset: 1px; }

  /* colour-mode controls */
  .wlm-ctl { display: flex; gap: .22rem; align-items: center; }
  .wlm-ctl button { width: 1rem; height: 1rem; border-radius: 999px; border: 1px solid rgba(0,0,0,.18); padding: 0; cursor: pointer; line-height: 0; }
  .wlm-ctl .sw-green { background: #16A34A; } .wlm-ctl .sw-yellow { background: #CA8A04; } .wlm-ctl .sw-red { background: #DC2626; }
  .wlm-ctl button[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .wlm-ctl .sw-star { width: auto; padding: 0 .3rem; border-radius: .3rem; background: #fff; color: #B5651D; font-size: .7rem; line-height: 1; }
  .wlm-ctl .sw-star.on { background: #F8ECDD; border-color: #B5651D; }

  .wlm-foot { margin: 1.25rem 0 0; font-size: .85rem; color: var(--mut); max-width: 62rem; line-height: 1.55; }
  .wlm-foot b { color: var(--ink); }

  /* ---------- results ---------- */
  .wlm-results { display: grid; gap: 1.1rem; margin-top: 2.5rem; }
  .wlm-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .wlm-panel { background: #fff; border: 1px solid var(--rule); border-radius: .9rem; padding: 1.4rem 1.5rem; }
  .wlm-panel-ink { background: var(--ink); color: #fff; border-color: var(--ink); }
  .wlm-panel-ink .wlm-h2 { color: #fff; }
  .wlm-h2 { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; margin: 0 0 .8rem; }
  .wlm-p { font-size: .88rem; color: var(--mut); margin: 0 0 1rem; line-height: 1.6; }
  .wlm-p-tight { margin-bottom: .75rem; }
  .wlm-assessment { font-size: 1rem; line-height: 1.75; }
  .wlm-assessment strong { color: #FDE68A; font-weight: 700; }
  .wlm-assessment p + p { margin-top: .85rem; }
  .wlm-note { font-size: .72rem; color: rgba(255,255,255,.6); margin: 1rem 0 0; line-height: 1.5; }

  .wlm-attn { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; }
  .wlm-attn-col h3 { font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .45rem; padding-bottom: .3rem; border-bottom: 2px solid; }
  .wlm-attn-col.now h3 { color: #DC2626; border-color: #DC2626; }
  .wlm-attn-col.grow h3 { color: #CA8A04; border-color: #CA8A04; }
  .wlm-attn-col.hold h3 { color: #16A34A; border-color: #16A34A; }
  .wlm-attn-col ul { list-style: none; margin: 0; padding: 0; }
  .wlm-attn-col li { font-size: .8rem; line-height: 1.35; padding: .18rem 0; }
  .wlm-attn-col li small { display: block; font-size: .66rem; color: var(--mut); }
  .wlm-attn-col .none { font-size: .74rem; color: var(--mut); font-style: italic; }
  .wlm-keystone { grid-column: 1 / -1; margin-top: .4rem; padding: .6rem .8rem; background: var(--paper); border-radius: .6rem; font-size: .82rem; }
  .wlm-keystone b { color: var(--arrow); }

  .wlm-heat { display: grid; grid-template-columns: 96px repeat(5, 1fr) 36px; gap: 4px; font-size: .68rem; align-items: stretch; }
  .wlm-heat .h { color: var(--mut); text-align: center; padding-bottom: 2px; align-self: end; line-height: 1.1; }
  .wlm-heat .r { color: var(--mut); display: flex; align-items: center; }
  .wlm-heat .t { color: var(--ink); font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .wlm-heat .c { height: 34px; border-radius: 6px; display: flex; align-items: center; justify-content: center; gap: 4px; font-weight: 700; color: var(--ink); background: var(--paper); border: 1px solid var(--rule); }
  .wlm-heat .c i { width: 7px; height: 7px; border-radius: 999px; display: inline-block; }
  .wlm-heat-read { margin: .7rem 0 0; font-size: .8rem; color: var(--mut); line-height: 1.5; }

  .wlm-commit-row { border-top: 1px solid var(--rule); padding-top: 1rem; margin-top: 1rem; }
  .wlm-commit-row:first-child { border-top: none; padding-top: 0; margin-top: 0; }
  .wlm-commit-name { font-weight: 600; font-size: .9rem; display: flex; align-items: center; gap: .4rem; }
  .wlm-commit-row label { display: block; font-size: .7rem; color: var(--mut); margin: .6rem 0 .2rem; font-weight: 600; }
  .wlm-commit-row input { width: 100%; font: inherit; font-size: .85rem; padding: .5rem .65rem; border: 1px solid var(--rule); border-radius: .45rem; background: #fff; color: var(--ink); }
  .wlm-commit-row input:focus { outline: 2px solid var(--ink); outline-offset: -1px; }

  .wlm-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .wlm-btn { font: inherit; font-size: .9rem; font-weight: 600; background: var(--ink); color: #fff; border: none; padding: .75rem 1.4rem; border-radius: .55rem; cursor: pointer; }
  .wlm-btn:hover { background: #000; }
  .wlm-actions-note { font-size: .75rem; color: var(--mut); max-width: 30rem; line-height: 1.5; }
  .wlm-empty { margin-top: 2rem; text-align: center; font-size: .88rem; color: var(--mut); border: 1px dashed var(--rule); border-radius: .9rem; padding: 1.6rem; }

  /* ---------- feedback ---------- */
  .wlm-actions .wlm-fb { margin-left: auto; }
  .wlm-btn-out { background: #fff; color: var(--ink); border: 1px solid var(--ink); }
  .wlm-btn-out:hover { background: var(--paper); }
  .wlm-dlg { border: none; border-radius: .9rem; padding: 0; width: min(92vw, 460px); box-shadow: 0 20px 60px rgba(0,0,0,.25); color: var(--ink); }
  .wlm-dlg::backdrop { background: rgba(43,43,43,.45); }
  .wlm-dlg-form { padding: 1.5rem; }
  .wlm-dlg-form h3 { font-family: var(--font-heading); font-size: 1.25rem; margin: 0 0 .3rem; }
  .wlm-dlg-form p { font-size: .85rem; color: var(--mut); margin: 0 0 .6rem; line-height: 1.5; }
  .wlm-dlg-form label { display: block; font-size: .72rem; font-weight: 600; color: var(--mut); margin: .8rem 0 .25rem; }
  .wlm-dlg-form input, .wlm-dlg-form textarea { width: 100%; font: inherit; font-size: .9rem; padding: .55rem .7rem; border: 1px solid var(--rule); border-radius: .45rem; background: #fff; color: var(--ink); resize: vertical; }
  .wlm-dlg-form input:focus, .wlm-dlg-form textarea:focus { outline: 2px solid var(--ink); outline-offset: -1px; }
  .wlm-dlg-actions { display: flex; gap: .6rem; justify-content: flex-end; margin-top: 1.1rem; }
  .wlm-dlg-note { min-height: 1.2em; margin: .8rem 0 0; font-size: .78rem; }

  /* ---------- responsive ---------- */
  @media (max-width: 1180px) {
    .wlm-scroll-hint { display: block; }
    .wlm-ds { display: none; }
    .wlm-board { min-width: 900px; grid-template-columns: 140px repeat(5, minmax(0, 1fr)); column-gap: 12px; }
  }
  @media (max-width: 900px) {
    .wlm-head { grid-template-columns: 1fr; }
    .wlm-two { grid-template-columns: 1fr; }
    .wlm-attn { grid-template-columns: 1fr; }
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script is:inline>
(function () {
  'use strict';

  /* ============ DATA: 5 domains x 3 layers x 5 drivers = 75 ============ */
  var DOMAINS = [
    { id: 'health',        name: 'Health & Vitality',          short: 'Health' },
    { id: 'wealth',        name: 'Wealth & Career',            short: 'Wealth' },
    { id: 'relationships', name: 'Relationships & Connection', short: 'Relationships' },
    { id: 'growth',        name: 'Growth & Mindset',           short: 'Growth' },
    { id: 'lifestyle',     name: 'Lifestyle & Environment',    short: 'Lifestyle' }
  ];
  var LAYERS = [
    { id: 'self',      n: 1, short: 'Self & Spirit',         blurb: 'Your inner world, personal responsibility, and connection to a Higher Power or your deepest values' },
    { id: 'family',    n: 2, short: 'Family & Inner Circle', blurb: 'Your partner, children, parents, and those you consider chosen family' },
    { id: 'community', n: 3, short: 'Community & World',     blurb: 'Your friends, colleagues, neighbours, local community, and the wider world' }
  ];
  var D = {
    'self-health': [['Body awareness & release','Tune into your signals; move to process stress'],['Nutritional choices','What you choose to feed and fuel yourself'],['Sleep hygiene','Routines that ensure deep, restorative rest'],['Preventative care','Own your checkups and your health data'],['Self-image','Your relationship with your body and appearance']],
    'self-wealth': [['Intrinsic motivation','A deep personal why behind your work'],['Skill mastery','Commitment to sharpening your talents'],['Financial psychology','Unlearn scarcity thinking and impulse spending'],['Autonomous savings','Build your personal safety net'],['Career alignment','Work that fits your gifts and personality']],
    'self-relationships': [['Relationship with self','Self-compassion, forgiveness, healthy solitude'],['Boundaries','What you will and will not tolerate'],['Emotional regulation','Manage your triggers before they project'],['Attachment style','Understand and heal the way you connect'],['Authenticity','Show up as your true self, without a mask']],
    'self-growth': [['Spiritual practice & intuition','Prayer, meditation, ritual; trusting inner guidance'],['Intellectual curiosity','Read and learn purely for yourself'],['Core values','Name the principles that guide your decisions'],['Ego awareness','Notice when pride or fear is driving'],['Mental resilience','Talk yourself through failure and hardship']],
    'self-lifestyle': [['Inner sanctuary','A private space that feels peaceful'],['Digital boundaries','Limits on screens, feeds, and noise'],['Daily rhythm','A morning or evening routine that anchors you'],['Personal aesthetic','Art, music, and objects that inspire you'],['Solitary leisure','Hobbies you enjoy entirely on your own']],
    'family-health': [['Shared nutrition','Cook healthy meals together; a nourishing kitchen'],['Family play','Active recreation together — hikes, sports, rides'],['Genetic awareness','Know your family history and inherited risks'],['Caregiving','Nurse loved ones with patience and empathy'],['Sleep alignment','Household rhythms so everyone rests well']],
    'family-wealth': [['Shared financial goals','Align on budget, purchases, and investments'],['Legacy planning','Wills, insurance, and generational wealth'],['Work-life harmony','Career boundaries so stress stays at work'],['Financial communication','Transparent, calm conversations about money'],["Dependents’ future",'Fund education; secure care for aging parents']],
    'family-relationships': [['Partner intimacy','Romantic, intellectual, and emotional closeness'],['Parental presence','Undistracted, quality time with children'],['Repair & psychological safety','Conflict ends in apology; feelings are safe'],['Traditions & rituals','Holidays, Sunday dinners, annual trips'],['Extended family ties','Healthy dynamics with in-laws and siblings']],
    'family-growth': [['Shared values','A unified family identity and mission'],['Co-learning','Read, discuss, and learn skills together'],['Spiritual harmony','Navigate faith and big questions as a unit'],['Emotional growth','Help each other through grief and transitions'],['Modeling behavior','Demonstrate maturity for the next generation']],
    'family-lifestyle': [['Home management','Fairly share chores, cooking, and upkeep'],['Comfort & order','A clean, welcoming, organised home'],['Family vacations','Travel that bonds and builds memories'],['Hospitality','Open your home to the people you love'],['Shared leisure','Movies, games, and hobbies everyone enjoys']],
    'community-health': [['Public health','Keep shared spaces safe, clean, accessible'],['Group fitness','Leagues, run clubs, and classes'],['Healthcare access','Support and advocate for local care'],['Wellness openness','Normalise honest mental-health conversations'],['Food security','Community gardens, local farms, food banks']],
    'community-wealth': [['Professional network','Mutually beneficial ties in your field'],['Local economy','Support the businesses in your community'],['Mentorship','Lift up juniors and newcomers'],['Philanthropy','Give to causes you believe in'],['Ethical work','Choices that do no harm to the public good']],
    'community-relationships': [['Deep friendships','A loyal, supportive circle beyond family'],['Neighborliness','A reliable, helpful presence next door'],['Belonging & inclusion','A third place; welcoming people unlike you'],['Civic engagement','Vote, show up, participate locally'],['Service','Give time freely to people in need']],
    'community-growth': [['Collective wisdom','Book clubs, lectures, and group discussion'],['Cultural enrichment','Support the arts, museums, libraries'],['Advocacy','Stand up for principles and needed change'],['Open dialogue','Engage different faiths and ideas with respect'],['Shared hope','Contribute to a culture of optimism']],
    'community-lifestyle': [['Environmental stewardship','Conserve, recycle, reduce your footprint'],['Public spaces','Enjoy and care for parks and trails'],['Group travel','New cultures with friends or groups'],['Community events','Markets, festivals, block parties'],['Workplace culture','A positive, inspiring shared environment']]
  };
  var DRIVERS = [], BY_ID = {};
  LAYERS.forEach(function (L) { DOMAINS.forEach(function (M) {
    (D[L.id + '-' + M.id] || []).forEach(function (row, i) {
      var d = { id: L.id + '-' + M.id + '-' + (i + 1), layer: L.id, domain: M.id, name: row[0], desc: row[1] };
      DRIVERS.push(d); BY_ID[d.id] = d;
    });
  }); });

  var MAX_CIRCLE = 10, MAX_STAR = 3;
  var LAYER_SHORT = {}, DOMAIN_SHORT = {}, LAYER_COLOR = { self: '#5B4A9E', family: '#B5651D', community: '#2E7D5B' };
  LAYERS.forEach(function (l) { LAYER_SHORT[l.id] = l.short; });
  DOMAINS.forEach(function (m) { DOMAIN_SHORT[m.id] = m.short; });

  /* ============ STATE ============ */
  var KEY = 'wlm.v1';
  var S = { step: 1, circled: [], starred: [], colors: {}, conns: [], commit: {}, src: null };
  function save() { try { localStorage.setItem(KEY, JSON.stringify({ step: S.step, circled: S.circled, starred: S.starred, colors: S.colors, conns: S.conns, commit: S.commit })); } catch (e) {} }
  function load() {
    try {
      var o = JSON.parse(localStorage.getItem(KEY) || 'null'); if (!o) return;
      S.step = Math.min(o.step || 1, 3);
      S.circled = (o.circled || []).filter(function (id) { return BY_ID[id]; });
      S.starred = (o.starred || []).filter(function (id) { return S.circled.indexOf(id) > -1; });
      S.colors = o.colors || {};
      S.conns = (o.conns || []).filter(function (c) { return S.circled.indexOf(c.from) > -1 && S.circled.indexOf(c.to) > -1; });
      S.commit = o.commit || {};
    } catch (e) {}
  }

  /* ============ DOM ============ */
  var $ = function (id) { return document.getElementById(id); };
  var $board = $('wlm-board'), $arrows = $('wlm-arrows'), $steps = $('wlm-steps'), $instruct = $('wlm-instruct'),
      $count = $('wlm-count'), $results = $('wlm-results'), $empty = $('wlm-empty'), $attn = $('wlm-attention'),
      $heat = $('wlm-heat'), $assess = $('wlm-assessment'), $commit = $('wlm-commit'), $pdf = $('wlm-pdf');

  var INSTRUCT = {
    1: 'Click a driver to select it — no more than ten. Star up to three non-negotiables. If everything matters, nothing does.',
    2: 'Be honest about each selection: click a swatch — green thriving, yellow slipping, red neglected. Most sheets have more red than green; red means honest, not failing.',
    3: 'Click a source driver, then the one it feeds, to draw an arrow. The driver with the most arrows leaving it is your keystone.',
    4: 'Read the assessment below, write your commitments, and take the PDF with you.'
  };

  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

  /* ============ BUILD BOARD ============ */
  function buildBoard() {
    $('wlm-cols').innerHTML = DOMAINS.map(function (m) { return '<div class="wlm-colh"><b>' + esc(m.name) + '</b></div>'; }).join('');
    $('wlm-rows').innerHTML = LAYERS.map(function (L) {
      var cells = DOMAINS.map(function (M) {
        return '<div class="wlm-cell">' + DRIVERS.filter(function (d) { return d.layer === L.id && d.domain === M.id; }).map(function (d) {
          return '<button type="button" class="wlm-chip" data-id="' + d.id + '"><i class="pin"></i>' +
            '<span><span class="wlm-nm">' + esc(d.name) + '</span><span class="wlm-ds">' + esc(d.desc) + '</span></span>' +
            '<span class="wlm-mk"></span></button>';
        }).join('') + '</div>';
      }).join('');
      return '<div class="wlm-row" data-layer="' + L.id + '"><div class="wlm-label">' +
        '<span class="wlm-badge"><i></i>LAYER ' + L.n + '</span>' +
