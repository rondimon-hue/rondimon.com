    }).join('');
  }

  /* ============ RENDER ============ */
  function render() {
    Array.prototype.forEach.call($steps.querySelectorAll('.wlm-mode'), function (b) { b.classList.toggle('is-active', +b.dataset.step === S.step); });
    if (Date.now() >= flashUntil) { $instruct.textContent = INSTRUCT[S.step]; $instruct.style.color = ''; }

    if (S.step === 1) { $count.textContent = S.circled.length + ' / ' + MAX_CIRCLE + ' selected · ' + S.starred.length + ' / ' + MAX_STAR + ' starred'; $count.classList.toggle('is-full', S.circled.length >= MAX_CIRCLE); }
    else if (S.step === 2) { var done = S.circled.filter(function (id) { return S.colors[id]; }).length; $count.textContent = done + ' / ' + S.circled.length + ' coloured'; $count.classList.remove('is-full'); }
    else if (S.step === 3) { $count.textContent = S.conns.length + ' connection' + (S.conns.length === 1 ? '' : 's'); $count.classList.remove('is-full'); }
    else { $count.textContent = ''; }

    Array.prototype.forEach.call($board.querySelectorAll('.wlm-chip'), function (el) {
      var id = el.dataset.id, on = S.circled.indexOf(id) > -1;
      el.className = 'wlm-chip' + (on ? ' is-on' : '');
      if (on && S.colors[id]) el.classList.add('c-' + S.colors[id]);
      if (S.step === 3) { if (!on) el.classList.add('is-dim'); if (S.src === id) el.classList.add('is-src'); }
      var mk = el.querySelector('.wlm-mk'); mk.innerHTML = '';
      if (on && S.step === 2) {
        var ctl = document.createElement('span'); ctl.className = 'wlm-ctl';
        ['green', 'yellow', 'red'].forEach(function (c) {
          var b = document.createElement('button'); b.type = 'button'; b.className = 'sw-' + c;
          b.dataset.color = c; b.dataset.for = id; b.setAttribute('aria-label', c);
          b.setAttribute('aria-pressed', S.colors[id] === c ? 'true' : 'false'); ctl.appendChild(b);
        });
        var st = document.createElement('button'); st.type = 'button'; st.dataset.star = id;
        st.className = 'sw-star' + (S.starred.indexOf(id) > -1 ? ' on' : ''); st.textContent = '★'; st.setAttribute('aria-label', 'star');
        ctl.appendChild(st); mk.appendChild(ctl);
      } else if (on && S.starred.indexOf(id) > -1) {
        mk.innerHTML = '<span class="wlm-star">★</span>';
      }
    });
    drawArrows(); renderResults(); save();
  }

  /* ============ ARROWS ============ */
  function drawArrows() {
    var box = $board.getBoundingClientRect();
    $arrows.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
    var svg = '<defs><marker id="wlm-ah" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 z" fill="#2563EB"/></marker></defs>';
    S.conns.forEach(function (c) {
      var a = $board.querySelector('[data-id="' + c.from + '"] .pin'), b = $board.querySelector('[data-id="' + c.to + '"] .pin');
      if (!a || !b) return;
      var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      var x1 = ra.left + ra.width / 2 - box.left, y1 = ra.top + ra.height / 2 - box.top;
      var x2 = rb.left + rb.width / 2 - box.left, y2 = rb.top + rb.height / 2 - box.top;
      var mx = (x1 + x2) / 2, my = (y1 + y2) / 2 - Math.min(80, Math.abs(x2 - x1) * .22 + 14);
      svg += '<path d="M' + x1 + ',' + y1 + ' Q' + mx + ',' + my + ' ' + x2 + ',' + y2 + '" fill="none" stroke="#2563EB" stroke-width="1.7" stroke-opacity=".6" marker-end="url(#wlm-ah)"/>';
    });
    $arrows.innerHTML = svg;
  }

  /* ============ SIGNALS ============ */
  function signals() {
    var circled = S.circled.map(function (id) { return BY_ID[id]; }), n = circled.length;
    var layerCounts = {}, domainCounts = {}, colorCounts = { green: 0, yellow: 0, red: 0, none: 0 };
    circled.forEach(function (d) { layerCounts[d.layer] = (layerCounts[d.layer] || 0) + 1; domainCounts[d.domain] = (domainCounts[d.domain] || 0) + 1; colorCounts[S.colors[d.id] || 'none']++; });
    var out = {}, inc = {};
    S.conns.forEach(function (c) { out[c.from] = (out[c.from] || 0) + 1; inc[c.to] = (inc[c.to] || 0) + 1; });
    var keystone = null, best = -1;
    S.circled.forEach(function (id) {
      var o = out[id] || 0; if (!o) return;
      var feedsRed = S.conns.filter(function (c) { return c.from === id && S.colors[c.to] === 'red'; }).length;
      var score = o * 10 + feedsRed * 3 + (S.colors[id] !== 'red' ? 1 : 0);
      if (score > best) { best = score; keystone = id; }
    });
    var upstream = S.circled.filter(function (id) {
      if (S.colors[id] === 'red' || !out[id]) return false;
      return S.conns.filter(function (c) { return c.from === id && S.colors[c.to] === 'red'; }).length >= 2;
    });
    var topLayer = null, topLayerN = 0; Object.keys(layerCounts).forEach(function (k) { if (layerCounts[k] > topLayerN) { topLayerN = layerCounts[k]; topLayer = k; } });
    var topDomain = null, topDomainN = 0; Object.keys(domainCounts).forEach(function (k) { if (domainCounts[k] > topDomainN) { topDomainN = domainCounts[k]; topDomain = k; } });
    return {
      n: n, circled: circled, layerCounts: layerCounts, domainCounts: domainCounts, colorCounts: colorCounts, out: out, inc: inc,
      keystone: keystone, upstream: upstream, topLayer: topLayer, topLayerN: topLayerN, topDomain: topDomain, topDomainN: topDomainN,
      layersTouched: Object.keys(layerCounts).length, domainsTouched: Object.keys(domainCounts).length,
      untouchedDomains: DOMAINS.filter(function (m) { return !domainCounts[m.id]; }),
      untouchedLayers: LAYERS.filter(function (l) { return !layerCounts[l.id]; }),
      starvedStars: S.starred.filter(function (id) { return S.colors[id] === 'red'; }),
      orphans: S.circled.filter(function (id) { return !out[id] && !inc[id]; })
    };
  }
  function listify(a) { return a.length < 2 ? (a[0] || '') : a.length === 2 ? a[0] + ' and ' + a[1] : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1]; }
  function nm(id) { return BY_ID[id] ? BY_ID[id].name : ''; }

  /* ============ ASSESSMENT ============ */
  function assessment(g) {
    if (!g.n) return '';
    var p1 = [], p2 = [], share = g.topLayerN / g.n;
    if (g.n < 4) {
      p1.push('You have selected ' + g.n + ', which is fewer than this exercise needs to show you anything structural — but what is here already points somewhere: ' + listify(g.circled.map(function (d) { return '**' + d.name + '**'; })) + '.');
    } else if (share >= 0.55) {
      p1.push('Your ' + g.n + ' selections cluster hard in **' + LAYER_SHORT[g.topLayer] + '** — ' + g.topLayerN + ' of ' + g.n + '. Read that as a season rather than an imbalance: one relational world is asking for most of you right now, and clustered selections are more honest than evenly spread ones.');
    } else if (g.domainsTouched === 5 && g.layersTouched === 3) {
      p1.push('Your ' + g.n + ' selections touch all five domains and all three layers. That even coverage is worth one hard look — people often spread their selections to look well-rounded rather than to be accurate. If the spread is real, good; if it is the balance trap, the sheet will not tell you anything you did not already want to hear.');
    } else {
      p1.push('Your ' + g.n + ' selections span ' + g.domainsTouched + ' of five domains across ' + g.layersTouched + ' of three layers — a partial, deliberate shape rather than an attempt at balance.');
    }
    if (g.untouchedDomains.length && g.untouchedDomains.length < 5) {
      p1.push('You left ' + listify(g.untouchedDomains.map(function (m) { return '**' + m.short + '**'; })) + ' unmarked entirely. That is your chosen neglect, and choosing it on purpose is the whole point — the goal was never balance.');
    }
    if (g.untouchedLayers.length === 1) {
      p1.push('Nothing at all in ' + LAYER_SHORT[g.untouchedLayers[0].id] + ', which is either a clean seasonal decision or a blind spot; only you know which.');
    }
    var cc = g.colorCounts;
    if (cc.none === 0 && g.n >= 4) {
      if (cc.red > cc.green) p2.push('More red than green on the sheet (' + cc.red + ' to ' + cc.green + ') — that usually means you marked it honestly, not that you are failing.');
      else if (cc.green >= g.n * 0.7) p2.push('Almost everything is green, which is either a genuinely good season or a sheet marked more generously than honestly — worth a second pass before you trust it.');
    }
    var keyIsUpstream = g.keystone && g.upstream.indexOf(g.keystone) > -1;
    if (g.keystone) {
      var o = g.out[g.keystone];
      var redsFed = S.conns.filter(function (c) { return c.from === g.keystone && S.colors[c.to] === 'red'; }).length;
      var line = 'The arrows make **' + nm(g.keystone) + '** your keystone: ' + o + ' connection' + (o === 1 ? '' : 's') + ' lead out of it, so it is the highest-leverage place to intervene.';
      if (keyIsUpstream) line += ' And it is marked ' + S.colors[g.keystone] + ' rather than red while feeding ' + redsFed + ' drivers that are red — which makes it the most useful thing on this sheet. Fix what is upstream, because it is starving what is below it.';
      else if (S.colors[g.keystone] && S.colors[g.keystone] !== 'red') line += ' Note that it is marked ' + S.colors[g.keystone] + ' rather than red — the best move is usually upstream of the pain rather than at it.';
      p2.push(line);
    } else if (S.conns.length === 0 && g.n >= 3) {
      p2.push('You have not drawn any connections yet, so no keystone has emerged — and the keystone is where the leverage hides. Go back to the Connect pass and look for the one driver that feeds the others.');
    }
    var otherUp = g.upstream.filter(function (id) { return id !== g.keystone; });
    if (otherUp.length) p2.push('**' + nm(otherUp[0]) + '** is also sitting upstream of trouble: not red itself, but feeding drivers that are.');
    if (g.starvedStars.length) {
      var many = g.starvedStars.length > 1, names = listify(g.starvedStars.map(function (id) { return '**' + nm(id) + '**'; }));
      p2.push(names + (many ? ' are starred and red: non-negotiables you are currently starving. Those matter most to you and they are going worst' : ' is starred and red: a non-negotiable you are currently starving. That matters most to you and it is going worst') + ' — of everything on the page, that intersection is the finding to act on.');
    } else if (S.starred.length && Object.keys(S.colors).length) {
      p2.push('None of your starred non-negotiables are red, which means the things you refuse to compromise are at least holding. Protect that.');
    }
    if (g.orphans.length >= 3 && S.conns.length > 0) p2.push(g.orphans.length + ' of your selections have no arrows at all — either they genuinely stand alone, or you have not yet found what they are connected to.');
    if (g.starvedStars.length) p2.push('The question to sit with: what would you have to put down, this month, to stop starving ' + nm(g.starvedStars[0]) + '?');
    else if (g.keystone) p2.push('The question to sit with: what is the smallest weekly act that would move ' + nm(g.keystone) + ' — and what are you already doing that works against it?');
    else p2.push('The question to sit with: of everything you selected, which one, if it improved, would quietly improve the others?');
    return md(p1.join(' ')) + (p2.length ? md(p2.join(' ')) : '');
  }
  function md(s) { return '<p>' + esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>') + '</p>'; }
  function plain(html) { var t = document.createElement('div'); t.innerHTML = html; return Array.prototype.map.call(t.querySelectorAll('p'), function (p) { return p.textContent; }); }

  /* ============ RESULTS ============ */
  function renderResults() {
    var g = signals(), has = g.n > 0;
    $results.hidden = !has; $empty.hidden = has;
    if (!has) return;

    // --- attention map: now / growing edge / holding ---
    var reds = S.circled.filter(function (id) { return S.colors[id] === 'red'; });
    var yels = S.circled.filter(function (id) { return S.colors[id] === 'yellow'; });
    var grns = S.circled.filter(function (id) { return S.colors[id] === 'green'; });
    var uncol = S.circled.filter(function (id) { return !S.colors[id]; });
    function col(cls, title, ids, empty) {
      ids = ids.slice().sort(function (a, b) { return (S.starred.indexOf(b) > -1) - (S.starred.indexOf(a) > -1); });
      return '<div class="wlm-attn-col ' + cls + '"><h3>' + title + '</h3>' + (ids.length ? '<ul>' + ids.map(function (id) {
        var d = BY_ID[id];
        return '<li>' + (S.starred.indexOf(id) > -1 ? '<span class="wlm-star">★</span> ' : '') + esc(d.name) +
          '<small>' + esc(LAYER_SHORT[d.layer]) + ' · ' + esc(DOMAIN_SHORT[d.domain]) + '</small></li>';
      }).join('') + '</ul>' : '<p class="none">' + empty + '</p>') + '</div>';
    }
    var attn = col('now', 'Needs attention now', reds, 'Nothing red — or not coloured yet.') +
      col('grow', 'Growing edge', yels, 'Nothing slipping yet.') +
      col('hold', 'Holding', grns, 'Nothing marked thriving yet.');
    if (uncol.length && Object.keys(S.colors).length) attn += '<p class="wlm-keystone">' + uncol.length + ' selected driver' + (uncol.length === 1 ? '' : 's') + ' still uncoloured.</p>';
    if (g.keystone) attn += '<p class="wlm-keystone">Keystone: <b>' + esc(nm(g.keystone)) + '</b> — ' + g.out[g.keystone] + ' arrow' + (g.out[g.keystone] === 1 ? '' : 's') + ' out. Move this and the rest tends to follow.</p>';
    $attn.innerHTML = attn;

    // --- balance heatmap ---
    var h = '<div></div>' + DOMAINS.map(function (m) { return '<div class="h">' + esc(m.short) + '</div>'; }).join('') + '<div class="h">all</div>';
    var colTot = {};
    LAYERS.forEach(function (L) {
      var rowTot = 0;
      h += '<div class="r">' + esc(L.short) + '</div>';
      DOMAINS.forEach(function (M) {
        var ids = S.circled.filter(function (id) { var d = BY_ID[id]; return d.layer === L.id && d.domain === M.id; });
        var k = ids.length; rowTot += k; colTot[M.id] = (colTot[M.id] || 0) + k;
        var worst = ids.some(function (id) { return S.colors[id] === 'red'; }) ? '#DC2626' : ids.some(function (id) { return S.colors[id] === 'yellow'; }) ? '#CA8A04' : ids.some(function (id) { return S.colors[id] === 'green'; }) ? '#16A34A' : null;
        var alpha = k ? (0.18 + k * 0.14) : 0;
        h += '<div class="c" style="' + (k ? 'background:color-mix(in srgb, ' + LAYER_COLOR[L.id] + ' ' + Math.round(alpha * 100) + '%, #fff);border-color:' + LAYER_COLOR[L.id] + '55;' : '') + '">' +
          (k ? k + (worst ? '<i style="background:' + worst + '"></i>' : '') : '<span style="color:#C9C2B6">·</span>') + '</div>';
      });
      h += '<div class="t">' + rowTot + '</div>';
    });
    h += '<div class="r">all</div>' + DOMAINS.map(function (m) { return '<div class="t">' + (colTot[m.id] || 0) + '</div>'; }).join('') + '<div class="t">' + g.n + '</div>';
    var read = g.topLayer ? 'Weighted toward <b>' + esc(LAYER_SHORT[g.topLayer]) + '</b>' + (g.topDomain ? ' and <b>' + esc(DOMAIN_SHORT[g.topDomain]) + '</b>' : '') : '';
    if (g.untouchedDomains.length && g.untouchedDomains.length < 5) read += '; nothing in ' + esc(listify(g.untouchedDomains.map(function (m) { return m.short; })));
    if (g.untouchedLayers.length) read += '; ' + esc(listify(g.untouchedLayers.map(function (l) { return l.short; }))) + ' untouched';
    $heat.innerHTML = h + (read ? '<p class="wlm-heat-read">' + read + '.</p>' : '');

    $assess.innerHTML = assessment(g);

    // --- commit rows: keystone, starred reds, other stars, then the rest (max 3) ---
    var pick = [];
    if (g.keystone) pick.push(g.keystone);
    g.starvedStars.concat(S.starred, S.circled).forEach(function (id) { if (pick.indexOf(id) < 0) pick.push(id); });
    pick = pick.slice(0, 3);
    $commit.innerHTML = pick.map(function (id) {
      var c = S.commit[id] || {};
      return '<div class="wlm-commit-row"><div class="wlm-commit-name">' + esc(nm(id)) +
        (S.starred.indexOf(id) > -1 ? ' <span class="wlm-star">★</span>' : '') + (S.colors[id] ? ' <i class="dot dot-' + S.colors[id] + '"></i>' : '') + '</div>' +
        '<label>90-day intention — what "better" looks like, as a state not a number</label>' +
        '<input type="text" data-commit="' + id + '" data-f="intent" value="' + esc(c.intent || '') + '" placeholder="Evenings where my phone is in a drawer and I am on the floor with the kids." />' +
        '<label>One weekly practice — the smallest repeatable act</label>' +
        '<input type="text" data-commit="' + id + '" data-f="practice" value="' + esc(c.practice || '') + '" placeholder="Phone in the drawer at 6pm, four nights a week." /></div>';
    }).join('');
  }

  /* ============ EVENTS ============ */
  var flashUntil = 0;
  function flash(msg) {
    flashUntil = Date.now() + 2600; $instruct.textContent = msg; $instruct.style.color = '#B5651D';
    setTimeout(function () { if (Date.now() >= flashUntil) { $instruct.textContent = INSTRUCT[S.step]; $instruct.style.color = ''; } }, 2700);
  }
  $steps.addEventListener('click', function (e) {
    var b = e.target.closest('.wlm-mode'); if (!b) return;
    S.step = +b.dataset.step; S.src = null; render();
    if (S.step === 4) (S.circled.length ? $results : $empty).scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  $board.addEventListener('click', function (e) {
    var sw = e.target.closest('[data-color]');
    if (sw) { e.stopPropagation(); var cid = sw.dataset.for; if (S.colors[cid] === sw.dataset.color) delete S.colors[cid]; else S.colors[cid] = sw.dataset.color; render(); return; }
    var st = e.target.closest('[data-star]');
    if (st) { e.stopPropagation(); toggleStar(st.dataset.star); render(); return; }
    var chip = e.target.closest('.wlm-chip'); if (!chip) return;
    var id = chip.dataset.id;
    if (S.step === 3) {
      if (S.circled.indexOf(id) < 0) return;
      if (S.src === null) S.src = id;
      else if (S.src === id) S.src = null;
      else {
        var i = S.conns.findIndex(function (c) { return c.from === S.src && c.to === id; });
        var j = S.conns.findIndex(function (c) { return c.from === id && c.to === S.src; });
        if (i > -1) S.conns.splice(i, 1); else if (j > -1) S.conns.splice(j, 1); else S.conns.push({ from: S.src, to: id });
        S.src = null;
      }
      render(); return;
    }
    if (S.step === 4) S.step = 1;
    var k = S.circled.indexOf(id);
    if (k > -1) {
      S.circled.splice(k, 1); var sk = S.starred.indexOf(id); if (sk > -1) S.starred.splice(sk, 1);
      delete S.colors[id]; delete S.commit[id];
      S.conns = S.conns.filter(function (c) { return c.from !== id && c.to !== id; });
    } else {
      if (S.circled.length >= MAX_CIRCLE) { flash('Ten is the cap. If everything matters, nothing does — take one off first.'); return; }
      S.circled.push(id);
    }
    render();
  });
  function toggleStar(id) {
    if (S.circled.indexOf(id) < 0) return;
    var k = S.starred.indexOf(id);
    if (k > -1) { S.starred.splice(k, 1); return; }
    if (S.starred.length >= MAX_STAR) { flash('Three stars maximum — those are the ones that survive any season.'); return; }
    S.starred.push(id);
  }
  $commit.addEventListener('input', function (e) {
    var el = e.target.closest('[data-commit]'); if (!el) return;
    S.commit[el.dataset.commit] = S.commit[el.dataset.commit] || {};
    S.commit[el.dataset.commit][el.dataset.f] = el.value; save();
  });
  $('wlm-reset').addEventListener('click', function () {
    if (!confirm('Clear the whole sheet and start again?')) return;
    S = { step: 1, circled: [], starred: [], colors: {}, conns: [], commit: {}, src: null };
    try { localStorage.removeItem(KEY); } catch (e) {} render();
  });
  var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(drawArrows, 120); });

  /* ============ PDF ============ */
  $pdf.addEventListener('click', function () {
    if (!window.jspdf || !window.jspdf.jsPDF) { alert('The PDF library did not load. Check your connection and reload the page.'); return; }
    var g = signals(), doc = new window.jspdf.jsPDF({ orientation: 'landscape', unit: 'pt', format: 'letter' });
    var W = 792, H = 612, M = 34;
    var RGB = { green: [22, 163, 74], yellow: [202, 138, 4], red: [220, 38, 38], none: [168, 162, 158] };
    var INK = [43, 43, 43], MUT = [107, 101, 96], ACC = [37, 99, 235], LINE = [217, 210, 199];
    var LC = { self: [91, 74, 158], family: [181, 101, 29], community: [46, 125, 91] };
    var LB = { self: [236, 232, 245], family: [248, 236, 221], community: [228, 240, 232] };

    doc.setFillColor(251, 247, 241); doc.rect(0, 0, W, H, 'F');
    doc.setFont('times', 'bold'); doc.setFontSize(20); doc.setTextColor.apply(doc, INK); doc.text('The Whole Life Matrix', M, M + 6);
    doc.setFont('times', 'italic'); doc.setFontSize(9.5); doc.setTextColor.apply(doc, MUT);
    doc.text('A values & priorities blueprint — 75 things that could matter; a handful that matter most right now.', M, M + 21);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
    doc.text(new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }), W - M, M + 6, { align: 'right' });
    doc.setFontSize(7.5); doc.text('rondimon.com/design/whole-life-experiment', W - M, M + 21, { align: 'right' });

    var gridTop = M + 46, rowLabelW = 86, gridH = H - gridTop - 66, colW = (W - 2 * M - rowLabelW) / 5, rowH = gridH / 3, pos = {};
    doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor.apply(doc, INK);
    DOMAINS.forEach(function (m, ci) {
      var x0 = M + rowLabelW + ci * colW;
      doc.text(m.short.toUpperCase(), x0 + (colW - 6) / 2, gridTop - 7, { align: 'center' });
      doc.setDrawColor.apply(doc, INK); doc.setLineWidth(1); doc.line(x0, gridTop - 3, x0 + colW - 6, gridTop - 3);
    });
    LAYERS.forEach(function (L, ri) {
      var y0 = gridTop + ri * rowH;
      doc.setFillColor.apply(doc, LB[L.id]); doc.roundedRect(M, y0, rowLabelW - 8, rowH - 8, 5, 5, 'F');
      doc.setFont('times', 'bold'); doc.setFontSize(9.5); doc.setTextColor.apply(doc, LC[L.id]);
      doc.text(doc.splitTextToSize(L.short, rowLabelW - 20), M + 6, y0 + 16);
      DOMAINS.forEach(function (Mo, ci) {
        var x0 = M + rowLabelW + ci * colW;
        var sel = S.circled.filter(function (id) { var d = BY_ID[id]; return d.layer === L.id && d.domain === Mo.id; });
        doc.setDrawColor.apply(doc, LINE); doc.setLineWidth(0.5);
        if (!sel.length) { doc.setFillColor(246, 242, 235); doc.rect(x0, y0, colW - 6, rowH - 8, 'FD'); }
        else { doc.setFillColor(255, 255, 255); doc.rect(x0, y0, colW - 6, rowH - 8, 'FD'); }
        var ty = y0 + 13;
        sel.forEach(function (id) {
          var c = S.colors[id] || 'none';
          if (c === 'none') { doc.setDrawColor.apply(doc, LC[L.id]); doc.setLineWidth(1.2); doc.circle(x0 + 8, ty - 2.4, 2.6, 'D'); }
          else { doc.setFillColor.apply(doc, RGB[c]); doc.circle(x0 + 8, ty - 2.4, 2.8, 'F'); }
          var starred = S.starred.indexOf(id) > -1;
          doc.setFont('helvetica', starred ? 'bold' : 'normal'); doc.setFontSize(7.2); doc.setTextColor.apply(doc, INK);
          var lines = doc.splitTextToSize((starred ? '* ' : '') + BY_ID[id].name, colW - 24);
          doc.text(lines, x0 + 14, ty); pos[id] = { x: x0 + 8, y: ty - 2.4 }; ty += lines.length * 8 + 3.5;
        });
      });
    });
    doc.setDrawColor.apply(doc, ACC); doc.setLineWidth(0.9);
    S.conns.forEach(function (c) {
      var a = pos[c.from], b = pos[c.to]; if (!a || !b) return;
      var ax = a.x, ay = a.y + 7, bx = b.x, by = b.y + 7;
      var dip = Math.min(52, 14 + Math.abs(bx - ax) * 0.12 + Math.abs(by - ay) * 0.10), cx = (ax + bx) / 2, cy = Math.max(ay, by) + dip;
      var px = ax, py = ay, lx = ax, ly = ay, N = 16;
      for (var i = 1; i <= N; i++) { var t = i / N, mt = 1 - t, qx = mt * mt * ax + 2 * mt * t * cx + t * t * bx, qy = mt * mt * ay + 2 * mt * t * cy + t * t * by; doc.line(px, py, qx, qy); lx = px; ly = py; px = qx; py = qy; }
      var ang = Math.atan2(py - ly, px - lx), L2 = 4.5;
      doc.line(px, py, px - L2 * Math.cos(ang - .42), py - L2 * Math.sin(ang - .42)); doc.line(px, py, px - L2 * Math.cos(ang + .42), py - L2 * Math.sin(ang + .42));
    });
    var ly2 = H - 44, lx = M; doc.setFont('helvetica', 'normal'); doc.setFontSize(7.5);
    [['green', 'Thriving'], ['yellow', 'Slipping'], ['red', 'Neglected']].forEach(function (p) { doc.setFillColor.apply(doc, RGB[p[0]]); doc.circle(lx + 3, ly2 - 2.4, 2.6, 'F'); doc.setTextColor.apply(doc, MUT); doc.text(p[1], lx + 9, ly2); lx += 62; });
    doc.setTextColor.apply(doc, MUT); doc.text('*  starred non-negotiable      arrow = drives / feeds      shaded cell = not this season', lx + 6, ly2);

    /* page 2 */
    doc.addPage('letter', 'landscape'); doc.setFillColor(251, 247, 241); doc.rect(0, 0, W, H, 'F');
    doc.setFont('times', 'bold'); doc.setFontSize(17); doc.setTextColor.apply(doc, INK); doc.text('Assessment', M, M + 6);
    var y = M + 30, colWidth = W - 2 * M;
    function room(need) { if (y + need > H - 46) { doc.addPage('letter', 'landscape'); doc.setFillColor(251, 247, 241); doc.rect(0, 0, W, H, 'F'); y = M + 10; } }
    var keys = [];
    if (g.keystone) keys.push(['Keystone', nm(g.keystone)]);
    if (g.starvedStars.length) keys.push(['Starved non-negotiable', listify(g.starvedStars.map(nm))]);
    if (g.topLayer) keys.push(['Heaviest layer', LAYER_SHORT[g.topLayer] + ' (' + g.topLayerN + ' of ' + g.n + ')']);
    if (g.untouchedDomains.length) keys.push(['Chosen neglect', listify(g.untouchedDomains.map(function (m) { return m.short; }))]);
    if (keys.length) {
      var kx = M, kw = colWidth / Math.min(keys.length, 4);
      keys.slice(0, 4).forEach(function (k) {
        doc.setDrawColor.apply(doc, ACC); doc.setLineWidth(1.8); doc.line(kx, y - 8, kx, y + 16);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(6.8); doc.setTextColor.apply(doc, MUT); doc.text(k[0].toUpperCase(), kx + 7, y - 1);
        doc.setFontSize(9); doc.setTextColor.apply(doc, INK); doc.text(doc.splitTextToSize(k[1], kw - 16), kx + 7, y + 11); kx += kw;
      });
      y += 40;
    }
    // attention lists
    var lists = [['NEEDS ATTENTION NOW', S.circled.filter(function (id) { return S.colors[id] === 'red'; }), RGB.red], ['GROWING EDGE', S.circled.filter(function (id) { return S.colors[id] === 'yellow'; }), RGB.yellow], ['HOLDING', S.circled.filter(function (id) { return S.colors[id] === 'green'; }), RGB.green]];
    if (lists.some(function (l) { return l[1].length; })) {
      var lw = colWidth / 3, startY = y, maxY = y;
      lists.forEach(function (l, i) {
        var x = M + i * lw, yy = startY;
        doc.setFont('helvetica', 'bold'); doc.setFontSize(6.8); doc.setTextColor.apply(doc, l[2]); doc.text(l[0], x, yy); yy += 11;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); doc.setTextColor.apply(doc, INK);
        l[1].forEach(function (id) { doc.text((S.starred.indexOf(id) > -1 ? '* ' : '') + nm(id), x, yy); yy += 11; });
        if (yy > maxY) maxY = yy;
      });
      y = maxY + 10;
    }
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor.apply(doc, INK);
    plain(assessment(g)).forEach(function (para) {
      var lines = doc.splitTextToSize(para, colWidth); room(lines.length * 14);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor.apply(doc, INK); doc.text(lines, M, y); y += lines.length * 14 + 10;
    });
    var cIds = Object.keys(S.commit).filter(function (id) { var c = S.commit[id]; return c && ((c.intent || '').trim() || (c.practice || '').trim()); });
    if (cIds.length) {
      y += 6; room(40); doc.setFont('times', 'bold'); doc.setFontSize(14); doc.setTextColor.apply(doc, INK); doc.text('Commitments', M, y); y += 18;
      cIds.forEach(function (id) {
        var c = S.commit[id]; room(48);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9.5); doc.setTextColor.apply(doc, ACC); doc.text((S.starred.indexOf(id) > -1 ? '* ' : '') + nm(id), M, y); y += 13;
        doc.setTextColor.apply(doc, INK); doc.setFontSize(9);
        if ((c.intent || '').trim()) { doc.setFont('helvetica', 'bold'); doc.text('90-day intention:', M + 10, y); doc.setFont('helvetica', 'normal'); var li = doc.splitTextToSize(c.intent, colWidth - 105); doc.text(li, M + 95, y); y += li.length * 12 + 2; }
        if ((c.practice || '').trim()) { doc.setFont('helvetica', 'bold'); doc.text('Weekly practice:', M + 10, y); doc.setFont('helvetica', 'normal'); var lp = doc.splitTextToSize(c.practice, colWidth - 105); doc.text(lp, M + 95, y); y += lp.length * 12 + 2; }
        y += 8;
      });
    }
    doc.setFont('times', 'italic'); doc.setFontSize(7.5); doc.setTextColor.apply(doc, MUT);
    doc.text('Re-colour this same sheet in 90 days and watch the colours migrate.  The Whole Life Matrix — Ron Dimon · rondimon.com.  Not therapy, financial or legal advice.', M, H - 26);
    doc.save('whole-life-matrix.pdf');
  });

  /* ============ FEEDBACK ============ */
  // Direct send needs a form endpoint (e.g. a free Formspree form: paste its URL below).
  // With no endpoint, the visitor's mail app opens with the message prefilled.
  var FEEDBACK_TO = 'ron@sparklabs.com';
  var FEEDBACK_ENDPOINT = '';
  var $fbd = $('wlm-fbd'), $fbf = $('wlm-fbf'), $fbn = $('wlm-fb-note');
  function fbOpen() { $fbn.textContent = ''; if ($fbd.showModal) $fbd.showModal(); else $fbd.setAttribute('open', ''); }
  function fbClose() { if ($fbd.close) $fbd.close(); else $fbd.removeAttribute('open'); }
  $('wlm-fb').addEventListener('click', fbOpen);
  $('wlm-fb-cancel').addEventListener('click', fbClose);
  $fbd.addEventListener('click', function (e) { if (e.target === $fbd) fbClose(); });
  $fbf.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = $fbf.elements.email.value.trim(), comments = $fbf.elements.comments.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { $fbn.textContent = 'Please enter a valid email address.'; $fbf.elements.email.focus(); return; }
    if (!comments) { $fbn.textContent = 'Please add a comment.'; $fbf.elements.comments.focus(); return; }
    var subject = 'Whole Life Experiment feedback';
    function viaMail() {
      var body = 'From: ' + email + '\n\n' + comments + '\n\n\u2014 sent from ' + location.href;
      window.location.href = 'mailto:' + FEEDBACK_TO + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      $fbn.textContent = 'Your mail app should open with the message ready to send.';
    }
    if (!FEEDBACK_ENDPOINT) { viaMail(); return; }
    $fbn.textContent = 'Sending\u2026';
    fetch(FEEDBACK_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ email: email, comments: comments, _subject: subject, page: location.href }) })
      .then(function (r) { if (!r.ok) throw new Error(r.status); $fbn.textContent = 'Sent \u2014 thank you.'; $fbf.reset(); setTimeout(fbClose, 1200); })
      .catch(function () { $fbn.textContent = 'That did not go through \u2014 opening your mail app instead.'; setTimeout(viaMail, 900); });
  });

  /* ============ GO ============ */
  load(); buildBoard(); render();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawArrows);
  window.addEventListener('load', drawArrows);
})();
</script>

