<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<title>Jedox Brand Idea — Ron Dimon</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,600&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy-dark: #16223c;
    --navy: #20355f;
    --purple: #4a2f6f;
    --pink: #ed1979;
    --white: #ffffff;
    --item-h: 1.3em;   /* height of one row in the scrolling lists */
    --rows: 5;         /* how many rows are visible at once */
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Open Sans', Arial, sans-serif;
    background: linear-gradient(160deg, var(--navy-dark) 0%, var(--navy) 45%, var(--purple) 100%);
    background-attachment: fixed;
    color: var(--white);
    min-height: 100vh;
    min-height: 100dvh;   /* dvh excludes mobile browser chrome; vh does not */
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  header {
    text-align: center;
    padding: 48px 24px 0;
  }
  .eyebrow {
    display: inline-block;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--pink);
    background: rgba(237, 25, 121, 0.12);
    border: 1px solid rgba(237, 25, 121, 0.4);
    border-radius: 999px;
    padding: 6px 18px;
    margin-bottom: 16px;
  }
  h1 {
    font-family: 'Baloo 2', 'Open Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.25;
    max-width: 720px;
    margin: 0 auto;
  }
  .subhead {
    max-width: 600px;
    margin: 16px auto 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
  }
  .subhead .highlight {
    color: var(--pink);
    font-weight: 600;
  }

  /* ---- The centered one-line equation ---- */
  main.hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px;
  }

  .equation {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;      /* centre row of each list lines up with the sentence */
    justify-content: center;
    white-space: nowrap;
    font-family: 'Baloo 2', 'Open Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 2.4vw, 2.2rem);
    line-height: var(--item-h);
  }

  /* Keeps "Enterprise Decisions on" and the X mark welded together so they
     can never be split across lines, whatever the screen width. */
  .mid {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .static-text { color: var(--white); }

  /* Scroll windows: several rows tall, faded top and bottom so the
     middle row reads as the "live" one while the rest glide past. */
  .scroll-window {
    display: block;
    overflow: hidden;
    height: calc(var(--item-h) * var(--rows));
    -webkit-mask-image: linear-gradient(to bottom,
      transparent 0%, rgba(0,0,0,0.35) 14%, #000 40%, #000 60%, rgba(0,0,0,0.35) 86%, transparent 100%);
    mask-image: linear-gradient(to bottom,
      transparent 0%, rgba(0,0,0,0.35) 14%, #000 40%, #000 60%, rgba(0,0,0,0.35) 86%, transparent 100%);
  }
  .scroll-track { display: block; }
  .scroll-track > span {
    display: flex;
    align-items: center;
    height: var(--item-h);
    line-height: var(--item-h);
    white-space: nowrap;
  }

  /* Each track holds the list twice, so translating up by exactly half
     its height lands back on an identical frame — a seamless loop. */
  @keyframes scrollList {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }

  /* J-word list — right-aligned so the gap before "Enterprise" never moves */
  .word-scroll { margin-right: 0.34em; }
  .word-scroll .scroll-track > span {
    color: var(--pink);
    justify-content: flex-end;
  }
  .word-scroll .scroll-track {
    animation: scrollList 33s linear infinite;   /* 11 items × 3s */
  }

  .x-mark {
    height: 0.92em;
    width: auto;
    margin-left: 0.3em;
    flex-shrink: 0;
  }

  /* X= list — same face, size and weight as the sentence, in white,
     but each row opens with the stylized pink X glyph instead of a letter X */
  .phrase-scroll { margin-left: 0.55em; }
  .phrase-scroll .scroll-track > span {
    color: var(--white);
    justify-content: flex-start;
  }
  .phrase-scroll .scroll-track > span::before {
    content: '';
    display: inline-block;
    align-self: baseline;
    flex-shrink: 0;
    height: 0.72em;
    width: 0.636em;          /* 0.72em x native aspect 0.883 */
    margin-right: 0.05em;
    background: url('/images/design/jedox-x-glyph-pink.png') no-repeat center / contain;
  }
  .phrase-scroll .scroll-track {
    animation: scrollList 45s linear infinite;   /* 15 items × 3s */
  }

  footer {
    text-align: center;
    padding: 24px 24px 32px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
  }
  footer a { color: var(--pink); text-decoration: none; }
  footer a:hover { text-decoration: underline; }

  /* ---- Phones ----
     The full sentence needs ~550px to stay readable, so below that it
     becomes a deliberate vertical composition, read top to bottom:
     rotating word / fixed sentence / rotating variable. */
  @media (max-width: 760px) {
    :root { --rows: 3; }

    header { padding: 32px 20px 0; }
    h1 { font-size: 1.3rem; }
    .subhead {
      font-size: 0.88rem;
      line-height: 1.6;
      margin-top: 14px;
    }
    main.hero { padding: 12px 16px 20px; }

    .equation {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: center;
      font-size: clamp(1.35rem, 6.2vw, 1.9rem);
      row-gap: 0.05em;
    }
    .word-scroll { margin-right: 0; }
    .word-scroll .scroll-track > span { justify-content: center; }
    .phrase-scroll { margin-left: 0; }
    .phrase-scroll .scroll-track > span { justify-content: center; }

    /* Scrollers are max-width so long entries never force a sideways scroll */
    .scroll-window { max-width: 100%; }
    footer { padding: 16px 20px 24px; font-size: 0.72rem; }
  }

  /* Short viewports — small phones and any phone held sideways.
     Trim vertical padding so the composition still fits without scrolling. */
  @media (max-height: 700px) {
    header { padding-top: 22px; }
    h1 { font-size: 1.2rem; }
    .subhead { margin-top: 10px; font-size: 0.82rem; }
    main.hero { padding-top: 4px; padding-bottom: 10px; }
    footer { padding: 10px 20px 16px; }
  }
  /* Very short (landscape phone): drop to 3 rows so nothing is cut off */
  @media (max-height: 560px) {
    :root { --rows: 3; }
    .subhead { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-track { animation: none !important; }
    .scroll-window {
      height: var(--item-h);
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
</head>
<body>

<header>
  <p class="eyebrow">Brand Concept</p>
  <h1>Jedox brand idea by Ron Dimon of sparklabs.studio</h1>
  <p class="subhead">
    Every enterprise decision is really a question about an unknown — X. This page turns that thought into a live brand device: a single sentence whose opening word and closing variable keep rotating, so the line can be read hundreds of ways. Watch it long enough and it tells you <span class="highlight">what Jedox actually stands for</span>.
  </p>
</header>

<main class="hero">
  <div class="equation">

    <span class="scroll-window word-scroll">
      <span class="scroll-track">
        <span>Jedox</span>
        <span>Judicious</span>
        <span>Joined-up</span>
        <span>Jedi</span>
        <span>Justified</span>
        <span>Journey-wide</span>
        <span>Just-in-time</span>
        <span>Joint</span>
        <span>Justifiable</span>
        <span>Judgment-led</span>
        <span>Just</span>
        <span aria-hidden="true">Jedox</span>
        <span aria-hidden="true">Judicious</span>
        <span aria-hidden="true">Joined-up</span>
        <span aria-hidden="true">Jedi</span>
        <span aria-hidden="true">Justified</span>
        <span aria-hidden="true">Journey-wide</span>
        <span aria-hidden="true">Just-in-time</span>
        <span aria-hidden="true">Joint</span>
        <span aria-hidden="true">Justifiable</span>
        <span aria-hidden="true">Judgment-led</span>
        <span aria-hidden="true">Just</span>
      </span>
    </span>

    <span class="mid">
      <span class="static-text">Enterprise Decisions on</span>
      <img class="x-mark" src="/images/design/jedox-x-mark-pink.png" alt="X." />
    </span>

    <span class="scroll-window phrase-scroll">
      <span class="scroll-track">
        <span>=Investments</span>
        <span>=Growth</span>
        <span>=Headwinds</span>
        <span>=Competition</span>
        <span>=Pricing</span>
        <span>=M&amp;A</span>
        <span>=Operational Efficiency</span>
        <span>=Profitability</span>
        <span>=Channels</span>
        <span>=Markets</span>
        <span>=Cash Cycle</span>
        <span>=Asset Utilization</span>
        <span>=ESG</span>
        <span>=Workforce</span>
        <span>=Revenue Ops</span>
        <span aria-hidden="true">=Investments</span>
        <span aria-hidden="true">=Growth</span>
        <span aria-hidden="true">=Headwinds</span>
        <span aria-hidden="true">=Competition</span>
        <span aria-hidden="true">=Pricing</span>
        <span aria-hidden="true">=M&amp;A</span>
        <span aria-hidden="true">=Operational Efficiency</span>
        <span aria-hidden="true">=Profitability</span>
        <span aria-hidden="true">=Channels</span>
        <span aria-hidden="true">=Markets</span>
        <span aria-hidden="true">=Cash Cycle</span>
        <span aria-hidden="true">=Asset Utilization</span>
        <span aria-hidden="true">=ESG</span>
        <span aria-hidden="true">=Workforce</span>
        <span aria-hidden="true">=Revenue Ops</span>
      </span>
    </span>

  </div>
</main>

<footer>
  <p>A brand concept by Ron Dimon &middot; <a href="https://sparklabs.studio" target="_blank" rel="noopener noreferrer">sparklabs.studio</a> &middot; not an official Jedox property</p>
</footer>

</body>
</html>
