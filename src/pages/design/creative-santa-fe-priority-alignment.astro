<style is:global>
/* Layout: single-column civic report with alignment matrix and expandable issue cards */
:root {
  --bg: #FAFAF7;
  --surface: #FFFFFF;
  --surface-alt: #F3F1EC;
  --fg: #1C1917;
  --fg-muted: #6B6560;
  --border: #E2DED6;
  --accent-state: #2563EB;
  --accent-county: #7C3AED;
  --accent-city: #0D9488;
  --accent-bridge: #C2410C;
  --aligned: #15803D;
  --partial: #CA8A04;
  --gap: #9CA3AF;
  --display: 'Source Serif 4', Georgia, serif;
  --body: 'Inter', system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #181614;
    --surface: #231F1C;
    --surface-alt: #2C2724;
    --fg: #EDE9E3;
    --fg-muted: #A09890;
    --border: #3D3632;
    --accent-state: #60A5FA;
    --accent-county: #A78BFA;
    --accent-city: #5EEAD4;
    --accent-bridge: #FB923C;
    --aligned: #4ADE80;
    --partial: #FACC15;
    --gap: #6B7280;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #181614;
  --surface: #231F1C;
  --surface-alt: #2C2724;
  --fg: #EDE9E3;
  --fg-muted: #A09890;
  --border: #3D3632;
  --accent-state: #60A5FA;
  --accent-county: #A78BFA;
  --accent-city: #5EEAD4;
  --accent-bridge: #FB923C;
  --aligned: #4ADE80;
  --partial: #FACC15;
  --gap: #6B7280;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--body);
  line-height: 1.6;
  padding-inline: 20px;
  padding-block: 0;
}
.wrap { max-width: 960px; margin: 0 auto; }

.back { display: inline-flex; align-items: center; gap: 6px; font-size: .85rem; color: var(--fg-muted); text-decoration: none; margin-top: 24px; }
.back:hover { color: var(--fg); }

h1 { font-family: var(--display); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.15; margin: 0; text-wrap: balance; }
h2 { font-family: var(--display); font-size: 1.35rem; font-weight: 600; line-height: 1.25; margin: 0; }
h3 { font-family: var(--body); font-size: 0.95rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; margin: 0; }

.header {
  padding-block: 20px 32px;
  border-bottom: 2px solid var(--border);
}
.header p { color: var(--fg-muted); font-size: 1.05rem; max-width: 680px; margin: 12px 0 0; }
.dateline { font-size: 0.8rem; color: var(--fg-muted); letter-spacing: 0.04em; text-transform: uppercase; font-weight: 600; margin-bottom: 8px; }

/* Headline-finding preamble */
.finding {
  margin-top: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 4px solid var(--accent-bridge);
  border-radius: 8px;
  padding: 18px 22px;
  max-width: 680px;
}
.finding p { margin: 0; color: var(--fg); font-size: 0.98rem; line-height: 1.6; }
.finding p + p { margin-top: 10px; }
.finding strong { color: var(--accent-bridge); }

/* Legend */
.legend {
  display: flex; flex-wrap: wrap; gap: 16px 28px;
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.85rem;
  color: var(--fg-muted);
}
.legend-item { display: flex; align-items: center; gap: 8px; }
.legend-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

/* Summary matrix */
.matrix-section { padding-block: 28px; }
.matrix-section > p { font-size: 0.95rem; color: var(--fg-muted); margin: 0 0 20px; }

.matrix {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
}
.matrix th {
  font-weight: 600;
  text-align: left;
  padding: 10px 12px;
  border-bottom: 2px solid var(--border);
  white-space: nowrap;
  font-size: 0.8rem;
  letter-spacing: 0.02em;
  color: var(--fg-muted);
}
.matrix th:first-child { padding-left: 0; }
.matrix td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
.matrix td:first-child {
  font-weight: 600;
  color: var(--fg);
  padding-left: 0;
  min-width: 0;
}
.matrix tr:last-child td { border-bottom: none; }
.matrix .dot-cell { text-align: center; }
.dot {
  display: inline-block;
  width: 20px;
  height: 20px;
  border-radius: 50%;
}
.dot.high { background: currentColor; }
.dot.med { background: currentColor; opacity: 0.45; }
.dot.low { background: transparent; border: 2px solid currentColor; opacity: 0.35; }
.dot.none { background: transparent; }
.state-col { color: var(--accent-state); }
.county-col { color: var(--accent-county); }
.city-col { color: var(--accent-city); }
.alignment-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 0.78rem; font-weight: 600; letter-spacing: 0.01em;
  padding: 3px 10px; border-radius: 20px;
  white-space: nowrap;
}
.alignment-badge.full { background: color-mix(in srgb, var(--aligned) 15%, transparent); color: var(--aligned); }
.alignment-badge.partial { background: color-mix(in srgb, var(--partial) 15%, transparent); color: var(--partial); }
.alignment-badge.limited { background: color-mix(in srgb, var(--gap) 15%, transparent); color: var(--gap); }

/* Issue cards */
.issues { display: flex; flex-direction: column; gap: 16px; padding-block: 8px 40px; }
.issue-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}
.issue-header {
  display: flex; align-items: center; gap: 14px;
  padding: 16px 20px;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}
.issue-header:hover { background: var(--surface-alt); }
.issue-rank {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.85rem; flex-shrink: 0;
}
.issue-rank.full { background: color-mix(in srgb, var(--aligned) 14%, transparent); color: var(--aligned); }
.issue-rank.partial { background: color-mix(in srgb, var(--partial) 14%, transparent); color: var(--partial); }
.issue-rank.limited { background: color-mix(in srgb, var(--gap) 14%, transparent); color: var(--gap); }
.issue-title-area { flex-grow: 1; min-width: 0; }
.issue-title-area h2 { font-size: 1.1rem; }
.issue-subtitle { font-size: 0.85rem; color: var(--fg-muted); margin-top: 2px; }
.chevron {
  flex-shrink: 0; width: 20px; height: 20px;
  transition: transform 0.2s ease;
  color: var(--fg-muted);
}
.issue-card.open .chevron { transform: rotate(180deg); }
.issue-body {
  display: none;
  padding: 0 20px 20px;
}
.issue-card.open .issue-body { display: block; }
.govt-columns {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
@media (max-width: 640px) {
  .govt-columns { grid-template-columns: 1fr; }
}
.govt-col {
  background: var(--surface-alt);
  border-radius: 8px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.govt-col h3 {
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  display: flex; align-items: center; gap: 6px;
}
.govt-col h3 .h-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.govt-col ul { margin: 0; padding-left: 18px; font-size: 0.88rem; line-height: 1.55; }
.govt-col li { margin-bottom: 4px; }
.govt-col .source { font-size: 0.75rem; color: var(--fg-muted); margin-top: auto; padding-top: 6px; }

.bridge-box {
  margin-top: 14px;
  border: 1.5px dashed var(--accent-bridge);
  border-radius: 8px;
  padding: 14px 16px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.bridge-icon { flex-shrink: 0; font-size: 1.1rem; margin-top: 2px; }
.bridge-text { font-size: 0.88rem; line-height: 1.5; }
.bridge-text strong { color: var(--accent-bridge); font-weight: 600; }

.footer {
  padding: 24px 0 48px;
  border-top: 1px solid var(--border);
  font-size: 0.8rem;
  color: var(--fg-muted);
  line-height: 1.6;
}
.footer a { color: var(--fg-muted); }

/* Matrix mobile */
@media (max-width: 640px) {
  .matrix { font-size: 0.78rem; }
  .matrix th, .matrix td { padding: 8px 6px; }
  .dot { width: 16px; height: 16px; }
  .alignment-badge { font-size: 0.7rem; padding: 2px 8px; }
  .issue-header { padding: 14px 16px; gap: 10px; }
  .issue-body { padding: 0 16px 16px; }
}
</style>

