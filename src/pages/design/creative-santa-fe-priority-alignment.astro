<h3 style="padding-top:8px;color:var(--fg-muted);font-size:0.8rem;letter-spacing:0.06em;margin-bottom:4px">Issue-by-Issue Detail</h3>
<p style="font-size:0.9rem;color:var(--fg-muted);margin:0 0 16px">Click any issue to see what each level of government is doing and where Creative Santa Fe can bridge.</p>

<div class="issues">
  <!-- 1. Housing -->
  <div class="issue-card open" id="housing">
    <div class="issue-header" onclick="toggle(this)">
      <div class="issue-rank full">1</div>
