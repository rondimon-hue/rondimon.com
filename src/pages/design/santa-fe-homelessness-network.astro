<style is:global>
/* Layout: header and filters on top, network canvas with a detail panel beside it, reading notes and sources below. */
:root{
  --bg:#F2F4F5; --surface:#FFFFFF; --ink:#1B2A33; --muted:#586872; --line:#C9D2D8; --soft:#E6EBEE; --focus:#0B5FA5;
  --coord:#0B5FA5; --gov:#6B5B95; --fund:#8F6F00; --shelter:#C2570C; --health:#138A5E; --needs:#2F82A8; --reentry:#B83A2E; --init:#A23B8C;
  --font:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif; --mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#12181C; --surface:#1B242A; --ink:#E6ECEF; --muted:#9AA9B2; --line:#33424B; --soft:#232F36; --focus:#7DB9EE;
  --coord:#5BA7E6; --gov:#A99BD6; --fund:#D4B84A; --shelter:#F0894A; --health:#4CC79A; --needs:#6EBBE0; --reentry:#F0786B; --init:#E07BC8; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12181C; --surface:#1B242A; --ink:#E6ECEF; --muted:#9AA9B2; --line:#33424B; --soft:#232F36; --focus:#7DB9EE;
  --coord:#5BA7E6; --gov:#A99BD6; --fund:#D4B84A; --shelter:#F0894A; --health:#4CC79A; --needs:#6EBBE0; --reentry:#F0786B; --init:#E07BC8; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.5;padding-inline:16px;padding-block:24px 48px}
.wrap{max-width:1320px;margin-inline:auto;display:flex;flex-direction:column;gap:20px}
h1{font-size:clamp(1.6rem,3.2vw,2.3rem);line-height:1.1;margin:0;font-weight:700;letter-spacing:-.02em;text-wrap:balance}
.sub{margin:6px 0 0;color:var(--muted);max-width:70ch}
.meta{font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:5px 12px 5px 10px;font:500 13px var(--font);cursor:pointer}
.chip i{width:10px;height:10px;border-radius:50%;background:var(--c)}
.chip[aria-pressed="false"]{opacity:.45}
.node:focus:not(:focus-visible){outline:none}
.chip:focus-visible,.node:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.main{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}
.stage{background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow-x:auto}
svg{display:block;min-width:900px;width:100%;height:auto}
.zone{fill:var(--c);fill-opacity:.07;stroke:var(--c);stroke-opacity:.35;stroke-width:1;stroke-dasharray:3 4}
.zlabel{font:600 12px var(--font);letter-spacing:.08em;text-transform:uppercase;fill:var(--c)}
.edge{stroke:var(--muted);stroke-opacity:.5;stroke-width:1}
.edge.ces{stroke:var(--coord);stroke-opacity:.8;stroke-width:2.2}
.edge.fund{stroke:var(--fund);stroke-opacity:.6;stroke-width:1.4}
.edge.plan{stroke:var(--init);stroke-opacity:.9;stroke-width:1.8;stroke-dasharray:6 5}
.node{cursor:pointer}
.node circle{fill:var(--c);stroke:var(--surface);stroke-width:2}
.node .ring{fill:none;stroke:var(--c);stroke-width:2;opacity:0}
.node.sel .ring{opacity:1}
.nlabel{font:500 13px var(--font);fill:var(--ink);paint-order:stroke;stroke:var(--surface);stroke-width:3.5px;stroke-linejoin:round;text-anchor:middle;pointer-events:none}
.hub .nlabel{font-weight:700;font-size:14px}
.dim{opacity:.1}
.edge.dim{opacity:.05}
.off{opacity:.12}
aside{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px;min-height:200px;position:sticky;top:12px}
aside h2{margin:0 0 4px;font-size:1.1rem;line-height:1.25}
.tag{display:inline-flex;align-items:center;gap:6px;font:600 11px var(--font);letter-spacing:.06em;text-transform:uppercase;color:var(--c)}
.tag i{width:8px;height:8px;border-radius:50%;background:var(--c)}
aside p{margin:10px 0}
aside h3{font:600 11px var(--font);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:16px 0 6px}
.rel{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:13.5px}
.rel button{all:unset;cursor:pointer;color:var(--focus);font-weight:600}
.rel button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.rel span{color:var(--muted)}
.srcs{margin:0;padding-left:0;list-style:none;font-size:13px;display:flex;flex-direction:column;gap:4px}
.srcs a{color:var(--focus)}
.srcs b{font-family:var(--mono);font-weight:500;color:var(--muted)}
.legend{display:flex;flex-wrap:wrap;gap:6px 22px;font-size:13px;color:var(--muted);align-items:center}
.legend svg{min-width:0;width:34px;height:10px;display:inline-block;vertical-align:middle;margin-right:6px}
.legend span{display:inline-flex;align-items:center}
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.note{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px}
.note h2{font-size:1rem;margin:0 0 6px;line-height:1.3}
.note p{margin:0;font-size:14px;color:var(--ink)}
.foot h2{font-size:1rem;margin:0 0 8px}
.foot ol{margin:0;padding-left:0;list-style:none;columns:2 340px;column-gap:28px;font-size:13.5px}
.foot li{break-inside:avoid;margin-bottom:6px}
.foot a{color:var(--focus)}
.foot .fine{color:var(--muted);font-size:13px;margin-top:12px;max-width:80ch}
@media (max-width:900px){.main{grid-template-columns:minmax(0,1fr)}aside{position:static}}
@media (prefers-reduced-motion:no-preference){.node circle,.edge,.node{transition:opacity .15s}}

.back{font-size:13px;color:var(--muted);text-decoration:none;align-self:flex-start}
.back:hover{color:var(--ink)}
</style>
</head>
