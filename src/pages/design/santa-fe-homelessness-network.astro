ol","b":"jail","type":"partner","src":[10],"label":"Reentry fair participant"},{"a":"dws","b":"jail","type":"partner","src":[10],"label":"Reentry fair participant"},{"a":"init","b":"nmrc","type":"plan","src":[16],"label":"Recommended top candidate for partnership or fiscal sponsorship"},{"a":"init","b":"city","type":"plan","src":[16],"label":"Placing job-seekers in open City jobs"},{"a":"init","b":"ncnmedd","type":"plan","src":[16],"label":"Researched as a partner option"},{"a":"init","b":"stelz","type":"plan","src":[16],"label":"Researched as relevant if the initiative extends to unhoused people"}],"srcs":{"1":{"t":"NMCEH home page","u":"https://www.nmceh.org"},"2":{"t":"NMCEH Continuum of Care and federal funding","u":"https://www.nmceh.org/cocfederalfunding"},"3":{"t":"NMCEH Coordinated Entry System","u":"https://www.nmceh.org/coordinated-entry-system"},"4":{"t":"City of Santa Fe: Get Involved, Community & Partnerships","u":"https://santafenm.gov/homelessness/santa-fe-homelessness-response-resources/get-involved-community-partnerships"},"5":{"t":"City of Santa Fe: Shelter/Emergency Housing","u":"https://santafenm.gov/affordable-housing/shelteremergency-housing"},"6":{"t":"S3 Santa Fe Housing Initiative: About Us","u":"https://s3santafe.org/about-us/"},"7":{"t":"Santa Fe Chamber of Commerce: Food, Shelter & Basic Needs","u":"https://www.santafechamber.com/food-shelter-basic-needs.html"},"8":{"t":"New Mexico Reentry Center","u":"https://nmreentrycenter.org"},"9":{"t":"The Life Link: Housing Support","u":"https://www.thelifelink.org/housing-support"},"10":{"t":"Santa Fe New Mexican: women's jail reentry program","u":"https://www.santafenewmexican.com/news/education/santa-fe-womens-jail-reentry-program-hopes-to-replicate-mens-program-success/article_511bbf5a-321f-4dd5-abc6-9a0a6f0cf8ac.html"},"11":{"t":"Second Chance Guide: NM reentry directory","u":"https://secondchanceguide.com/directory/new-mexico/"},"12":{"t":"NM State Library: resources for people who have experienced incarceration","u":"https://libguides.nmstatelibrary.org/c.php?g=1394566"},"13":{"t":"Santa Fe YouthWorks (SHARE NM listing)","u":"https://sharenm.org/organization/print/youthworks/santa-fe-youthworks"},"14":{"t":"NM WorkReady, America's Job Center","u":"https://directory.100nm.org/?p=1550"},"15":{"t":"Interfaith Community Services: The ROCk","u":"https://therocksantafe.org/about-ics/"},"16":{"t":"Your project notes (workforce placement initiative)","u":null}},"groups":{"coord":"Coordination","gov":"Government & housing authorities","fund":"Funders","shelter":"Shelter & housing providers","health":"Health & recovery","needs":"Basic needs","reentry":"Reentry & workforce","init":"Your initiative"},"zr":{"gov":[20,45,415,255],"coord":[450,45,365,255],"fund":[840,45,380,255],"shelter":[20,345,525,305],"health":[565,345,265,235],"reentry":[845,345,380,500],"needs":[20,672,820,150]}};
const NS = 'http://www.w3.org/2000/svg';
const byId = Object.fromEntries(D.nodes.map(n => [n.id, n]));
const gKeys = Object.keys(D.groups);
const state = { sel: null, hidden: new Set() };
const el = (t, a = {}, p) => { const e = document.createElementNS(NS, t); for (const k in a) e.setAttribute(k, a[k]); if (p) p.appendChild(e); return e; };
const svg = document.getElementById('net');

document.getElementById('meta').textContent = D.nodes.length + ' organizations · ' + D.edges.filter(e => e.type !== 'plan').length + ' documented links · ' + D.edges.filter(e => e.type === 'plan').length + ' from your notes';

// zones
const zg = el('g', {}, svg);
gKeys.forEach(k => {
  const r = D.zr[k]; if (!r) return;
  const g = el('g', { 'data-g': k, style: '--c:var(--' + k + ')' }, zg);
  el('rect', { class: 'zone', x: r[0], y: r[1], width: r[2], height: r[3], rx: 14 }, g);
  const t = el('text', { class: 'zlabel', x: r[0] + 12, y: r[1] + 18 }, g); t.textContent = D.groups[k];
});
// edges
const eg = el('g', {}, svg);
D.edges.forEach((e, i) => {
  const a = byId[e.a], b = byId[e.b];
  e.el = el('line', { class: 'edge ' + e.type, x1: a.x, y1: a.y, x2: b.x, y2: b.y }, eg);
});
// nodes
const ng = el('g', {}, svg);
function wrap(s, n) { const w = s.split(' '); const L = []; let c = ''; w.forEach(x => { if ((c + ' ' + x).trim().length > n && c) { L.push(c); c = x; } else c = (c + ' ' + x).trim(); }); if (c) L.push(c); return L; }
D.nodes.forEach(n => {
  const r = n.hub ? 13 : 8;
  const g = el('g', { class: 'node' + (n.hub ? ' hub' : ''), tabindex: 0, role: 'button', 'aria-label': n.label + ', ' + D.groups[n.group], style: '--c:var(--' + n.group + ')', transform: 'translate(' + n.x + ',' + n.y + ')' }, ng);
  el('circle', { class: 'ring', r: r + 5 }, g);
  el('circle', { r }, g);
  const side = n.id === 'init'; const t = el('text', side ? { class: 'nlabel', x: r + 12, y: 4, style: 'text-anchor:start' } : { class: 'nlabel', y: r + 14 }, g);
  wrap(n.label, n.hub ? 18 : 15).forEach((ln, i) => { const s = el('tspan', { x: side ? r + 12 : 0, dy: i ? 15 : 0 }, t); s.textContent = ln; });
  g.addEventListener('click', () => select(n.id));
  g.addEventListener('keydown', ev => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); select(n.id); } });
  n.el = g;
});

function links(id) { return D.edges.filter(e => e.a === id || e.b === id); }
function apply() {
  const sel = state.sel; const nb = new Set(); if (sel) { nb.add(sel); links(sel).forEach(e => { nb.add(e.a); nb.add(e.b); }); }
  D.nodes.forEach(n => {
    n.el.classList.toggle('sel', n.id === sel);
    n.el.classList.toggle('dim', !!sel && !nb.has(n.id));
    n.el.classList.toggle('off', state.hidden.has(n.group));
  });
  D.edges.forEach(e => {
    const inc = sel && (e.a === sel || e.b === sel);
    e.el.classList.toggle('dim', !!sel && !inc);
    e.el.classList.toggle('off', state.hidden.has(byId[e.a].group) || state.hidden.has(byId[e.b].group));
  });
  zg.querySelectorAll('[data-g]').forEach(g => g.classList.toggle('off', state.hidden.has(g.dataset.g)));
}
function srcLinks(ids) {
  return ids.map(i => { const s = D.srcs[i]; return '<li><b>[' + i + ']</b> ' + (s.u ? '<a href="' + s.u + '" target="_blank" rel="noopener">' + s.t + '</a>' : s.t) + '</li>'; }).join('');
}
function overview() {
  const nm = byId.nmrc, hubs = ['nmceh', 's3', 'city', 'nmrc'];
  document.getElementById('panel').innerHTML =
    '<h2>How to read this</h2><p>Each dot is an organization, grouped by what it does. Larger dots are hubs with many links. Select any dot to isolate its connections and see what the sources say about it.</p>' +
    '<h3>Start with</h3><ul class="rel">' + hubs.map(h => '<li><button data-go="' + h + '">' + byId[h].label + '</button></li>').join('') + '</ul>';
  bindGo();
}
function select(id) {
  state.sel = id; apply();
  const n = byId[id], L = links(id);
  const rel = L.map(e => { const o = byId[e.a === id ? e.b : e.a]; return '<li><button data-go="' + o.id + '">' + o.label + '</button><br><span>' + e.label + ' [' + e.src.join(', ') + ']</span></li>'; }).join('');
  document.getElementById('panel').innerHTML =
    '<span class="tag" style="--c:var(--' + n.group + ')"><i></i>' + D.groups[n.group] + '</span><h2>' + n.label + '</h2><p>' + n.desc + '</p>' +
    (L.length ? '<h3>Links (' + L.length + ')</h3><ul class="rel">' + rel + '</ul>' : '<h3>Links</h3><p>No link to another organization on this map is documented in the sources read.</p>') +
    '<h3>Sources</h3><ul class="srcs">' + srcLinks(n.src) + '</ul><p><button class="chip" id="clr" style="--c:var(--muted)">Clear selection</button></p>';
  bindGo(); document.getElementById('clr').onclick = () => { state.sel = null; apply(); overview(); };
}
function bindGo() { document.querySelectorAll('[data-go]').forEach(b => b.onclick = () => select(b.dataset.go)); }
svg.addEventListener('click', ev => { if (ev.target === svg) { state.sel = null; apply(); overview(); } });

// chips
const cw = document.getElementById('chips');
gKeys.forEach(k => {
  const c = document.createElement('button'); c.className = 'chip'; c.setAttribute('aria-pressed', 'true'); c.style.setProperty('--c', 'var(--' + k + ')');
  c.innerHTML = '<i></i>' + D.groups[k] + ' <span style="color:var(--muted)">' + D.nodes.filter(n => n.group === k).length + '</span>';
  c.onclick = () => { const on = c.getAttribute('aria-pressed') === 'true'; c.setAttribute('aria-pressed', String(!on)); on ? state.hidden.add(k) : state.hidden.delete(k); apply(); };
  cw.appendChild(c);
});

// reading notes
const notes = [
  ['Two networks, one documented bridge', 'The homelessness side (S3, coordinated entry, the City list) and the jail reentry side meet at one organization in the sources read: Santa Fe Recovery Center. It is an S3 partner and also took part in the jail reentry fair.'],
  ['NM Reentry Center sits outside the main lists', 'It provides transitional sober living and ID help for people leaving jail, yet it is not named on the City partner list, the coordinated entry access points, or the part of the S3 partner list I could read. Asking whether it should be a coordinated entry access point or S3 partner is a practical first conversation.'],
  ['Job training has no documented tie to the shelters', 'WorkReady, Goodwill Next Steps and Workforce Solutions show up on the reentry side only. Youth Shelters & Family Services has its own workforce initiative, and YouthWorks is on the City list. Your placement initiative links the City and the reentry network.'],
  ['Five front doors for housing', 'Coordinated entry assessments in Santa Fe happen at Pete\'s Place, Consuelo\'s Place, St. Elizabeth\'s, Youth Shelters & Family Services and The Life Link. Anyone referred from reentry programs for housing would be assessed at one of these.']
];
document.getElementById('notes').innerHTML = notes.map(n => '<div class="note"><h2>' + n[0] + '</h2><p>' + n[1] + '</p></div>').join('');
document.getElementById('srclist').innerHTML = Object.entries(D.srcs).map(([i, s]) => '<li><b style="font-family:var(--mono);color:var(--muted)">[' + i + ']</b> ' + (s.u ? '<a href="' + s.u + '" target="_blank" rel="noopener">' + s.t + '</a>' : s.t) + '</li>').join('');
overview(); apply();
</script>
</body>
</html>
