---
import Page from '../layouts/Page.astro';
import YouTube from '../components/YouTube.astro';
import { Picture } from 'astro:assets';
import connectedPlanningCover from '../assets/books/connected-planning-cover.jpg';
import epmDoneRightCover from '../assets/books/epm-done-right-cover.jpg';
import sgaBookletCover from '../assets/books/sga-booklet-cover.jpg';
import stewartJamesCover from '../assets/books/stewart-james-cover.jpg';
import microcomputersCover from '../assets/books/microcomputers-cover.jpg';
import bpmRevolutionCover from '../assets/books/bpm-revolution-cover.jpg';
import onTheUpAndUpCover from '../assets/books/on-the-up-and-up-cover.jpg';
import scorecardBestPracticesCover from '../assets/books/scorecard-best-practices-cover.jpg';
import retrogradeFieldManualCover from '../assets/books/retrograde-field-manual-cover.jpg';
import jedoxBeyondBudgeting from '../assets/media/jedox-beyond-budgeting.jpg';
import jedoxDisruptionToDirection from '../assets/media/jedox-disruption-to-direction.jpg';
import connectedPlanningWhiteboardPhoto from '../assets/speaking/connected-planning-whiteboard.jpg';
import anaplanConnectedPlanningTalkPhoto from '../assets/speaking/anaplan-connected-planning-talk.jpg';
import anaplanPanelPhoto from '../assets/speaking/anaplan-panel.jpg';
import supposeTalkPhoto from '../assets/speaking/suppose-talk.jpg';
---

<Page title="Books & Speaking" description="Books by Ron Dimon — Enterprise Performance Management Done Right, Connected Planning, and more — plus his talks, workshops, and keynotes on strategy, EPM, value selling, and business education.">

  <!-- Intro -->
  <section class="container pt-20 md:pt-28">
    <div class="max-w-3xl animate-in">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Books &amp; Speaking</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        Ideas on the page and on the stage
      </h1>
      <p class="mt-6 text-xl text-text-secondary">
        The books set out the frameworks. The talks and workshops put them to work with a live audience.
      </p>
      <nav class="mt-8 flex flex-wrap gap-3" aria-label="On this page">
        {[
          { href: '#books', label: 'Books I\u2019ve written' },
          { href: '#speaking', label: 'Speaking' },
          { href: '#contributions', label: 'Contributions' },
          { href: '#library', label: 'My library' },
        ].map(l => (
          <a href={l.href} class="inline-flex items-center px-4 py-2 bg-surface-alt text-sm text-text-secondary rounded-lg border border-border hover:border-accent hover:text-accent transition-colors">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Books I've written -->
  <section id="books" class="container py-16 md:py-20 scroll-mt-24">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-3">Books</p>
      <h2 class="text-3xl font-heading font-semibold text-text-primary">What I've written</h2>
    </div>

    <!-- Book 1: Connected Planning -->
    <div id="connected-planning" class="mt-10 grid md:grid-cols-[10rem_1fr] gap-6 md:gap-10 items-start scroll-mt-24">
      <div class="w-28 md:w-auto">
        <div class="image-frame bg-surface">
          <Picture
              src={connectedPlanningCover}
            alt="Connected Planning book cover"
            class="w-full"
              widths={[160, 320]}
              sizes="(min-width: 768px) 160px, 112px"
              formats={["avif", "webp"]}
              loading="lazy"
            />
        </div>
      </div>

      <div>
        <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-3">Published by Wiley</span>
        <h2 class="text-2xl font-heading font-bold text-text-primary">
          Connected Planning
        </h2>
        <p class="mt-2 text-text-muted text-sm">
          A Playbook for Agile Decision Making &bull; Second Edition
        </p>

        <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
          <p>
            The evolution of the EPM framework for the modern era. Connected Planning is about breaking down the silos between financial planning, operational planning, and strategic planning — and building an agile, integrated system that lets organizations make better decisions faster.
          </p>
          <p>
            The second edition reflects how planning has changed in the age of cloud platforms, real-time data, and AI. It's a practical playbook for CFOs, FP&A leaders, and anyone responsible for connecting strategy to execution across the enterprise.
          </p>
        </div>

        <div class="mt-8">
          <a
            href="https://www.amazon.com/dp/1119485800"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-text-primary text-surface text-sm font-medium rounded-lg hover:bg-accent transition-colors"
          >
            View on Amazon
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Book 2: EPM Done Right -->
    <div id="epm-done-right" class="mt-10 pt-10 border-t border-border-light grid md:grid-cols-[10rem_1fr] gap-6 md:gap-10 items-start scroll-mt-24">
      <div class="w-28 md:w-auto">
        <div class="image-frame bg-surface">
          <Picture
              src={epmDoneRightCover}
            alt="Enterprise Performance Management Done Right book cover"
            class="w-full"
              widths={[160, 320]}
              sizes="(min-width: 768px) 160px, 112px"
              formats={["avif", "webp"]}
              loading="lazy"
            />
        </div>
      </div>

      <div>
        <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-3">Published by Wiley</span>
        <h2 class="text-2xl font-heading font-bold text-text-primary">
          Enterprise Performance Management Done Right
        </h2>
        <p class="mt-2 text-text-muted text-sm">
          An Operating System for Your Organization
        </p>

        <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
          <p>
            The practitioner's guide to building a real, working performance management system — not just buying software and hoping for the best. It covers the full cycle: from gathering and understanding data, through strategic planning and tactical execution, to commitment and accountability.
          </p>
          <p>
            Written for CFOs, CIOs, FP&A leaders, and anyone who needs to connect strategy to execution with better information. The framework in this book has been tested across dozens of organizations worldwide.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="https://www.amazon.com/Enterprise-Performance-Management-Done-Right/dp/1118370759"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-text-primary text-surface text-sm font-medium rounded-lg hover:bg-accent transition-colors"
          >
            View on Amazon
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Topics covered -->
        <div class="mt-8">
          <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-4">What the book covers</h3>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              'The Management Operating System',
              'Gathering the Right Data',
              'Understanding Information',
              'Strategic Planning',
              'Tactical Execution',
              'Debate & Decision-Making',
              'Commitment & Accountability',
              'Forecasting & Scenarios',
            ].map(topic => (
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-text-secondary">{topic}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Book 3: SG&A Booklet -->
    <div id="sga" class="mt-10 pt-10 border-t border-border-light grid md:grid-cols-[10rem_1fr] gap-6 md:gap-10 items-start scroll-mt-24">
      <div class="w-28 md:w-auto">
        <div class="image-frame bg-surface">
          <Picture
              src={sgaBookletCover}
            alt="SG&A Expense Performance Management booklet cover"
            class="w-full"
              widths={[160, 320]}
              sizes="(min-width: 768px) 160px, 112px"
              formats={["avif", "webp"]}
              loading="lazy"
            />
        </div>
      </div>

      <div>
        <span class="inline-block text-xs font-medium text-warm uppercase tracking-wider mb-3">Booklet</span>
        <h2 class="text-2xl font-heading font-bold text-text-primary">
          Selling, General, and Administrative (SG&A) Expense Performance Management
        </h2>

        <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
          <p>
            A focused guide on managing one of the most overlooked areas of enterprise spending. SG&A expenses often represent 20–30% of revenue, yet most organizations lack the frameworks and discipline to manage them as rigorously as they manage cost of goods sold or capital expenditures.
          </p>
          <p>
            This booklet lays out a practical approach to understanding, measuring, and optimizing SG&A — turning a cost center into a source of competitive advantage.
          </p>
        </div>

        <div class="mt-8">
          <a
            href="https://www.amazon.com/dp/B016VGC9IW"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-text-primary text-surface text-sm font-medium rounded-lg hover:bg-accent transition-colors"
          >
            View on Amazon
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>

  </section>

  <!-- Speaking -->
  <section id="speaking" class="border-t border-border-light scroll-mt-16">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-accent uppercase tracking-wider mb-3">Speaking</p>
        <h2 class="text-3xl font-heading font-semibold text-text-primary">On stage and at the whiteboard</h2>
        <p class="mt-5 text-lg text-text-secondary leading-relaxed">
          I speak at conferences, lead workshops, and facilitate strategic planning sessions for organizations of all sizes. I like interactive formats — the audience should leave with something they can use Monday morning.
        </p>
      </div>

    <!-- Photo gallery -->
    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { src: connectedPlanningWhiteboardPhoto, alt: 'Live graphic recording mural of a Connected Planning talk' },
        { src: anaplanConnectedPlanningTalkPhoto, alt: 'Presenting the Connected Planning framework on stage at an Anaplan event' },
        { src: anaplanPanelPhoto, alt: 'Panel discussion on stage at an Anaplan conference' },
        { src: supposeTalkPhoto, alt: 'Speaking at a podium during a "Suppose" themed talk' },
      ].map(photo => (
        <div class="image-frame aspect-square">
          <Picture
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover"
            widths={[300, 600]}
            sizes="(min-width: 768px) 270px, 45vw"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <!-- Topics -->
    <div class="mt-14">
      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-8">Topics I speak on</h2>
      <div class="grid md:grid-cols-2 gap-6">

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Strategy</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">The Management Operating System</h3>
          <p class="mt-2 text-sm text-text-secondary">Why most organizations fail at execution — and how to build a closed-loop system that connects strategy to operations to results. Based on the framework from my book.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Sales</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">Value Selling: From Features to Outcomes</h3>
          <p class="mt-2 text-sm text-text-secondary">How to stop selling what your product does and start selling what your customer achieves. A framework for articulating business value, building ROI stories, and closing executive-level deals.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Finance</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">Wringing Value Out of Your EPM & Planning Investments</h3>
          <p class="mt-2 text-sm text-text-secondary">Cutting through the alphabet soup. What Enterprise Performance Management actually is, why it matters more than ever, and how to implement it as a process — not just a software purchase.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Resilience</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">Scenario Planning for Competitive Advantage</h3>
          <p class="mt-2 text-sm text-text-secondary">How to prepare for uncertainty without drowning in analysis paralysis. Building an organization's "instruction book" for handling major disruptions — before they arrive.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Data</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">Turning Data into Decisions</h3>
          <p class="mt-2 text-sm text-text-secondary">Most organizations have more data than they know what to do with — and worse information than they realize. How to close the gap between what you measure and what you actually need to know.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Technology</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">How to Align Your Outcomes with Your Tech Stack</h3>
          <p class="mt-2 text-sm text-text-secondary">Most organizations buy technology and then figure out what to do with it. This talk flips the script — starting with the business outcomes you need, mapping them to capabilities, and then aligning your technology investments to actually deliver. Based on the Blueprint / Value Map methodology.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Education</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">Workshop-Based Learning: Why Lectures Fail</h3>
          <p class="mt-2 text-sm text-text-secondary">Adults don't learn by sitting quietly and taking notes. How to design hands-on, peer-driven learning experiences that actually change behavior — drawn from building 45+ Spark Labs modules.</p>
        </div>

        <div class="bg-surface rounded-lg border border-border p-6">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Leadership</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary">The KPI Trap: Measuring What Matters</h3>
          <p class="mt-2 text-sm text-text-secondary">How to select KPIs that drive behavior instead of just filling dashboards. Why most organizations measure the wrong things — and a practical method for getting it right.</p>
        </div>

      </div>
    </div>

    <!-- Videos & media -->
    <div id="media" class="mt-16 scroll-mt-24">
      <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-8">Videos & media</h3>

      <!-- Featured: 3Q interview -->
      <div class="grid md:grid-cols-5 gap-6 md:gap-10 items-center max-w-5xl">
        <div class="md:col-span-3 rounded-lg overflow-hidden border border-border aspect-video">
          <YouTube id="JQ7WklU3L8s" title="3Q, with Ron Dimon of SparkLabs" />
        </div>
        <div class="md:col-span-2">
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">Start here</span>
          <h4 class="font-heading text-xl font-semibold text-text-primary">What I do, in my own words</h4>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed">
            An overview of what I do, explained while being interviewed on <a href="https://3qnm.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover underline decoration-accent/30">3QNM</a>.
          </p>
          <a href="https://music.youtube.com/watch?v=JQ7WklU3L8s" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-4 text-sm font-medium text-accent hover:text-accent-hover">
            Also on YouTube Music
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <div class="mt-8 grid md:grid-cols-2 gap-x-6 gap-y-10 max-w-4xl">
        <!-- Anaplan x Deloitte webinar -->
        <div>
          <div class="rounded-lg overflow-hidden border border-border aspect-video">
            <YouTube id="Xaqr46dlNRY" title="Anaplan Webinar | Connected planning with Deloitte" />
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium text-accent uppercase tracking-wider">Anaplan &amp; Deloitte webinar</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-light px-2.5 py-0.5 text-xs font-semibold text-accent">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" stroke-width="2" /></svg>
              24,000+ views
            </span>
          </div>
          <h4 class="mt-1 font-heading text-lg font-semibold text-text-primary leading-snug">Connected Planning with Deloitte</h4>
          <p class="mt-1 text-sm text-text-secondary leading-relaxed">A framework for enterprise collaboration, presented with Deloitte for Anaplan.</p>
        </div>

        <!-- Spaulding Ridge Elevate21 -->
        <div>
          <div class="rounded-lg overflow-hidden border border-border aspect-video">
            <YouTube id="S29mLgbwMS0" title="Elevate21: A Conversation with Ron Dimon | Spaulding Ridge" />
          </div>
          <span class="mt-4 inline-block text-xs font-medium text-accent uppercase tracking-wider">Spaulding Ridge &middot; Elevate21</span>
          <h4 class="mt-1 font-heading text-lg font-semibold text-text-primary leading-snug">A Conversation with Ron Dimon</h4>
          <p class="mt-1 text-sm text-text-secondary leading-relaxed">A webinar on my Connected Planning book and the frameworks behind it.</p>
        </div>

        <!-- FinTechLinker career interview -->
        <div>
          <div class="rounded-lg overflow-hidden border border-border aspect-video">
            <YouTube id="fI-7xsV-5sE" title="EPM Chronicles & Confessions: 52. Ron Dimon (EPM Pioneer, Thought Leader & Author) | FinTechLinker" />
          </div>
          <span class="mt-4 inline-block text-xs font-medium text-accent uppercase tracking-wider">FinTechLinker &middot; EPM Chronicles &amp; Confessions</span>
          <h4 class="mt-1 font-heading text-lg font-semibold text-text-primary leading-snug">My career journey</h4>
          <p class="mt-1 text-sm text-text-secondary leading-relaxed">An interview about how I got into EPM and where it has taken me, about 19 minutes.</p>
        </div>

        <!-- Oracle OpenWorld -->
        <div>
          <a href="/about/archive/oracle-openworld-radio-interview-epm-done-right" class="group block rounded-lg overflow-hidden border border-border aspect-video">
            <img
              src="/images/archive/oaug-interview.jpeg"
              alt="Ron Dimon being interviewed at Oracle OpenWorld about EPM Done Right"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </a>
          <span class="mt-4 inline-block text-xs font-medium text-accent uppercase tracking-wider">Oracle OpenWorld radio interview</span>
          <h4 class="mt-1 font-heading text-lg font-semibold text-text-primary leading-snug">EPM Done Right</h4>
          <a href="/about/archive/oracle-openworld-radio-interview-epm-done-right" class="mt-1 inline-block text-sm font-medium text-accent hover:text-accent-hover">Read the post &rarr;</a>
        </div>
      </div>

      <div class="mt-10 grid md:grid-cols-2 gap-8 max-w-4xl">
        <div>
          <a href="https://www.jedox.com/en/resources/webinar-beyond-budgeting-blueprint-epm/" target="_blank" rel="noopener noreferrer" class="group block rounded-lg overflow-hidden border border-border">
            <Picture
              src={jedoxBeyondBudgeting}
              alt="Jedox webinar cover: Beyond Budgeting — Building a Blueprint for Enterprise Performance Management"
              class="w-full transition-transform duration-300 group-hover:scale-[1.02]"
              widths={[440, 880]}
              sizes="(min-width: 768px) 430px, 90vw"
              formats={["avif", "webp"]}
              loading="lazy"
            />
          </a>
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mt-4 mb-1">Jedox on-demand webinar</span>
          <h4 class="font-heading text-lg font-semibold text-text-primary leading-snug">Beyond Budgeting: Building a Blueprint for Enterprise Performance Management</h4>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">A practical framework for turning FP&amp;A from a budgeting function into a strategic driver of business performance, by connecting strategy, finance, and operations.</p>
          <a href="https://www.jedox.com/en/resources/webinar-beyond-budgeting-blueprint-epm/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-3 text-sm font-medium text-accent hover:text-accent-hover">
            Watch on jedox.com
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
          </a>
        </div>
        <div>
          <a href="https://www.jedox.com/en/resources/webinar-disruption-to-direction-americas-automotive-suppliers/" target="_blank" rel="noopener noreferrer" class="group block rounded-lg overflow-hidden border border-border">
            <Picture
              src={jedoxDisruptionToDirection}
              alt="Jedox webinar cover: From Disruption to Direction — How Automotive Suppliers Are Planning at the Speed of Change"
              class="w-full transition-transform duration-300 group-hover:scale-[1.02]"
              widths={[440, 880]}
              sizes="(min-width: 768px) 430px, 90vw"
              formats={["avif", "webp"]}
              loading="lazy"
            />
          </a>
          <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mt-4 mb-1">Jedox on-demand webinar</span>
          <h4 class="font-heading text-lg font-semibold text-text-primary leading-snug">From Disruption to Direction: How Automotive Suppliers Are Planning at the Speed of Change</h4>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">How auto suppliers can unify finance, operations, and commercial planning, replacing spreadsheets and disconnected systems with faster forecasting and scenario planning.</p>
          <a href="https://www.jedox.com/en/resources/webinar-disruption-to-direction-americas-automotive-suppliers/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-3 text-sm font-medium text-accent hover:text-accent-hover">
            Watch on jedox.com
