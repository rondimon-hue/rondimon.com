---
import Page from '../layouts/Page.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { BOOKING_URL, EMAIL } from '../data/site';
import { offers } from '../data/offers';


const check = 'M5 13l4 4L19 7';
const ext = 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14';
---

<Page
  title="Work with me"
  description="How Ron Dimon helps: strategy-to-execution advisory, strategic facilitation, Spark Labs workshops, keynotes, and founder and executive mentoring."
>

  <section class="container pt-20 md:pt-28 pb-12">
    <div class="max-w-3xl animate-in">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Work with me</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        Ways we can work together
      </h1>
      <p class="mt-6 text-xl text-text-secondary leading-relaxed">
        Most of my work starts with a decision that matters: a strategy that isn’t reaching the people who have to carry it out, a plan nobody quite trusts, or a team that needs to get aligned and moving. Here’s how I help.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors">
          Book a conversation
        </a>
        <a href={`mailto:${EMAIL}`} class="inline-flex items-center px-6 py-3 border border-border text-text-primary text-sm font-medium rounded-lg hover:border-accent hover:text-accent transition-colors">
          Email me
        </a>
      </div>
    </div>

    <nav class="mt-12 flex flex-wrap gap-3" aria-label="Ways to work together">
      {offers.map((o) => (
        <a href={`#${o.id}`} class="inline-flex items-center px-4 py-2 bg-surface-alt text-sm text-text-secondary rounded-lg border border-border hover:border-accent hover:text-accent transition-colors">
          {o.title}
        </a>
      ))}
    </nav>
  </section>

  <section class="container pb-20">
    <div class="space-y-6 max-w-5xl">
      {offers.map((o, i) => (
        <article id={o.id} class="scroll-mt-24 bg-surface rounded-xl border border-border p-6 md:p-8 grid md:grid-cols-5 gap-6 md:gap-10">
          <div class="md:col-span-3">
            <p class="text-xs font-medium text-accent uppercase tracking-wider">0{i + 1}</p>
            <h2 class="mt-1 text-2xl font-heading font-semibold text-text-primary">{o.title}</h2>
            <p class="mt-2 text-sm text-text-muted"><span class="font-medium text-text-secondary">For:</span> {o.for}</p>
            <p class="mt-4 text-text-secondary leading-relaxed">{o.body}</p>
            <p class="mt-4 text-sm text-text-secondary leading-relaxed"><span class="font-medium text-text-primary">Background:</span> {o.background}</p>
            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
              {o.links.map((l) => (
                <a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="inline-flex items-center text-sm font-medium text-accent hover:text-accent-hover">
                  {l.label}
                  {l.href.startsWith('http') && (
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ext} /></svg>
                  )}
                </a>
              ))}
            </div>
          </div>
          <div class="md:col-span-2 md:border-l md:border-border-light md:pl-8">
            <h3 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-3" style="font-family:var(--font-body)">Typical work</h3>
            <ul class="space-y-2" role="list">
              {o.work.map((w) => (
                <li class="flex items-start gap-2 text-sm text-text-secondary">
                  <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} /></svg>
                  {w}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-border-light">
    <div class="container py-16 md:py-20">
      <h2 class="text-3xl md:text-4xl font-heading font-semibold text-text-primary mb-10">What people say</h2>
      <Testimonials />
    </div>
  </section>

  <CtaBand />

</Page>
