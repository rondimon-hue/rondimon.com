---
import Page from '../layouts/Page.astro';

const genres = [
  {
    id: 'architecture',
    name: 'Architecture',
    description: 'Adobe walls, ornate ironwork, geometric forms. The structures we build say everything about who we are.',
    images: [
      { src: '/images/photography/architecture/santa-fe-edge.jpg', title: 'Santa Fe Edge', w: 1600, h: 1200 },
      { src: '/images/photography/architecture/arches.jpg', title: 'Arches', w: 1600, h: 899 },
      { src: '/images/photography/architecture/thalia-hall-stairs.jpg', title: 'Thalia Hall Stairs', w: 1600, h: 1200 },
      { src: '/images/photography/architecture/snow-line.jpg', title: 'Snow Line', w: 1600, h: 1200 },
      { src: '/images/photography/architecture/wagon-wheel.jpg', title: 'Wagon Wheel', w: 1600, h: 1200 },
      { src: '/images/photography/architecture/geodesic.jpg', title: 'Geodesic', w: 1600, h: 1200 },
      { src: '/images/photography/architecture/ladder.jpg', title: 'Ladder', w: 1200, h: 1600 },
    ],
  },
  {
    id: 'landscapes',
    name: 'Landscapes',
    description: 'Roads, trees, snow, desert. The places that make you stop the car and just look.',
    images: [
      { src: '/images/photography/landscapes/backroad.jpg', title: 'Backroad', w: 1066, h: 1600 },
      { src: '/images/photography/landscapes/majesty.jpg', title: 'Majesty', w: 1600, h: 1200 },
      { src: '/images/photography/landscapes/snow-frame.jpg', title: 'Snow Frame', w: 1600, h: 1200 },
      { src: '/images/photography/landscapes/front.jpg', title: 'Front', w: 1600, h: 1200 },
      { src: '/images/photography/landscapes/blackbird.jpg', title: 'Blackbird', w: 1600, h: 1242 },
      { src: '/images/photography/landscapes/bw-tree.jpg', title: 'BW Tree', w: 1200, h: 1600 },
      { src: '/images/photography/landscapes/abiquiu.jpg', title: 'Abiquiu', w: 1600, h: 1200 },
    ],
  },
  {
    id: 'cloudscapes',
    name: 'Cloudscapes',
    description: 'New Mexico skies are their own art gallery. Sunsets that no camera fully captures — but you try anyway.',
    images: [
      { src: '/images/photography/cloudscapes/layers.jpg', title: 'Layers', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/smoke.jpg', title: 'Smoke', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/swirl.jpg', title: 'Swirl', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/flow.jpg', title: 'Flow', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/curiously.jpg', title: 'Curiously', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/red-tree.jpg', title: 'Red Tree', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/cloud-mountain.jpg', title: 'Cloud Mountain', w: 1600, h: 1200 },
      { src: '/images/photography/cloudscapes/sky-sand.jpg', title: 'Sky Sand', w: 1600, h: 957 },
    ],
  },
  {
    id: 'abstract',
    name: 'Abstract',
    description: 'Patterns, textures, and surprises hiding in plain sight. The things you notice when you slow down.',
    images: [
      { src: '/images/photography/abstract/oil-water.jpg', title: 'Oil Water', w: 1600, h: 1209 },
      { src: '/images/photography/abstract/one-m.jpg', title: 'One M', w: 1600, h: 1200 },
      { src: '/images/photography/abstract/magic-light-broom.jpg', title: 'Magic Light Broom', w: 1600, h: 1200 },
      { src: '/images/photography/abstract/green-raven.jpg', title: 'Green Raven', w: 1200, h: 1600 },
      { src: '/images/photography/abstract/double-glaze.jpg', title: 'Double Glaze', w: 1328, h: 1600 },
      { src: '/images/photography/abstract/bulb.jpg', title: 'Bulb', w: 1426, h: 1600 },
    ],
  },
  {
    id: 'liminal',
    name: 'Liminal Spaces',
    description: 'Thresholds, doorways, windows. The in-between moments where light meets shadow and inside meets outside.',
    images: [
      { src: '/images/photography/liminal/gnight.jpg', title: 'Gnight', w: 1200, h: 1600 },
      { src: '/images/photography/liminal/echo.jpg', title: 'Echo', w: 1200, h: 1600 },
      { src: '/images/photography/liminal/cold-buddha.jpg', title: 'Cold Buddha', w: 1200, h: 1600 },
      { src: '/images/photography/liminal/portal.jpg', title: 'Portal', w: 1600, h: 1200 },
      { src: '/images/photography/liminal/enter.jpg', title: 'Enter', w: 1600, h: 1200 },
      { src: '/images/photography/liminal/gates.jpg', title: 'Gates', w: 1600, h: 1200 },
      { src: '/images/photography/liminal/dark-gather.jpg', title: 'Dark Gather', w: 1600, h: 1200 },
    ],
  },
];
---

<Page title="Photography & Travel" description="Ron Dimon's photography — architecture, landscapes, cloudscapes, abstract, and liminal spaces from New Mexico and beyond.">

  <section class="container py-20 md:py-28">
    <div class="max-w-3xl animate-in">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Photography</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        Places and perspectives
      </h1>
      <p class="mt-6 text-xl text-text-secondary leading-relaxed">
        Architecture. Landscapes. Cloudscapes. Abstract. Liminal Spaces. I photograph the world the way I think about it — looking for structure, light, and the quiet moments between things.
      </p>
    </div>

    <!-- Genre jump nav -->
    <div class="mt-12 flex flex-wrap gap-2">
      {genres.map(genre => (
        <a
          href={`#${genre.id}`}
          class="px-4 py-2 text-sm font-medium text-text-secondary bg-surface rounded-full border border-border hover:border-accent hover:text-accent transition-colors"
        >
          {genre.name}
        </a>
      ))}
    </div>

    <!-- Genre sections -->
    {genres.map((genre, i) => (
      <div
        id={genre.id}
        class:list={['scroll-mt-24', i === 0 ? 'mt-16' : 'mt-24 pt-12 border-t border-border-light']}
      >
        <h2 class="text-2xl md:text-3xl font-heading font-semibold text-text-primary">
          {genre.name}
        </h2>
        <p class="mt-3 text-text-secondary max-w-2xl">
          {genre.description}
        </p>

        <div class="mt-8 columns-2 md:columns-3 gap-4 space-y-4">
          {genre.images.map(img => (
            <div class="image-frame break-inside-avoid">
              <img
                src={img.src}
                alt={img.title}
                width={img.w}
                height={img.h}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

</Page>
