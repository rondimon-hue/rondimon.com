---
import Page from '../../layouts/Page.astro';

// Archive of blog posts from the original rondimon.com WordPress site
const posts = [
  { date: 'January 2019', title: 'Getting Better at Getting Ready: Scenario Planning for Competitive Advantage', slug: 'getting-better-at-getting-ready-scenario-planning-for-compet' },
  { date: 'February 2016', title: 'Getting Started in Business Analytics & Data Science', slug: 'getting-started-in-business-analytics-data-science' },
  { date: 'January 2016', title: 'Now Available: Intro to EPM for Finance Professionals Course', slug: 'now-available-intro-to-epm-for-finance-professionals-course' },
  { date: 'December 2015', title: 'The Enterprise Performance Management Wheel of Fortune', slug: 'the-enterprise-performance-management-wheel-of-fortune' },
  { date: 'July 2015', title: 'Enterprise Planning & Forecasting Flow — with Oracle Tools', slug: 'enterprise-planning-forecasting-flow-with-oracle-tools' },
  { date: 'July 2015', title: 'Enterprise Planning & Forecasting Flow', slug: 'enterprise-planning-forecasting-flow' },
  { date: 'January 2015', title: 'Klondike15 — A New Hyperion User Conference', slug: 'klondike15-a-new-hyperion-user-conference' },
  { date: 'September 2014', title: '8 Report Types for Better Information Delivery', slug: '8-report-types-for-better-information-delivery' },
  { date: 'September 2014', title: '8 Ingredients to Turn Data into Useful Information', slug: '8-ingredients-to-turn-data-into-useful-information' },
  { date: 'August 2014', title: 'A Management Operating System', slug: 'a-management-operating-system' },
  { date: 'August 2014', title: '3 Benefits of Using EPM in Your Organization', slug: '3-benefits-of-using-epm-in-your-organization' },
  { date: 'August 2014', title: 'Top 7 Signs Your Organization Needs Enterprise Performance Management', slug: 'top-7-reasons-your-organization-needs-enterprise-performance-management' },
  { date: 'February 2014', title: 'Modern Management System', slug: 'modern-management-system' },
  { date: 'January 2014', title: 'Why Are My Numbers Different Than Yours?', slug: 'why-are-my-numbers-different-than-yours' },
  { date: 'January 2014', title: 'EPM and BI Resources on Twitter', slug: 'epm-and-bi-resources-on-twitter' },
  { date: 'October 2013', title: 'Oracle OpenWorld Radio Interview: EPM Done Right', slug: 'oracle-openworld-radio-interview-epm-done-right' },
  { date: 'September 2013', title: 'Choice', slug: 'choice' },
  { date: 'May 2013', title: 'SG&A Performance Management', slug: 'sga-performance-management' },
  { date: 'May 2013', title: 'Data Consumption Is Undergoing a Major Shift', slug: 'data-consumption-is-undergoing-a-major-shift' },
  { date: 'May 2013', title: 'The Total Cost of Ownership (TCO) of Enterprise Performance Management', slug: 'the-total-cost-of-ownership-tco-of-enterprise-performance-management-epm' },
  { date: 'May 2013', title: '8 Principles of Enterprise Performance Management', slug: '8-principles-of-enterprise-performance-management' },
  { date: 'May 2013', title: 'Enterprise Planning', slug: 'enterprise-planning' },
  { date: 'April 2013', title: 'CFO and CIO Join Forces to Serve "The Business"', slug: 'cfo-and-cio-join-forces-to-serve-the-business' },
  { date: 'April 2013', title: 'Closing the Strategy-Execution Gap', slug: 'closing-the-strategy-execution-gap' },
  { date: 'April 2013', title: 'Information Qualities', slug: 'information-qualities' },
  { date: 'April 2013', title: 'Answering Business Questions', slug: 'answering-business-questions' },
  { date: 'April 2013', title: '"DRiVE" Driven', slug: 'drive-driven' },
  { date: 'April 2013', title: 'Enrolling Others in the Possibility of EPM', slug: 'enrolling-others-in-the-possibility-of-epm' },
  { date: 'April 2013', title: 'Book Press Release', slug: 'book-press-release' },
  { date: 'March 2013', title: 'What Really Constrains Your Performance?', slug: 'what-really-constrains-your-performance' },
  { date: 'March 2013', title: 'Hot Off the Press', slug: 'hot-off-the-press' },
  { date: 'March 2013', title: 'The Management Operating System', slug: 'the-management-operating-system' },
  { date: 'March 2013', title: 'Enterprise Performance Management "Done Right"', slug: 'enterprise-performance-management-done-right' },
];
---

<Page title="Archive" description="Blog posts and articles from the original rondimon.com, published 2013–2019.">

  <section class="container py-20 md:py-28">
    <div class="max-w-3xl animate-in">
      <a href="/about" class="inline-flex items-center text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        About
      </a>
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Archive</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        From the blog, 2013–2019
      </h1>
      <p class="mt-6 text-lg text-text-secondary leading-relaxed">
        These posts are from the original rondimon.com WordPress site, covering enterprise performance management, planning, analytics, and strategy. Preserved here for reference.
      </p>
    </div>

    <div class="mt-16 max-w-3xl">
      <div class="space-y-1">
        {posts.map(post => (
          <a href={`/about/archive/${post.slug}`} class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 border-b border-border-light hover:bg-surface-alt/50 -mx-3 px-3 rounded transition-colors">
            <span class="text-sm text-text-muted sm:w-36 shrink-0">{post.date}</span>
            <h3 class="text-text-primary font-medium group-hover:text-accent transition-colors">
              {post.title}
            </h3>
          </a>
        ))}
      </div>

      <div class="mt-12 bg-surface-alt rounded-xl border border-border p-6">
        <p class="text-sm text-text-secondary">
          These posts were originally published on WordPress. Full content including images has been preserved.
        </p>
      </div>
    </div>
  </section>

</Page>
