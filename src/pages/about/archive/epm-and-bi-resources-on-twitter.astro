---
import Page from '../../../layouts/Page.astro';

const title = `EPM and BI resources on twitter`;
const dateStr = "January 6, 2014";
const content = `<p>Happy 2014!</p>

<p>I wanted to take a minute and share some good EPM and BI resources on twitter that I follow.  Enjoy!</p>

<p>@marcusborba @timoelliott @Ken_Hansen @wjdataguy @ProjectXLtd @BIWisdom @jasprice @jhurwitz</p>

<p>@howarddresner @MadaboutBI #BIWisdom @nenshad @lewandog @shawnrog @FrankBuytendijk</p>

<p>And there are lots more.  Check out <a href="https://twitter.com/rondimon">@rondimon</a> and see who I follow.  Please feel free to suggest other folks I should follow.</p>

<p>Cheers!</p>`;
---

<Page title={title} description={`Archived blog post from rondimon.com — ${dateStr}`}>

  <section class="container py-20 md:py-28">
    <div class="max-w-3xl animate-in">
      <a href="/about/archive" class="inline-flex items-center text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Archive
      </a>
      <p class="text-sm text-text-muted mb-4">{dateStr}</p>
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-text-primary">
        {title}
      </h1>
    </div>

    <div class="mt-12 max-w-3xl prose-archive" set:html={content} />
  </section>

</Page>
