---
import Page from '../layouts/Page.astro';
---

<Page title="Contact" description="Get in touch with Ron Dimon — LinkedIn, email, UNM, Spark Labs.">

  <section class="container py-20 md:py-28">
    <div class="max-w-3xl animate-in">
      <p class="text-sm font-medium text-accent uppercase tracking-wider mb-4">Contact</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary">
        Let's connect
      </h1>
      <p class="mt-6 text-xl text-text-secondary leading-relaxed">
        Whether you're interested in workshops, speaking, advisory work, or just want to say hello — here's how to find me.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-8 max-w-4xl">

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/rondimon/"
        target="_blank"
        rel="noopener noreferrer"
        class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <h3 class="font-heading text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">LinkedIn</h3>
        </div>
        <p class="text-sm text-text-secondary">Connect professionally, see what I'm sharing, or send a message.</p>
        <span class="inline-flex items-center mt-3 text-sm font-medium text-accent">
          linkedin.com/in/rondimon
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </span>
      </a>

      <!-- Spark Labs -->
      <a
        href="https://sparklabsnm.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <h3 class="font-heading text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">Spark Labs NM</h3>
        </div>
        <p class="text-sm text-text-secondary">Hands-on workshops for founders, consultants, and business leaders in New Mexico and beyond.</p>
        <span class="inline-flex items-center mt-3 text-sm font-medium text-accent">
          sparklabsnm.com
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </span>
      </a>

      <!-- UNM -->
      <a
        href="https://unm.edu"
        target="_blank"
        rel="noopener noreferrer"
        class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
          </svg>
          <h3 class="font-heading text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">UNM</h3>
        </div>
        <p class="text-sm text-text-secondary">Center for Responsible Entrepreneurship at the University of New Mexico.</p>
        <span class="inline-flex items-center mt-3 text-sm font-medium text-accent">
          unm.edu
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:ron@rondimon.com"
        class="group block bg-surface rounded-lg border border-border p-6 hover:border-accent/30 hover:shadow-md transition-all"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <h3 class="font-heading text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">Email</h3>
        </div>
        <p class="text-sm text-text-secondary">For speaking inquiries, advisory work, or anything else.</p>
        <span class="inline-flex items-center mt-3 text-sm font-medium text-accent">
          ron@rondimon.com
        </span>
      </a>

    </div>
  </section>

</Page>
