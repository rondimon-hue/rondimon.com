---
interface Props {
  title: string;
  description: string;
  href?: string;
  tag?: string;
  image?: string;
}

const { title, description, href, tag, image } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group block bg-surface rounded-lg border border-border p-6 transition-all duration-200',
    href && 'hover:border-accent/30 hover:shadow-md cursor-pointer'
  ]}
  {...href && { target: href.startsWith('http') ? '_blank' : undefined, rel: href.startsWith('http') ? 'noopener noreferrer' : undefined }}
>
  {image && (
    <div class="image-frame mb-4 aspect-video">
      <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
    </div>
  )}
  {tag && (
    <span class="inline-block text-xs font-medium text-accent uppercase tracking-wider mb-2">
      {tag}
    </span>
  )}
  <h3 class="text-lg font-heading font-semibold text-text-primary group-hover:text-accent transition-colors">
    {title}
  </h3>
  <p class="mt-2 text-sm text-text-secondary leading-relaxed">
    {description}
  </p>
  {href && (
    <span class="inline-flex items-center mt-4 text-sm font-medium text-accent opacity-0 group-hover:opacity-100 transition-opacity">
      Learn more
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  )}
</Tag>
