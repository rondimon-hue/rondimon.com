---
import { BOOKING_URL } from '../data/site';

const currentPath = Astro.url.pathname;

// "Ron Dimon" (top left) links home; Photography & Travel lives in the footer.
const navLinks = [
  { href: '/work-with-me', label: 'Work with me' },
  { href: '/work', label: 'Work' },
  { href: '/books', label: 'Books & Speaking' },
  { href: '/about', label: 'Aboot' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}

const bookClasses = 'inline-flex items-center justify-center px-4 py-2 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors';
---

<header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-md border-b border-border-light">
  <nav class="container flex items-center justify-between h-16">
    <a href="/" class="font-heading text-xl font-semibold tracking-tight text-text-primary hover:text-accent transition-colors">
      Ron Dimon
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-1 ml-auto">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-colors',
              isActive(link.href)
                ? 'text-accent bg-accent-light'
                : 'text-text-secondary hover:text-text-primary hover:bg-surface-alt'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:block ml-2">
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class={bookClasses}>
        Book a conversation
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden p-2 text-text-secondary hover:text-text-primary rounded-md"
      aria-label="Menu" aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border-light bg-surface">
    <ul class="container py-3 space-y-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'block px-3 py-2 text-sm font-medium rounded-md transition-colors',
              isActive(link.href)
                ? 'text-accent bg-accent-light'
                : 'text-text-secondary hover:text-text-primary hover:bg-surface-alt'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2 pb-1">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class:list={['w-full', bookClasses]}>Book a conversation</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');
  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    icon?.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
  }
  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
