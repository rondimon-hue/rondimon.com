---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['mb-12', align === 'center' ? 'text-center' : '']}>
  <h2 class="text-3xl md:text-4xl font-heading font-semibold text-text-primary">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-text-secondary max-w-2xl" class:list={[align === 'center' ? 'mx-auto' : '']}>
      {subtitle}
    </p>
  )}
</div>
