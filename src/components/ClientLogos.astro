---
// Logo row of organizations Ron has worked with (files in public/images/logos).
const logos = [
  { name: 'Oracle', file: 'oracle.svg' },
  { name: 'Microsoft', file: 'microsoft.png' },
  { name: 'Google', file: 'google.png' },
  { name: 'Salesforce', file: 'salesforce.png' },
  { name: 'Anaplan', file: 'anaplan.png' },
  { name: 'Deloitte', file: 'deloitte.png' },
  { name: 'SAS', file: 'sas.png' },
  { name: 'Cisco', file: 'cisco.svg' },
  { name: 'Infosys', file: 'infosys.svg' },
];
---

<ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8" role="list" aria-label="Organizations I've worked with">
  {logos.map((logo) => (
    <li>
      <img
        src={`/images/logos/${logo.file}`}
        alt={logo.name}
        class="h-8 md:h-10 w-auto max-w-[7rem] md:max-w-[8.5rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all"
        loading="lazy"
      />
    </li>
  ))}
</ul>
