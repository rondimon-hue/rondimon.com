---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Ron Dimon — Strategist, author, educator, and builder.',
  image = '/images/og-image.jpg',
} = Astro.props;

const fullTitle = title === 'Home'
  ? 'Ron Dimon — Strategist, Author, Educator, Builder'
  : `${title} | Ron Dimon`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ron Dimon',
  url: 'https://rondimon.com',
  image: 'https://rondimon.com/images/ron-dimon-headshot.jpg',
  jobTitle: 'Strategist, Author, Educator',
  description: 'Strategist, author, educator, and builder. Helping organizations and people make better decisions with better information.',
  sameAs: ['https://www.linkedin.com/in/rondimon/'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#FAFAF9" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ron Dimon" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ron Dimon — Strategist, Author, Educator, Builder" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen antialiased">
  <slot />
</body>
</html>
