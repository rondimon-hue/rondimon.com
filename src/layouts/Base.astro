---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Extra schema.org objects for this page (e.g. Book), emitted as JSON-LD */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'Ron Dimon — Strategist, author, educator, and builder.',
  image = '/images/og-image.jpg',
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = title === 'Home'
  ? 'Ron Dimon — Strategy-to-Execution Advisor, Facilitator & Author'
  : `${title} | Ron Dimon`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const site = Astro.site!.origin;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}/#ron`,
  name: 'Ron Dimon',
  url: `${site}/`,
  image: `${site}/images/ron-dimon-photo.jpg`,
  jobTitle: 'Executive Advisor, Facilitator, and Author',
  description: 'Strategist, author, educator, and builder. Helping organizations and people make better decisions with better information.',
  knowsAbout: ['Enterprise Performance Management', 'Connected Planning', 'Strategy to execution', 'Finance transformation', 'Strategic facilitation', 'Scenario planning', 'Entrepreneurship'],
  sameAs: ['https://www.linkedin.com/in/rondimon/', 'https://santafefacilitator.com/'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <!-- Vercel Web Analytics: enable under Project -> Analytics in the Vercel dashboard -->
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#FAFAF9" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ron Dimon" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ron Dimon — Strategist, Author, Educator, Builder" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })}></script>)}

  <link rel="preload" href="/fonts/inter-latin-v20.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/playfair-display-latin-v40.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="min-h-screen antialiased">
  <slot />
</body>
</html>
