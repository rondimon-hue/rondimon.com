---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---
<Base title={title} description={description} image={image} noindex={noindex}>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:px-4 focus:py-2 focus:bg-surface focus:text-accent focus:rounded-lg focus:shadow-md">
    Skip to content
  </a>
  <Header />
  <main id="main" class="min-h-screen">
    <slot />
  </main>
  <Footer />
</Base>
